---
import BaseLayout from "../layouts/BaseLayout.astro";
import { activeAccount, scheduleRows } from "../data/contentSchedule";
---

<BaseLayout
  title="Content Schedule | Ary Pratama"
  description="Simple content calendar for Severus Sheet."
  noindex
>
  <section class="rounded-3xl border border-zinc-300 dark:border-zinc-700 bg-white/70 dark:bg-dark-800/60 p-5 sm:p-8 shadow-sm">
    <header class="text-center space-y-5">
      <div>
        <p class="text-xs uppercase tracking-[0.28em] text-blue-600 dark:text-blue-400 font-bold">
          Content Schedule
        </p>
        <h1 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight leading-tight">
          Severus Sheet Comeback
        </h1>
      </div>

      <div class="flex flex-wrap justify-center gap-2 text-xs sm:text-sm font-bold">
        <span class="rounded-full border border-zinc-300 dark:border-zinc-600 px-3 py-1.5 text-zinc-700 dark:text-zinc-200">
          {activeAccount.handle}
        </span>
        <span class="rounded-full border border-zinc-300 dark:border-zinc-600 px-3 py-1.5 text-zinc-700 dark:text-zinc-200">
          {activeAccount.platform}
        </span>
        <span class="rounded-full border border-zinc-300 dark:border-zinc-600 px-3 py-1.5 text-zinc-700 dark:text-zinc-200">
          {activeAccount.cadence}
        </span>
      </div>
    </header>

    <div class="my-8 border-t border-zinc-300 dark:border-zinc-700"></div>

    <section>
      <div class="flex items-center justify-between gap-4 mb-5">
        <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400">
          Archive
        </h2>
        <span class="text-xs text-zinc-500 dark:text-zinc-400">30 days / 60 posts</span>
      </div>

      <ol class="space-y-1 font-mono text-sm sm:text-base">
        {scheduleRows.map((post, index) => (
          <li class="group">
            <a
              href={`/content-schedule/${post.accountSlug}/${post.slug}`}
              class="block rounded-xl px-2 py-2 hover:bg-zinc-100 dark:hover:bg-zinc-900/60 transition-colors"
            >
              <div class="grid grid-cols-[2.2rem_minmax(0,1fr)_auto] items-baseline gap-2">
                <span class="text-zinc-400 dark:text-zinc-500 tabular-nums">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="min-w-0 flex items-baseline gap-2">
                  <span class="truncate text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400">
                    {post.hook}
                  </span>
                  <span class="hidden sm:block flex-1 border-b border-dotted border-zinc-300 dark:border-zinc-600 translate-y-[-0.25rem]"></span>
                </span>
                <span class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 tabular-nums whitespace-nowrap">
                  {post.date}
                </span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <div class="my-8 border-t border-zinc-300 dark:border-zinc-700"></div>

    <footer class="text-center space-y-3">
      <nav class="flex flex-wrap justify-center gap-x-3 gap-y-2 text-sm font-bold text-zinc-600 dark:text-zinc-300">
        <span>Severus Sheet</span>
        <span class="text-zinc-400">|</span>
        <span>Slideshow First</span>
        <span class="text-zinc-400">|</span>
        <span>Excel Test Kerja</span>
      </nav>
      <p class="text-xs text-zinc-500 dark:text-zinc-400">
        Simple calendar page for Ary Pratama content operations.
      </p>
    </footer>
  </section>
</BaseLayout>
