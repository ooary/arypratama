---
const title = "HairCard Female Salon Sample Report";
const description = "HTML page version of a HairCard female salon-style sample report, based on the premium PDF report template.";
const image = "/references/haircard/female-sample-input.jpg";
---
<!doctype html>
<html lang="id"><head><meta charset="utf-8"/><title>{title}</title>
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
<style>
@page{size:A4;margin:0}*{box-sizing:border-box}html{background:#ddd1c0}body{margin:0;background:#ddd1c0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:#20150f}.page{width:210mm;max-width:100vw;height:297mm;margin:0 auto;background:#f4eee4;position:relative;overflow:hidden;page-break-after:always;padding:16mm 17mm}.cover{padding:0;display:grid;grid-template-columns:51% 49%;background:#201006}.cover .cover-photo{height:297mm;overflow:hidden}.cover img{width:100%;height:100%;object-fit:cover;object-position:center top}.cover-side{background:#211006;color:#f7e9d3;padding:58mm 18mm 16mm 18mm;position:relative}.kicker{font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:#c38523;font-weight:800;margin-bottom:5mm}.brand-page{position:absolute;top:14mm;right:16mm;width:6mm;height:6mm;background:#1d100b;color:#f4c263;border-radius:1mm;font-size:7px;display:grid;place-items:center;font-weight:900}.page.dark .brand-page,.cover .brand-page{background:#c27a16;color:#1d100b}.footer{position:absolute;left:17mm;right:17mm;bottom:10mm;display:flex;justify-content:space-between;color:#c58d3a;font-size:6px;letter-spacing:.05em}.cover .footer{color:#e5c488}.overline{font-size:7px;letter-spacing:.2em;color:#bd7b25;text-transform:uppercase;font-weight:800}.title{font-family:Georgia,serif;font-size:27px;line-height:.95;margin:0;color:#1e130d}.cover h1{font-family:Georgia,serif;font-size:34px;line-height:.95;margin:4mm 0;color:#f9ead5}.subtitle{font-size:9.5px;line-height:1.5;color:#715f50}.cover .subtitle{color:#d7bfa1}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:6mm}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:4mm}.card{background:#fffaf2;border-radius:3mm;padding:4mm;box-shadow:0 0 0 1px rgba(75,45,24,.06);border:1px solid rgba(60,35,20,.06)}.card.dark{background:#241108;color:#fff1d9}.card.yellow{background:#fae6ae}.card.green{background:#dff1df}.card.pink{background:#f2d0d0}.card h3{font-family:Georgia,serif;font-size:14px;line-height:1.05;margin:0 0 2mm;color:#1d100b}.card.dark h3{color:#fff1d9}.card p,.card li{font-size:8.3px;line-height:1.45;color:#4d4035;margin:0}.card.dark p,.card.dark li{color:#e5cdb2}ul{margin:1.5mm 0 0;padding-left:3.5mm}.photo{border-radius:3mm;overflow:hidden;background:#ddd0bc}.photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top}.metric-row{display:flex;gap:3mm;margin-top:8mm}.metric{background:#3a1c0c;color:#eeb542;border-radius:2mm;padding:3mm;width:19mm}.metric b{display:block;color:#eeb542;font-size:15px}.metric span{font-size:6.5px;color:#cdb493}.cover .metric{background:#2e180d}.note{background:#f7df9a;border-radius:2mm;padding:3mm;font-size:8px;line-height:1.4;color:#4c321b}.section{margin-top:12mm}.split-main{display:grid;grid-template-columns:45mm 1fr;gap:7mm;align-items:start}.big-title{font-family:Georgia,serif;font-size:30px;line-height:.92;margin:3mm 0 5mm;color:#1d100b}.hero-title{font-family:Georgia,serif;font-size:33px;line-height:.9;margin:4mm 0 5mm}.small-label{font-size:6.5px;text-transform:uppercase;letter-spacing:.18em;color:#c38122;font-weight:900;margin-bottom:1.5mm}.quote{font-family:Georgia,serif;font-size:16px;line-height:1.25}.pill{display:inline-block;background:#f7dfa1;border-radius:2mm;padding:2mm 3mm;font-size:8px;font-weight:800;color:#5d3b15;margin:1mm}.dark.page{background:#211006;color:#fff1d9}.dark.page .title,.dark.page .big-title,.dark.page .hero-title{color:#fff1d9}.dark.page .subtitle{color:#cdb69c}.dark-block{background:#2a1409;border-radius:3mm;padding:5mm}.routine{display:grid;grid-template-columns:1fr 1fr;gap:4mm}.step{display:grid;grid-template-columns:10mm 1fr;gap:3mm;align-items:start}.num{font-family:Georgia,serif;color:#c38122;font-size:18px;font-weight:900}.timeline{margin-top:8mm}.line{height:2px;background:#c88121;position:relative;margin:13mm 8mm 9mm}.dot{position:absolute;top:-3.5mm;width:8mm;height:8mm;border:2px solid #c88121;border-radius:50%;background:#f4eee4}.dot:nth-child(1){left:0}.dot:nth-child(2){left:24%}.dot:nth-child(3){left:50%}.dot:nth-child(4){left:74%}.dot:nth-child(5){right:0}.search-card{display:grid;grid-template-columns:55mm 1fr;gap:5mm;align-items:start}.tiny{font-size:7px!important}.avoid-row{display:grid;grid-template-columns:repeat(3,1fr);gap:4mm}.avoid-img{height:62mm;border-radius:3mm;background:#e6d7c4;overflow:hidden}.avoid-img img{width:100%;height:100%;object-fit:cover}.thumb-grid{display:grid;grid-template-columns:1fr 1fr;gap:3mm}.thumb-grid .photo{height:36mm}.band{height:9mm;border-radius:2mm;padding:2.5mm 4mm;font-size:8px;font-weight:800;margin-top:4mm}.center{display:flex;align-items:center;justify-content:center}.refbox{height:48mm;border-radius:3mm;background:#e9d8c3;padding:4mm;display:flex;align-items:end;font-weight:900;color:#331b0d;font-size:10px}.frame{border:1px solid #eadfce;border-radius:2mm;padding:2mm}.mt4{margin-top:4mm}.mt6{margin-top:6mm}.mt8{margin-top:8mm}
@media screen and (max-width: 900px){.page{width:210mm;max-width:none;margin:0;transform:scale(calc(100vw / 210mm));transform-origin:top left;margin-bottom:calc((297mm * (100vw / 210mm)) - 297mm + 16px)}body{overflow-x:hidden}.cover h1{font-size:26px}.title{font-size:23px}.big-title{font-size:24px}.hero-title{font-size:26px}}
</style></head><body>
<div class="webbar"><a href="/report/haircard">← HairCard reference</a><span>HTML sample report · Female / Salon</span></div>
<style>.webbar{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;gap:12px;padding:10px 16px;background:#211006;color:#f7e9d3;font:700 12px Inter,system-ui}.webbar a{color:#f4c263;text-decoration:none}</style>

<section class="page cover"><div class="cover-photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="cover-side"><div class="brand-page">HC</div><div class="kicker">Your personal haircut direction</div><h1>Her<br/>HairCard</h1><p class="subtitle">Personalized salon direction based on uploaded photo, face proportion, hair behavior, and style preference.</p><div class="metric-row"><div class="metric"><b>92</b><span>Fit score</span></div><div class="metric"><b>3–4W</b><span>Best refresh</span></div><div class="metric"><b>7m</b><span>Daily style</span></div></div><div class="card dark mt8"><div class="small-label">Output</div><p><b>Soft face-framing long layers.</b><br/>Natural, feminine, low-risk upgrade with salon-ready instruction.</p></div><div class="footer"><span>HairCard Report</span><span>Female / Salon</span></div></div></section>

<section class="page"><div class="brand-page">02</div><div class="overline">Baseline Input</div><h2 class="big-title">Baseline Input</h2><div class="split-main"><div class="photo" style="height:95mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div><h3 class="title" style="font-size:16px">Uploaded input photo only.</h3><p class="subtitle mt4">Recommendations use this source photo. Front-view analysis is enough for MVP direction; side/back details are estimated conservatively.</p><div class="note mt6"><b>Visible read</b><br/>Medium-long black hair, natural soft wave, medium-thick density, slightly heavy ends.</div><div class="card dark mt6"><h3>Why this matters</h3><p>The report should not invent a new baseline image. This page is for trust: the user sees exactly what the recommendation is based on.</p></div></div></div><div class="footer"><span>Generated sample report · source photo used only as user input</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">03</div><div class="overline">Executive Summary</div><h2 class="hero-title">Soft Face-Framing<br/>Long Layers</h2><div class="grid2"><div><p class="subtitle">Clean, natural, camera-friendly salon upgrade. Best route is not a dramatic chop; it is shape correction with softer movement around the face.</p><div class="metric-row"><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">92</b><span style="color:#604219">Fit score</span></div><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">Low</b><span style="color:#604219">Risk</span></div><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">Med</b><span style="color:#604219">Change</span></div></div><div class="note mt6">Best upgrade: face-framing layer around chin, soft U-shape ends, long layers, optional long curtain bangs only.</div></div><div class="photo" style="height:85mm"><img src="/references/haircard/female-sample-input.jpg"/></div></div><div class="footer"><span>Generated sample report · summary direction</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">04</div><div class="overline">Diagnostic Layer</div><h2 class="big-title">Face Shape &<br/>Balance Map</h2><div class="grid2"><div class="photo" style="height:86mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="thumb-grid"><div class="card"><div class="small-label">Face read</div><p>Soft oval-round. Balanced but with cheek softness.</p></div><div class="card"><div class="small-label">Best strategy</div><p>Frame from chin down. Avoid cheek-level bulk.</p></div><div class="card"><div class="small-label">Risk</div><p>Heavy blunt ends can close the face.</p></div><div class="card dark"><div class="small-label">Key</div><p>Keep movement vertical and soft.</p></div></div></div><div class="note mt8">Target: open the face gently, keep length, and make the hairline/front section look intentional without full bangs.</div><div class="footer"><span>Generated sample report · face proportion estimate from front photo</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">05</div><div class="overline">Texture Read</div><h2 class="big-title">Hair Type &<br/>Growth Behavior</h2><div class="card" style="height:60mm;display:grid;grid-template-columns:1fr 2fr;gap:5mm;align-items:center"><div class="photo" style="height:48mm"><img src="/references/haircard/female-sample-input.jpg"/></div><p class="quote">“The hair already has enough density. The upgrade is controlled lightness, not aggressive thinning.”</p></div><div class="grid2 mt8"><div class="card"><div class="small-label">Density</div><h3>Medium-thick</h3></div><div class="card"><div class="small-label">Texture</div><h3>Straight / soft wave</h3></div><div class="card"><div class="small-label">Volume</div><h3>Natural-flat top</h3></div><div class="card"><div class="small-label">Finish</div><h3>Soft C-curl</h3></div></div><div class="footer"><span>Generated sample report · hair behavior estimate</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">06</div><div class="overline">Best Fit</div><h2 class="big-title">Primary Haircut<br/>Recommendation</h2><div class="grid2"><div class="thumb-grid"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo" style="grid-column:1/3;height:43mm"><img src="/references/haircard/female-sample-input.jpg"/></div></div><div><div class="card dark"><h3>Haircut decision</h3><p>Soft face-framing long layers. Keep length below shoulder. Start face-frame around chin / slightly below cheekbone.</p></div><div class="card mt4"><div class="small-label">Layer</div><p>Long, soft, blended. No choppy shelf.</p></div><div class="card mt4"><div class="small-label">Ends</div><p>Light U-shape, not blunt-heavy.</p></div><div class="card mt4"><div class="small-label">Finish</div><p>Natural blowout, soft C-curl, light oil.</p></div></div></div><div class="footer"><span>Generated sample report · primary recommendation</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">07</div><div class="overline">Safer Precision</div><h2 class="big-title">Side Profile &<br/>Layer Guide</h2><div class="grid2"><div><h3 class="title" style="font-size:24px">Keep the front layer low.</h3><p class="subtitle mt4">Because no side photo is provided, the safest execution is conservative: long front layers, gradual blend, no cheek-level puff.</p><ul class="mt6"><li>Start around chin, not cheek.</li><li>Blend gradually to mid-length.</li><li>Keep back full but lighter at the ends.</li><li>No aggressive thinning.</li></ul></div><div class="photo" style="height:110mm"><img src="/references/haircard/female-sample-input.jpg"/></div></div><div class="footer"><span>Generated sample report · side/back guidance estimated</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">08</div><div class="overline">Complete Look</div><h2 class="big-title">Outfit &<br/>Activity Fit</h2><div class="grid3"><div class="card"><div class="photo" style="height:55mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="small-label mt4">Daily</div><p>Natural, clean, easy to manage.</p></div><div class="card"><div class="photo" style="height:55mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="small-label mt4">Work / Study</div><p>Soft mature without looking stiff.</p></div><div class="card"><div class="photo" style="height:55mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="small-label mt4">Social</div><p>Face frame improves front camera shape.</p></div></div><div class="band pink">Key variable: keep the look soft and salon-polished, not over-layered.</div><div class="footer"><span>Generated sample report · lifestyle fit</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">09</div><div class="overline">Worst Pitfall</div><h2 class="big-title">Styles to Avoid</h2><div class="avoid-row"><div class="card"><div class="avoid-img"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="small-label mt4">Above-chin bob</div><p>Makes soft-round proportion look shorter.</p></div><div class="card"><div class="avoid-img"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="small-label mt4">Full thick bangs</div><p>Compresses the face and hides openness.</p></div><div class="card"><div class="avoid-img"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="small-label mt4">Blunt one-length</div><p>Too heavy for medium-thick dark hair.</p></div></div><div class="band green">Better path: soft face-framing + low-maintenance long layers.</div><div class="footer"><span>Generated sample report · avoid list</span><span>HAIRCARD</span></div></section>

<section class="page dark"><div class="brand-page">10</div><div class="overline">Screenshot-Ready</div><h2 class="hero-title">I want soft face-framing<br/>long layers.</h2><p class="subtitle">Keep the length, soften the ends, and frame the face from chin level down.</p><div class="grid2 mt8"><div class="dark-block"><div class="small-label">Do</div><ul><li>Keep below shoulder length.</li><li>Face frame starts around chin.</li><li>Soft U-shape ends.</li><li>Natural blowout / C-curl.</li></ul></div><div class="dark-block"><div class="small-label">Do not</div><ul><li>No full thick bangs.</li><li>No cheek-level heavy layer.</li><li>No blunt heavy ends.</li><li>No aggressive thinning.</li></ul></div></div><div class="card yellow mt8"><h3>92 &nbsp; Fit Score</h3><p>The cut is calculated specifically for her face shape and hair behavior.</p></div><div class="footer"><span>Screenshot this page for salon</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">11</div><div class="overline">Angle Guide</div><h2 class="big-title">How to Photo<br/>This Haircut</h2><p class="subtitle">Use these angles after the salon to check whether the shape actually works.</p><div class="grid2 mt6"><div class="card"><div class="photo" style="height:48mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="small-label mt4">Front, natural light</div><p>Check whether face frame opens the face.</p></div><div class="card"><div class="photo" style="height:48mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="small-label mt4">Half side</div><p>Check if layer blends smoothly.</p></div><div class="card"><div class="photo" style="height:48mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="small-label mt4">Ends</div><p>Check U-shape, no blunt heavy block.</p></div><div class="card"><div class="photo" style="height:48mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="small-label mt4">Styled</div><p>Check C-curl and face-frame direction.</p></div></div><div class="footer"><span>Generated sample report · photo guide</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">12</div><div class="overline">Daily Installation</div><h2 class="big-title">Styling Routine<br/>& Products</h2><div class="routine mt6"><div class="card step"><div class="num">01</div><div><h3>Towel dry</h3><p>Leave slightly damp. Do not oil the roots.</p></div></div><div class="card step"><div class="num">02</div><div><h3>Blow dry</h3><p>Direct front layer away from face.</p></div></div><div class="card step"><div class="num">03</div><div><h3>C-curl ends</h3><p>Use round brush or large iron.</p></div></div><div class="card step"><div class="num">04</div><div><h3>Light finish</h3><p>Hair oil only mid-length to ends.</p></div></div></div><div class="card dark mt8"><h3>7m &nbsp; Total daily routine</h3><p>Low effort, consistent result every morning.</p></div><div class="note mt6">Use: heat protectant, lightweight oil, smoothing cream if frizzy. Avoid wet-look gel and heavy root oil.</div><div class="footer"><span>Generated sample report · routine</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">13</div><div class="overline">Shape Over Time</div><h2 class="big-title">Maintenance<br/>Timeline</h2><div class="timeline"><div class="line"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></div></div><div class="grid2 mt8"><div class="card"><div class="small-label">Week 1</div><p>Learn the blow direction. Take one front photo after styling.</p></div><div class="card"><div class="small-label">Week 4–6</div><p>Only trim curtain bangs if you choose them.</p></div><div class="card"><div class="small-label">Week 8–10</div><p>Trim ends and refresh face frame.</p></div><div class="card"><div class="small-label">Month 3–4</div><p>Refresh overall layer shape.</p></div></div><div class="card dark mt8"><p>This cut is low-maintenance because the layers are long and blended. Short bangs would increase upkeep.</p></div><div class="footer"><span>Generated sample report · maintenance</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">14</div><div class="overline">Curated Inspiration</div><h2 class="big-title">Reference<br/>Direction Board</h2><div class="search-card"><div><div class="photo" style="height:55mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="thumb-grid mt4"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div></div><div class="card dark mt4"><p>Use references for direction, not exact copy.</p></div></div><div class="stack"><div class="note">Search: soft face framing long layers black hair.</div><div class="note">Search: soft butterfly haircut medium long hair.</div><div class="note">Search: long layers curtain bangs asian hair.</div><div class="note">Avoid: wolf cut extreme, short bob, full thick bangs.</div></div></div><div class="footer"><span>Generated sample report · reference board</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">15</div><div class="overline">Next Step</div><h2 class="big-title">Final Action Plan</h2><div class="grid2"><div><div class="photo" style="height:48mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="card dark mt4"><h3>Best next cut</h3><p>Soft face-framing long layers. Keep length, soften ends, frame from chin.</p></div><div class="metric-row"><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">92</b><span style="color:#604219">Fit score</span></div><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">3–4W</b><span style="color:#604219">Refresh</span></div><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">7m</b><span style="color:#604219">Daily</span></div></div></div><div class="stack"><div class="card green"><p>Save salon card — Page 10</p></div><div class="card green"><p>Pick one reference, not five.</p></div><div class="card green"><p>Ask for long face-frame, chin level.</p></div><div class="card green"><p>Use matte/natural finish, not wet look.</p></div><div class="card green"><p>Book cleanup in 8–10 weeks.</p></div></div></div><div class="footer"><span>Generated sample report · final action plan</span><span>HAIRCARD</span></div></section>
</body></html>
