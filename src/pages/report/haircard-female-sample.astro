---
const title = "HairCard Female Salon Sample Report";
const description = "HTML page version of a HairCard female salon-style sample report, matched to the uploaded premium PDF template.";
const image = "/references/haircard/female-sample-input.jpg";
---
<!doctype html><html lang="id"><head><meta charset="utf-8"/><title>{title}</title><meta name="robots" content="noindex, nofollow" /><meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content={image} /><meta name="twitter:card" content="summary_large_image" /><style>
@page{size:A4;margin:0}
*{box-sizing:border-box}html{background:#ded3c3}body{margin:0;background:#ded3c3;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:#20150f}.page{width:210mm;max-width:100vw;height:297mm;margin:0 auto;background:#f3eee5;position:relative;overflow:hidden;page-break-after:always;padding:17mm 16mm 12mm}.cover{padding:0;display:grid;grid-template-columns:51.5% 48.5%;background:#201006}.cover-photo{height:297mm;overflow:hidden}.cover-photo img{width:100%;height:100%;object-fit:cover;object-position:center top}.cover-panel{background:#211006;color:#f8ead4;padding:68mm 17mm 17mm;position:relative}.brandmark{position:absolute;top:12mm;right:15mm;width:7mm;height:7mm;border-radius:1mm;background:#1b0d06;color:#f0b13a;display:grid;place-items:center;font-size:7px;font-weight:950}.page.dark .brandmark,.cover .brandmark{background:#b97818;color:#1b0d06}.footer{position:absolute;left:16mm;right:16mm;bottom:8mm;display:flex;justify-content:space-between;align-items:end;font-size:5.8px;letter-spacing:.04em;color:#bd7b25}.cover .footer{color:#e3c488}.rule{height:1px;background:#e4d9cb;margin:0 0 12mm}.kicker,.overline{font-size:6.4px;letter-spacing:.2em;text-transform:uppercase;color:#bd7b25;font-weight:850}.cover .kicker{color:#bd7b25}.cover h1{font-family:Georgia,serif;font-size:30px;line-height:.92;margin:4mm 0 4mm;color:#f8ead4;letter-spacing:-.03em}.title{font-family:Georgia,serif;font-size:22px;line-height:.95;margin:2mm 0 6mm;color:#19100b;letter-spacing:-.035em}.hero-title{font-family:Georgia,serif;font-size:27px;line-height:.9;margin:3mm 0 5mm;color:#19100b;letter-spacing:-.04em}.subtitle{font-size:8px;line-height:1.45;color:#6e6052;margin:0}.cover .subtitle{color:#d8c1a3}.card{background:#fffaf2;border-radius:3mm;padding:4mm;border:1px solid rgba(58,37,22,.06)}.card h3{font-family:Georgia,serif;font-size:12px;line-height:1.05;margin:0 0 2mm;color:#1c1009}.card p,.card li{font-size:7.2px;line-height:1.45;color:#4e4035;margin:0}.dark-card,.page.dark{background:#211006;color:#f8ead4}.dark-card{border-radius:3mm;padding:4mm}.dark-card h3,.page.dark .hero-title,.page.dark .title{color:#f8ead4}.dark-card p,.dark-card li,.page.dark p,.page.dark li{color:#dfc9ae}.yellow{background:#f7df9a}.green{background:#dff0df}.pink{background:#f1d1d0}.photo{overflow:hidden;border-radius:3mm;background:#decfbb}.photo img{width:100%;height:100%;display:block;object-fit:cover;object-position:center 32%}.metric-row{display:flex;gap:3mm;margin-top:7mm}.metric{background:#2f170a;color:#efb53d;border-radius:2mm;width:18.5mm;padding:3mm}.metric b{display:block;font-family:Georgia,serif;font-size:15px;line-height:1;color:#efb53d}.metric span{display:block;margin-top:1mm;font-size:5.8px;color:#d1b898}.light-metric{background:#f7df9a;color:#3b250f}.light-metric b,.light-metric span{color:#3b250f}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:6mm}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:4mm}.tiny-label{font-size:5.8px;text-transform:uppercase;letter-spacing:.15em;color:#bd7b25;font-weight:900;margin-bottom:1.5mm}.note{background:#f7df9a;border-radius:2mm;padding:3mm;font-size:7.2px;line-height:1.42;color:#4c321b}.quote{font-family:Georgia,serif;font-size:12px;line-height:1.25;color:#25160e}.mt3{margin-top:3mm}.mt4{margin-top:4mm}.mt5{margin-top:5mm}.mt6{margin-top:6mm}.mt8{margin-top:8mm}ul{margin:1.4mm 0 0;padding-left:3.5mm}.baseline{display:grid;grid-template-columns:48mm 1fr;gap:8mm;align-items:start}.baseline .photo{height:82mm}.summary{display:grid;grid-template-columns:1fr 64mm;gap:9mm;align-items:start}.summary .photo{height:70mm}.face-board{display:grid;grid-template-columns:45mm 37mm 1fr;gap:3mm;align-items:stretch}.face-board .photo{height:48mm}.sketch{height:48mm;border-radius:3mm;background:#eadfce;display:grid;grid-template-columns:repeat(3,1fr);gap:2mm;padding:3mm}.sketch span{border:1px solid #d6c6b2;border-radius:50%}.mini-grid{height:48mm;border-radius:3mm;background:#1f130d;padding:2mm;display:grid;grid-template-columns:repeat(3,1fr);gap:1.5mm}.mini-grid .photo{border-radius:1.5mm}.diagnostic-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:4mm;margin-top:4mm}.hair-hero{height:58mm;background:#e7dccd;border-radius:3mm;display:grid;grid-template-columns:1fr 78mm;overflow:hidden}.hair-hero .photo{border-radius:0;height:58mm}.quote-strip{background:#211006;color:#f8ead4;border-radius:2mm;padding:4mm;margin-top:4mm}.primary{display:grid;grid-template-columns:61mm 1fr;gap:7mm}.photo-collage{display:grid;grid-template-columns:1fr 1fr;gap:2.5mm}.photo-collage .photo{height:41mm}.photo-collage .wide{grid-column:1/3;height:43mm}.profile-page{display:grid;grid-template-columns:1fr 70mm;gap:9mm;align-items:start}.profile-page .photo{height:95mm}.fit-card .photo{height:58mm}.band{border-radius:2mm;padding:2.2mm 3mm;font-size:7px;font-weight:800;color:#61391e}.avoid-card .photo{height:62mm}.page.dark{padding-top:47mm}.dark-block{border:1px solid rgba(255,255,255,.08);background:#2a1409;border-radius:3mm;padding:4mm}.scorebar{background:#513509;border:1px solid rgba(240,181,61,.25);border-radius:2mm;padding:4mm;margin-top:8mm}.scorebar b{font-family:Georgia,serif;font-size:18px;color:#efb53d;margin-right:5mm}.angles{display:grid;grid-template-columns:1fr 1fr;gap:5mm}.angle-card .photo{height:52mm}.routine{display:grid;grid-template-columns:1fr 1fr;gap:4mm}.step{display:grid;grid-template-columns:9mm 1fr;gap:3mm}.num{font-family:Georgia,serif;font-size:15px;color:#bd7b25;font-weight:900}.darkbar{background:#211006;color:#f8ead4;border-radius:2mm;padding:3mm 4mm;font-size:7px}.timeline-line{position:relative;height:16mm;margin:8mm 10mm 4mm;border-top:1.5px solid #bd7b25}.timeline-line span{position:absolute;top:-3.5mm;width:7mm;height:7mm;border-radius:50%;border:1.5px solid #bd7b25;background:#f3eee5}.timeline-line span:nth-child(1){left:0}.timeline-line span:nth-child(2){left:25%}.timeline-line span:nth-child(3){left:50%}.timeline-line span:nth-child(4){left:75%}.timeline-line span:nth-child(5){right:0}.ref-layout{display:grid;grid-template-columns:60mm 1fr;gap:6mm}.ref-stack{display:grid;gap:3mm}.check{display:grid;grid-template-columns:4mm 1fr;gap:2mm;align-items:start}.check:before{content:'✓';display:grid;place-items:center;width:4mm;height:4mm;background:#dff0df;border-radius:1mm;color:#2f7b45;font-size:7px;font-weight:900}@media screen and (max-width:900px){.page{width:210mm;max-width:none;margin:0;transform:scale(calc(100vw / 210mm));transform-origin:top left;margin-bottom:calc((297mm * (100vw / 210mm)) - 297mm + 16px)}body{overflow-x:hidden}.cover h1{font-size:25px}.title{font-size:20px}.hero-title{font-size:23px}}
</style></head><body>
<section class="page cover"><div class="cover-photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="cover-panel"><div class="brandmark">HC</div><div class="kicker">Your personal haircut direction</div><h1>Her<br/>HairCard</h1><p class="subtitle">Personal haircut direction built from uploaded photo, face proportion, hair behavior, salon execution, and lifestyle fit.</p><div class="metric-row"><div class="metric"><b>92</b><span>Fit score</span></div><div class="metric"><b>8–10W</b><span>Trim</span></div><div class="metric"><b>7m</b><span>Style</span></div></div><div class="dark-card mt8"><div class="tiny-label">Output</div><p><b>Soft Face-Framing Long Layers.</b><br/>Natural, feminine, low-risk upgrade with salon-ready instruction.</p></div><div class="footer"><span>Female sample, 25</span><span>Female / Salon</span></div></div></section>
<section class="page"><div class="brandmark">02</div><div class="rule"></div><div class="overline">Baseline Input</div><h2 class="title">Baseline Input</h2><div class="baseline"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div><h3 class="quote">Uploaded input photo only.</h3><p class="subtitle mt4">Recommendations use this source photo. Front-view analysis is enough for MVP direction; side/back density is estimated conservatively without a side photo.</p><div class="note mt6"><b>Visible read</b><br/>Medium-long black hair, natural soft wave, medium-thick density, slightly heavy ends.</div><div class="dark-card mt6"><h3>Why this matters</h3><p>The report should not invent a result image on the baseline page. This page is for trust: the user sees what the recommendation is based on.</p></div></div></div><div class="footer"><span>Generated sample report · source photo used only as user input</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">03</div><div class="rule"></div><div class="overline">Executive Summary</div><h2 class="title">Soft Face-Framing<br/>Long Layers</h2><div class="summary"><div><p class="subtitle">Clean, natural, camera-friendly salon upgrade. Best route is not a dramatic chop; it is shape correction with softer movement around the face.</p><div class="metric-row"><div class="metric light-metric"><b>92</b><span>Fit score</span></div><div class="metric light-metric"><b>Low</b><span>Risk</span></div><div class="metric light-metric"><b>Med</b><span>Change</span></div></div><div class="note mt6">Best upgrade: face-framing layer around chin, soft U-shape ends, long layers, optional long curtain bangs only.</div></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div></div><div class="footer"><span>Generated sample report · fast read and key score</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">04</div><div class="rule"></div><div class="overline">Diagnostic Layer</div><h2 class="title">Face Shape &<br/>Balance Map</h2><div class="face-board"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="sketch"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><div class="mini-grid"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div></div></div><div class="diagnostic-cards"><div class="card"><div class="tiny-label">Face</div><p>Soft oval-round</p></div><div class="card"><div class="tiny-label">Strategy</div><p>Open the face from chin level down.</p></div><div class="card"><div class="tiny-label">Avoid</div><p>Avoid cheek-level bulk.</p></div><div class="dark-card"><div class="tiny-label">Key</div><p>Vertical movement, soft frame.</p></div></div><div class="footer"><span>Generated sample report · face shape and balance map</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">05</div><div class="rule"></div><div class="overline">Texture Read</div><h2 class="title">Hair Type &<br/>Growth Behavior</h2><div class="hair-hero"><div></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div></div><div class="quote-strip"><p>“The hair already has enough density. The upgrade is controlled lightness, not aggressive thinning.”</p></div><div class="grid2 mt5"><div class="card"><div class="tiny-label">Density</div><h3>Medium-thick</h3></div><div class="card"><div class="tiny-label">Texture</div><h3>Straight / soft wave</h3></div><div class="card"><div class="tiny-label">Volume</div><h3>Natural-flat top</h3></div><div class="card"><div class="tiny-label">Finish</div><h3>Soft C-curl</h3></div></div><div class="footer"><span>Generated sample report · texture read</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">06</div><div class="rule"></div><div class="overline">Best Fit</div><h2 class="title">Primary Haircut<br/>Recommendation</h2><div class="primary"><div class="photo-collage"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo wide"><img src="/references/haircard/female-sample-input.jpg"/></div></div><div><div class="dark-card"><div class="tiny-label">Main recommendation</div><p>Soft face-framing long layers. Keep length below shoulder. Start face-frame around chin / slightly below cheekbone.</p></div><div class="card mt4"><div class="tiny-label">Layer</div><p>Long, soft, blended. No choppy shelf.</p></div><div class="card mt4"><div class="tiny-label">Ends</div><p>Light U-shape, not blunt-heavy.</p></div><div class="card mt4"><div class="tiny-label">Finish</div><p>Natural blowout, soft C-curl, light oil.</p></div></div></div><div class="footer"><span>Generated sample report · primary recommendation</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">07</div><div class="rule"></div><div class="overline">Safer Precision</div><h2 class="title">Side Profile &<br/>Layer Guide</h2><div class="profile-page"><div><h3 class="quote">Keep the front layer low.</h3><p class="subtitle mt4">Because no side photo is provided, the safest execution is conservative: long front layers, gradual blend, no cheek-level puff.</p><ul class="mt6"><li>Start around chin, not cheek</li><li>Blend gradually to mid-length</li><li>Keep back full but lighter at the ends</li><li>No aggressive thinning</li></ul></div><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div></div><div class="footer"><span>Generated sample report · side/profile guide</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">08</div><div class="rule"></div><div class="overline">Complete Look</div><h2 class="title">Outfit &<br/>Activity Fit</h2><div class="grid3"><div class="card fit-card"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="tiny-label mt4">Daily</div><p>Natural, clean, easy to manage.</p></div><div class="card fit-card"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="tiny-label mt4">Work / Study</div><p>Soft mature without looking stiff.</p></div><div class="card fit-card"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="tiny-label mt4">Social</div><p>Face frame improves front camera shape.</p></div></div><div class="band pink mt5">Key variable: keep the look soft and salon-polished, not over-layered.</div><div class="footer"><span>Generated sample report · lifestyle fit</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">09</div><div class="rule"></div><div class="overline">Worst Pitfall</div><h2 class="title">Styles to Avoid</h2><div class="grid3"><div class="card avoid-card"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="tiny-label mt4">Above-chin bob</div><p>Makes soft-round proportion look shorter.</p></div><div class="card avoid-card"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="tiny-label mt4">Full thick bangs</div><p>Compresses the face and hides openness.</p></div><div class="card avoid-card"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="tiny-label mt4">Blunt one-length</div><p>Too heavy for medium-thick dark hair.</p></div></div><p class="subtitle mt5"><b>The report should say no clearly. Trend specs can fight the face shape.</b></p><div class="band green mt4">✓ Better: soft face-framing + low-maintenance long layers</div><div class="footer"><span>Generated sample report · avoid list</span><span>HAIRCARD</span></div></section>
<section class="page dark"><div class="brandmark">10</div><div class="overline">Screenshot-Ready</div><h2 class="title">I want soft face-framing<br/>long layers.</h2><p class="subtitle">Keep the length, soften the ends, and frame the face from chin level down.</p><div class="grid2 mt8"><div class="dark-block"><div class="tiny-label">Do</div><ul><li>Keep below shoulder length</li><li>Face frame starts around chin</li><li>Soft U-shape ends</li><li>Natural blowout / C-curl</li></ul></div><div class="dark-block"><div class="tiny-label">Do not</div><ul><li>No full thick bangs</li><li>No cheek-level heavy layer</li><li>No blunt heavy ends</li><li>No aggressive thinning</li></ul></div></div><div class="scorebar"><b>92</b><span>Face Fit Score — this cut is calculated specifically for the face shape and hair behavior.</span></div><div class="footer"><span>This page is meant to screenshot for salon</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">11</div><div class="rule"></div><div class="overline">Angle Guide</div><h2 class="title">How to Photo<br/>This Haircut</h2><p class="subtitle">Use these angles after the salon to check whether the shape actually works.</p><div class="angles mt6"><div class="card angle-card"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="tiny-label mt4">Front, natural light</div><p>Check whether face frame opens the face.</p></div><div class="card angle-card"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="tiny-label mt4">Half side</div><p>Check if layer blends smoothly.</p></div><div class="card angle-card"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="tiny-label mt4">Ends</div><p>Check U-shape, no blunt heavy block.</p></div><div class="card angle-card"><div class="photo"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="tiny-label mt4">Styled</div><p>Check C-curl and face-frame direction.</p></div></div><div class="footer"><span>Generated sample report · angle guide</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">12</div><div class="rule"></div><div class="overline">Daily Installation</div><h2 class="title">Styling Routine<br/>& Products</h2><div class="routine mt6"><div class="card step"><div class="num">01</div><div><h3>Towel dry</h3><p>Leave slightly damp. Do not oil the roots.</p></div></div><div class="card step"><div class="num">02</div><div><h3>Blow dry</h3><p>Direct front layer away from face.</p></div></div><div class="card step"><div class="num">03</div><div><h3>C-curl ends</h3><p>Use round brush or large iron.</p></div></div><div class="card step"><div class="num">04</div><div><h3>Light finish</h3><p>Hair oil only mid-length to ends.</p></div></div></div><div class="darkbar mt6"><b>7m</b> &nbsp; Total daily routine — soft, consistent result every morning</div><div class="note mt6">Use: heat protectant, lightweight oil, smoothing cream if frizzy. Avoid wet-look gel and heavy root oil.</div><div class="footer"><span>Generated sample report · routine</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">13</div><div class="rule"></div><div class="overline">Shape Over Time</div><h2 class="title">Maintenance<br/>Timeline</h2><div class="timeline-line"><span></span><span></span><span></span><span></span><span></span></div><div class="note mt4">Book taper cleanup every 8–10 weeks.</div><div class="grid2 mt5"><div class="card"><div class="tiny-label">Week 1</div><p>Learn the blow direction. Take one front photo after styling.</p></div><div class="card"><div class="tiny-label">Week 4–6</div><p>Only trim curtain bangs if you choose them.</p></div><div class="card"><div class="tiny-label">Week 8–10</div><p>Trim ends and refresh face frame.</p></div><div class="card"><div class="tiny-label">Month 3–4</div><p>Refresh overall layer shape.</p></div></div><div class="dark-card mt6"><p>This cut is low-maintenance because the layers are long and blended. Short bangs would increase upkeep.</p></div><div class="footer"><span>Generated sample report · maintenance timeline</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">14</div><div class="rule"></div><div class="overline">Curated Inspiration</div><h2 class="title">Reference<br/>Direction Board</h2><div class="ref-layout"><div><div class="photo" style="height:62mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="grid2 mt3"><div class="photo" style="height:34mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="photo" style="height:34mm"><img src="/references/haircard/female-sample-input.jpg"/></div></div><div class="dark-card mt3"><p>Use references for direction, not exact copy.</p></div></div><div class="ref-stack"><div class="note">Search: soft face framing long layers black hair.</div><div class="note">Search: soft butterfly haircut medium long hair.</div><div class="note">Search: long layers curtain bangs asian hair.</div><div class="note">Avoid: wolf cut extreme, short bob, full thick bangs.</div><div class="photo" style="height:38mm"><img src="/references/haircard/female-sample-input.jpg"/></div></div></div><div class="footer"><span>Generated sample report · reference board</span><span>HAIRCARD</span></div></section>
<section class="page"><div class="brandmark">15</div><div class="rule"></div><div class="overline">Next Step</div><h2 class="title">Final Action Plan</h2><div class="grid2"><div><div class="photo" style="height:48mm"><img src="/references/haircard/female-sample-input.jpg"/></div><div class="dark-card mt4"><div class="tiny-label">Best next cut</div><p><b>Soft Face-Framing Long Layers.</b><br/>Keep length, soften ends, frame from chin.</p></div><div class="metric-row"><div class="metric light-metric"><b>92</b><span>Fit score</span></div><div class="metric light-metric"><b>8–10W</b><span>Trim</span></div><div class="metric light-metric"><b>7m</b><span>Daily</span></div></div></div><div class="ref-stack"><div class="card check"><p>Save salon card — Page 10</p></div><div class="card check"><p>Pick one reference, not five</p></div><div class="card check"><p>Ask for long face-frame, chin level</p></div><div class="card check"><p>Use matte/natural finish, not wet look</p></div><div class="card check"><p>Book cleanup in 8–10 weeks</p></div></div></div><div class="footer"><span>Generated sample report · final action plan</span><span>HAIRCARD</span></div></section></body></html>