---
const title = "HairCard Male Barber Sample Report";
const description = "HTML page version of a HairCard male barber-style sample report, based on the premium PDF report template.";
const image = "/references/haircard/male-sample-input.jpg";
---
<!doctype html>
<html lang="id"><head><meta charset="utf-8"/><title>{title}</title>
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
<style>
@page{size:A4;margin:0}*{box-sizing:border-box}html{background:#ddd1c0}body{margin:0;background:#ddd1c0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:#20150f}.page{width:210mm;max-width:100vw;height:297mm;margin:0 auto;background:#f4eee4;position:relative;overflow:hidden;page-break-after:always;padding:16mm 17mm}.cover{padding:0;display:grid;grid-template-columns:51% 49%;background:#201006}.cover .cover-photo{height:297mm;overflow:hidden}.cover img{width:100%;height:100%;object-fit:cover;object-position:center top}.cover-side{background:#211006;color:#f7e9d3;padding:58mm 18mm 16mm 18mm;position:relative}.kicker{font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:#c38523;font-weight:800;margin-bottom:5mm}.brand-page{position:absolute;top:14mm;right:16mm;width:6mm;height:6mm;background:#1d100b;color:#f4c263;border-radius:1mm;font-size:7px;display:grid;place-items:center;font-weight:900}.page.dark .brand-page,.cover .brand-page{background:#c27a16;color:#1d100b}.footer{position:absolute;left:17mm;right:17mm;bottom:10mm;display:flex;justify-content:space-between;color:#c58d3a;font-size:6px;letter-spacing:.05em}.cover .footer{color:#e5c488}.overline{font-size:7px;letter-spacing:.2em;color:#bd7b25;text-transform:uppercase;font-weight:800}.title{font-family:Georgia,serif;font-size:27px;line-height:.95;margin:0;color:#1e130d}.cover h1{font-family:Georgia,serif;font-size:34px;line-height:.95;margin:4mm 0;color:#f9ead5}.subtitle{font-size:9.5px;line-height:1.5;color:#715f50}.cover .subtitle{color:#d7bfa1}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:6mm}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:4mm}.card{background:#fffaf2;border-radius:3mm;padding:4mm;box-shadow:0 0 0 1px rgba(75,45,24,.06);border:1px solid rgba(60,35,20,.06)}.card.dark{background:#241108;color:#fff1d9}.card.yellow{background:#fae6ae}.card.green{background:#dff1df}.card.pink{background:#f2d0d0}.card h3{font-family:Georgia,serif;font-size:14px;line-height:1.05;margin:0 0 2mm;color:#1d100b}.card.dark h3{color:#fff1d9}.card p,.card li{font-size:8.3px;line-height:1.45;color:#4d4035;margin:0}.card.dark p,.card.dark li{color:#e5cdb2}ul{margin:1.5mm 0 0;padding-left:3.5mm}.photo{border-radius:3mm;overflow:hidden;background:#ddd0bc}.photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top}.metric-row{display:flex;gap:3mm;margin-top:8mm}.metric{background:#3a1c0c;color:#eeb542;border-radius:2mm;padding:3mm;width:19mm}.metric b{display:block;color:#eeb542;font-size:15px}.metric span{font-size:6.5px;color:#cdb493}.cover .metric{background:#2e180d}.note{background:#f7df9a;border-radius:2mm;padding:3mm;font-size:8px;line-height:1.4;color:#4c321b}.section{margin-top:12mm}.split-main{display:grid;grid-template-columns:45mm 1fr;gap:7mm;align-items:start}.big-title{font-family:Georgia,serif;font-size:30px;line-height:.92;margin:3mm 0 5mm;color:#1d100b}.hero-title{font-family:Georgia,serif;font-size:33px;line-height:.9;margin:4mm 0 5mm}.small-label{font-size:6.5px;text-transform:uppercase;letter-spacing:.18em;color:#c38122;font-weight:900;margin-bottom:1.5mm}.quote{font-family:Georgia,serif;font-size:16px;line-height:1.25}.pill{display:inline-block;background:#f7dfa1;border-radius:2mm;padding:2mm 3mm;font-size:8px;font-weight:800;color:#5d3b15;margin:1mm}.dark.page{background:#211006;color:#fff1d9}.dark.page .title,.dark.page .big-title,.dark.page .hero-title{color:#fff1d9}.dark.page .subtitle{color:#cdb69c}.dark-block{background:#2a1409;border-radius:3mm;padding:5mm}.routine{display:grid;grid-template-columns:1fr 1fr;gap:4mm}.step{display:grid;grid-template-columns:10mm 1fr;gap:3mm;align-items:start}.num{font-family:Georgia,serif;color:#c38122;font-size:18px;font-weight:900}.timeline{margin-top:8mm}.line{height:2px;background:#c88121;position:relative;margin:13mm 8mm 9mm}.dot{position:absolute;top:-3.5mm;width:8mm;height:8mm;border:2px solid #c88121;border-radius:50%;background:#f4eee4}.dot:nth-child(1){left:0}.dot:nth-child(2){left:24%}.dot:nth-child(3){left:50%}.dot:nth-child(4){left:74%}.dot:nth-child(5){right:0}.search-card{display:grid;grid-template-columns:55mm 1fr;gap:5mm;align-items:start}.tiny{font-size:7px!important}.avoid-row{display:grid;grid-template-columns:repeat(3,1fr);gap:4mm}.avoid-img{height:62mm;border-radius:3mm;background:#e6d7c4;overflow:hidden}.avoid-img img{width:100%;height:100%;object-fit:cover}.thumb-grid{display:grid;grid-template-columns:1fr 1fr;gap:3mm}.thumb-grid .photo{height:36mm}.band{height:9mm;border-radius:2mm;padding:2.5mm 4mm;font-size:8px;font-weight:800;margin-top:4mm}.center{display:flex;align-items:center;justify-content:center}.refbox{height:48mm;border-radius:3mm;background:#e9d8c3;padding:4mm;display:flex;align-items:end;font-weight:900;color:#331b0d;font-size:10px}.frame{border:1px solid #eadfce;border-radius:2mm;padding:2mm}.mt4{margin-top:4mm}.mt6{margin-top:6mm}.mt8{margin-top:8mm}
@media screen and (max-width: 900px){.page{width:210mm;max-width:none;margin:0;transform:scale(calc(100vw / 210mm));transform-origin:top left;margin-bottom:calc((297mm * (100vw / 210mm)) - 297mm + 16px)}body{overflow-x:hidden}.cover h1{font-size:26px}.title{font-size:23px}.big-title{font-size:24px}.hero-title{font-size:26px}}
</style></head><body>
<div class="webbar"><a href="/report/haircard">← HairCard reference</a><span>HTML sample report · Male / Barber</span></div>
<style>.webbar{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;gap:12px;padding:10px 16px;background:#211006;color:#f7e9d3;font:700 12px Inter,system-ui}.webbar a{color:#f4c263;text-decoration:none}</style>

<section class="page cover"><div class="cover-photo"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="cover-side"><div class="brand-page">HC</div><div class="kicker">Your personal haircut direction</div><h1>Raka’s<br/>HairCard</h1><p class="subtitle">Personalized barber direction based on uploaded photo, face proportion, hair behavior, barber execution, and lifestyle fit.</p><div class="metric-row"><div class="metric"><b>92</b><span>Fit score</span></div><div class="metric"><b>3–4W</b><span>Clean-up</span></div><div class="metric"><b>7m</b><span>Style</span></div></div><div class="card dark mt8"><div class="small-label">Output</div><p><b>Textured crop + low taper.</b><br/>Cleaner, more structured, natural matte finish with barber-ready instruction.</p></div><div class="footer"><span>HairCard Report</span><span>Male / Barber</span></div></div></section>

<section class="page"><div class="brand-page">02</div><div class="overline">Baseline Input</div><h2 class="big-title">Baseline Input</h2><div class="split-main"><div class="photo" style="height:95mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div><h3 class="title" style="font-size:16px">Uploaded input photo only.</h3><p class="subtitle mt4">Recommendations use this source photo. Front-view analysis is enough for MVP direction; exact side/back taper execution should stay conservative without a side photo.</p><div class="note mt6"><b>Visible read</b><br/>Medium-length black hair, thick density, natural side volume, front falls slightly heavy.</div><div class="card dark mt6"><h3>Why this matters</h3><p>The report should not invent a new baseline image. This page is for trust: the user sees exactly what the recommendation is based on.</p></div></div></div><div class="footer"><span>Generated sample report · source photo used only as user input</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">03</div><div class="overline">Executive Summary</div><h2 class="hero-title">Textured Crop<br/>+ Low Taper</h2><div class="grid2"><div><p class="subtitle">Cleaner, camera-friendly barber upgrade. Best route is not a high fade; it is controlled side cleanup with textured top and natural front direction.</p><div class="metric-row"><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">92</b><span style="color:#604219">Fit score</span></div><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">Low</b><span style="color:#604219">Risk</span></div><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">Med</b><span style="color:#604219">Change</span></div></div><div class="note mt6">Best upgrade: textured crop top, low taper around sideburn/nape, keep natural density, matte finish. Avoid high fade and overly short fringe.</div></div><div class="photo" style="height:85mm"><img src="/references/haircard/male-sample-input.jpg"/></div></div><div class="footer"><span>Generated sample report · summary direction</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">04</div><div class="overline">Diagnostic Top</div><h2 class="big-title">Face Shape &<br/>Balance Map</h2><div class="grid2"><div class="photo" style="height:86mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="thumb-grid"><div class="card"><div class="small-label">Face read</div><p>Oval-round with soft jaw. Balanced face, but side bulk can make it look wider.</p></div><div class="card"><div class="small-label">Best strategy</div><p>Reduce side puff. Keep top texture and vertical lift.</p></div><div class="card"><div class="small-label">Risk</div><p>High side volume or flat fringe can widen the face.</p></div><div class="card dark"><div class="small-label">Key</div><p>Keep sides clean and top naturally textured.</p></div></div></div><div class="note mt8">Target: clean the sides, keep enough top length, and make the front look intentional without a harsh fade.</div><div class="footer"><span>Generated sample report · face proportion estimate from front photo</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">05</div><div class="overline">Texture Read</div><h2 class="big-title">Hair Type &<br/>Growth Behavior</h2><div class="card" style="height:60mm;display:grid;grid-template-columns:1fr 2fr;gap:5mm;align-items:center"><div class="photo" style="height:48mm"><img src="/references/haircard/male-sample-input.jpg"/></div><p class="quote">“The hair already has strong density. The upgrade is controlled shape: cleaner sides, lighter texture, and a natural matte top.”</p></div><div class="grid2 mt8"><div class="card"><div class="small-label">Density</div><h3>Thick / dense</h3></div><div class="card"><div class="small-label">Texture</div><h3>Straight / slight wave</h3></div><div class="card"><div class="small-label">Volume</div><h3>Side-heavy volume</h3></div><div class="card"><div class="small-label">Finish</div><h3>Matte texture</h3></div></div><div class="footer"><span>Generated sample report · hair behavior estimate</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">06</div><div class="overline">Best Fit</div><h2 class="big-title">Primary Haircut<br/>Recommendation</h2><div class="grid2"><div class="thumb-grid"><div class="photo"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="photo"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="photo" style="grid-column:1/3;height:43mm"><img src="/references/haircard/male-sample-input.jpg"/></div></div><div><div class="card dark"><h3>Haircut decision</h3><p>Textured crop + low taper. Keep length below shoulder. Start face-frame around chin / slightly below cheekbone.</p></div><div class="card mt4"><div class="small-label">Top</div><p>Textured, medium length, natural forward/side direction.</p></div><div class="card mt4"><div class="small-label">Back / nape</div><p>Low taper only, keep transition soft and natural.</p></div><div class="card mt4"><div class="small-label">Finish</div><p>Matte clay/paste, low shine, finger-styled texture.</p></div></div></div><div class="footer"><span>Generated sample report · primary recommendation</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">07</div><div class="overline">Safer Precision</div><h2 class="big-title">Side Profile &<br/>Top Guide</h2><div class="grid2"><div><h3 class="title" style="font-size:24px">Keep the taper low.</h3><p class="subtitle mt4">Because no side photo is provided, the safest execution is conservative: low taper, natural neckline, no skin-high fade.</p><ul class="mt6"><li>Start taper low around sideburn/nape.</li><li>Blend gradually into the side length.</li><li>Clean the nape but keep natural shape.</li><li>No wet shiny gel look.</li></ul></div><div class="photo" style="height:110mm"><img src="/references/haircard/male-sample-input.jpg"/></div></div><div class="footer"><span>Generated sample report · side/back guidance estimated</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">08</div><div class="overline">Complete Look</div><h2 class="big-title">Outfit &<br/>Activity Fit</h2><div class="grid3"><div class="card"><div class="photo" style="height:55mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="small-label mt4">Daily</div><p>Clean, natural, easy to restyle.</p></div><div class="card"><div class="photo" style="height:55mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="small-label mt4">Office</div><p>Sharper for meetings without looking overdone.</p></div><div class="card"><div class="photo" style="height:55mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="small-label mt4">Weekend</div><p>Textured top reads better in photos.</p></div></div><div class="band pink">Key variable: clean but not harsh. Low taper beats high fade for this face.</div><div class="footer"><span>Generated sample report · lifestyle fit</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">09</div><div class="overline">Worst Pitfall</div><h2 class="big-title">Styles to Avoid</h2><div class="avoid-row"><div class="card"><div class="avoid-img"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="small-label mt4">High skin fade</div><p>Can make the sides look too exposed and harsh.</p></div><div class="card"><div class="avoid-img"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="small-label mt4">Heavy flat fringe</div><p>Drops the face visually and makes the top look flat.</p></div><div class="card"><div class="avoid-img"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="small-label mt4">Long puffy sides</div><p>Adds width around cheek/ear area.</p></div></div><div class="band green">Better path: textured crop + low taper + matte natural finish.</div><div class="footer"><span>Generated sample report · avoid list</span><span>HAIRCARD</span></div></section>

<section class="page dark"><div class="brand-page">10</div><div class="overline">Screenshot-Ready</div><h2 class="hero-title">I want a textured crop<br/>with low taper.</h2><p class="subtitle">Keep medium top length, clean the sides low, and style with natural matte texture.</p><div class="grid2 mt8"><div class="dark-block"><div class="small-label">Do</div><ul><li>Keep top medium length.</li><li>Low taper around sideburn/nape.</li><li>Natural neckline cleanup.</li><li>Matte textured finish.</li></ul></div><div class="dark-block"><div class="small-label">Do not</div><ul><li>No high skin fade.</li><li>No puffy side bulk.</li><li>No heavy flat fringe.</li><li>No wet shiny gel look.</li></ul></div></div><div class="card yellow mt8"><h3>92 &nbsp; Fit Score</h3><p>The cut is calculated specifically for his face shape and hair behavior.</p></div><div class="footer"><span>Screenshot this page for barber</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">11</div><div class="overline">Angle Guide</div><h2 class="big-title">How to Photo<br/>This Haircut</h2><p class="subtitle">Use these angles after the barber visit to check whether the taper and top shape actually work.</p><div class="grid2 mt6"><div class="card"><div class="photo" style="height:48mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="small-label mt4">Front, natural light</div><p>Check whether sides are clean but not too high.</p></div><div class="card"><div class="photo" style="height:48mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="small-label mt4">Side angle</div><p>Check taper blend and side profile.</p></div><div class="card"><div class="photo" style="height:48mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="small-label mt4">Back / nape</div><p>Check natural neckline, no harsh block.</p></div><div class="card"><div class="photo" style="height:48mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="small-label mt4">Styled top</div><p>Check matte texture and front direction.</p></div></div><div class="footer"><span>Generated sample report · photo guide</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">12</div><div class="overline">Daily Installation</div><h2 class="big-title">Styling Routine<br/>& Products</h2><div class="routine mt6"><div class="card step"><div class="num">01</div><div><h3>Damp dry</h3><p>Hair should be damp, not wet. Push direction with fingers.</p></div></div><div class="card step"><div class="num">02</div><div><h3>Lift top</h3><p>Blow top slightly up and forward/side, not flat down.</p></div></div><div class="card step"><div class="num">03</div><div><h3>Apply matte product</h3><p>Use small amount of matte clay/paste, rub fully in palms.</p></div></div><div class="card step"><div class="num">04</div><div><h3>Finger texture</h3><p>Pinch texture lightly. No combed helmet shape.</p></div></div></div><div class="card dark mt8"><h3>7m &nbsp; Total daily routine</h3><p>Low effort, clean result every morning.</p></div><div class="note mt6">Use: sea-salt spray optional, matte clay/paste, light hairspray optional. Avoid wet-look gel and shiny pomade.</div><div class="footer"><span>Generated sample report · routine</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">13</div><div class="overline">Shape Over Time</div><h2 class="big-title">Maintenance<br/>Timeline</h2><div class="timeline"><div class="line"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></div></div><div class="grid2 mt8"><div class="card"><div class="small-label">Week 1</div><p>Learn product amount and front direction. Take one front photo after styling.</p></div><div class="card"><div class="small-label">Week 4–6</div><p>Clean sideburn/nape if it starts looking puffy.</p></div><div class="card"><div class="small-label">Week 8–10</div><p>Full cleanup: taper, sides, nape, top texture.</p></div><div class="card"><div class="small-label">Month 3–4</div><p>Re-evaluate top length and whether to keep crop or grow out.</p></div></div><div class="card dark mt8"><p>This cut is low-maintenance because the taper stays low and the top remains natural. High fade would require faster cleanup.</p></div><div class="footer"><span>Generated sample report · maintenance</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">14</div><div class="overline">Curated Inspiration</div><h2 class="big-title">Reference<br/>Direction Board</h2><div class="search-card"><div><div class="photo" style="height:55mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="thumb-grid mt4"><div class="photo"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="photo"><img src="/references/haircard/male-sample-input.jpg"/></div></div><div class="card dark mt4"><p>Use references for direction, not exact copy.</p></div></div><div class="stack"><div class="note">Search: textured crop low taper asian hair.</div><div class="note">Search: natural textured crop medium top.</div><div class="note">Search: low taper messy texture men.</div><div class="note">Avoid: high skin fade, heavy bowl fringe, wet slick gel.</div></div></div><div class="footer"><span>Generated sample report · reference board</span><span>HAIRCARD</span></div></section>

<section class="page"><div class="brand-page">15</div><div class="overline">Next Step</div><h2 class="big-title">Final Action Plan</h2><div class="grid2"><div><div class="photo" style="height:48mm"><img src="/references/haircard/male-sample-input.jpg"/></div><div class="card dark mt4"><h3>Best next cut</h3><p>Textured crop + low taper. Keep length, soften ends, frame from chin.</p></div><div class="metric-row"><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">92</b><span style="color:#604219">Fit score</span></div><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">3–4W</b><span style="color:#604219">Refresh</span></div><div class="metric" style="background:#f4cf73;color:#3b250f"><b style="color:#3b250f">7m</b><span style="color:#604219">Daily</span></div></div></div><div class="stack"><div class="card green"><p>Save barber card — Page 10</p></div><div class="card green"><p>Pick one reference, not five.</p></div><div class="card green"><p>Ask for low taper, not high fade.</p></div><div class="card green"><p>Use matte/natural finish, not wet look.</p></div><div class="card green"><p>Book cleanup in 3–4 weeks.</p></div></div></div><div class="footer"><span>Generated sample report · final action plan</span><span>HAIRCARD</span></div></section>
</body></html>
