---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "HairCard Premium Report Mockup";
const description = "FaceCard-inspired premium HairCard report mockup with comprehensive, dense, English report pages and Indonesian product notes.";

const reportPages = [
  {
    no: "01",
    title: "Hair Identity Snapshot",
    label: "Personal profile",
    purpose: "Halaman pembuka yang bikin user merasa ini bukan template. Langsung ada identity, style direction, fit score, dan visual hero.",
    message: "This report was built around your face structure, visible hair behavior, and desired grooming direction.",
    big: "Your best direction is clean texture, compact sides, and a natural matte finish.",
    modules: ["Face-fit score", "Hair behavior", "Style direction", "Maintenance level"],
    imageSlots: ["Main selfie / AI portrait", "Recommended look thumbnail"],
    variant: "cover",
  },
  {
    no: "02",
    title: "Executive Style Summary",
    label: "Decision page",
    purpose: "Versi cepat untuk user yang cuma mau jawaban. Ini harus terasa seperti stylist kasih verdict langsung.",
    message: "If you only choose one cut, choose the textured crop with a low taper.",
    big: "Best cut: Textured Crop + Low Taper. Backup: Natural Side Part. Avoid: heavy middle-part volume.",
    modules: ["Best cut", "Backup option", "Avoid", "Barber risk", "Confidence level", "Effort"],
    imageSlots: ["Current look", "Best direction", "Backup direction"],
    variant: "score",
  },
  {
    no: "03",
    title: "Face Shape & Balance Map",
    label: "Diagnostic layer",
    purpose: "Bikin rekomendasi credible. User harus lihat bahwa report membaca forehead, cheek width, jaw, dan face length.",
    message: "The goal is to sharpen the frame without adding unnecessary width around the temples.",
    big: "Oval-leaning face with soft rectangular influence. Needs controlled side volume and broken top texture.",
    modules: ["Forehead ratio", "Cheek width", "Jaw balance", "Face length", "Temple volume", "Best silhouette"],
    imageSlots: ["Annotated face diagram", "Silhouette comparison"],
    variant: "diagram",
  },
  {
    no: "04",
    title: "Hair Type & Growth Behavior",
    label: "Texture read",
    purpose: "Ini bikin report beda dari face-shape-only AI. Haircut gagal sering karena texture/density, bukan karena wajah.",
    message: "Your cut should work with your natural hair direction instead of forcing a style that collapses after one hour.",
    big: "Medium density, straight-to-slight-wave texture, natural front lift, moderate styling hold required.",
    modules: ["Density", "Texture", "Front lift", "Side bulk", "Product fit", "Collapse risk"],
    imageSlots: ["Hair texture crop", "Growth direction map"],
    variant: "texture",
  },
  {
    no: "05",
    title: "Primary Haircut Recommendation",
    label: "Best fit",
    purpose: "Halaman jualan utama. Harus punya visual kuat dan instruksi teknis ringkas.",
    message: "Ask for a textured crop with a low taper. Keep it natural, not overly sharp or wet-looking.",
    big: "Top 5–7 cm, broken texture, low taper around the ear, natural neckline, matte finish.",
    modules: ["Top length", "Side taper", "Fringe", "Back", "Finish", "Why it works"],
    imageSlots: ["Front AI preview", "Side AI preview", "Detail texture preview"],
    variant: "heroPreview",
  },
  {
    no: "06",
    title: "Safe Upgrade Option",
    label: "Low-risk version",
    purpose: "User yang takut berubah tetap punya opsi. Ini menaikkan usability karena tidak semua orang mau dramatic makeover.",
    message: "Choose this if you want to look cleaner without making the haircut feel too styled.",
    big: "Natural side part with soft taper: professional, easy to maintain, and low barber risk.",
    modules: ["Best for", "Risk", "Maintenance", "Work setting", "Photo setting", "Barber brief"],
    imageSlots: ["Safe preview", "Before-to-upgrade comparison"],
    variant: "safe",
  },
  {
    no: "07",
    title: "Trend-Aware Direction",
    label: "Social reference",
    purpose: "Masukin value sosmed tapi tetap filtered. Bukan ikut trend buta, tapi trend yang disesuaikan wajah.",
    message: "Use the softer version of this trend, not the extreme version you see on TikTok.",
    big: "Soft two-block inspired texture works if the fringe is lighter and the sides stay controlled.",
    modules: ["Trend match", "Face fit", "What to copy", "What to avoid", "Maintenance", "Reference angle"],
    imageSlots: ["Trend preview", "Reference board crop", "Face-compatible version"],
    variant: "trend",
  },
  {
    no: "08",
    title: "Styles to Avoid",
    label: "Honest filter",
    purpose: "Premium report harus berani bilang tidak. Ini bikin trust naik karena nggak semua gaya dipuji.",
    message: "Not every popular haircut works for your face and hair behavior.",
    big: "Avoid heavy middle parts, blunt mushroom fringe, high disconnected undercuts, and wet slick-back styling.",
    modules: ["Adds width", "Flattens front", "Too harsh", "Too shiny", "Better alternative", "Why"],
    imageSlots: ["Avoid style 1", "Avoid style 2", "Avoid style 3", "Better version"],
    variant: "avoid",
  },
  {
    no: "09",
    title: "Barber Instruction Card",
    label: "Screenshot-ready",
    purpose: "Ini halaman yang harus bisa langsung ditunjukkan ke barber. Value praktis terbesar selain image generation.",
    message: "Show this page to your barber and use the exact wording below.",
    big: "I want a textured crop with a low taper. Keep the top 5–7 cm, add broken texture, avoid blunt fringe, and finish matte.",
    modules: ["Say this", "Do", "Don't", "Length", "Finish", "Reference"],
    imageSlots: ["Barber card", "Tiny reference image"],
    variant: "barber",
  },
  {
    no: "10",
    title: "Front View Shape Guide",
    label: "Visual execution",
    purpose: "Mengunci ekspektasi dari depan. Barber sering salah paham fringe dan side width.",
    message: "From the front, the cut should create light vertical texture and keep the sides compact.",
    big: "Good front shape: open, textured, controlled. Bad shape: wide, heavy, blunt, face-closing.",
    modules: ["Good silhouette", "Bad silhouette", "Fringe line", "Temple width", "Volume target", "Photo check"],
    imageSlots: ["Good front", "Bad front", "Fringe diagram"],
    variant: "front",
  },
  {
    no: "11",
    title: "Side Profile & Taper Guide",
    label: "Barber precision",
    purpose: "Taper/fade height harus jelas. Ini bikin hasil potong lebih reliable.",
    message: "Keep the taper low and gradual. Do not disconnect the side wall from the top.",
    big: "Low taper point near the ear, compact temple, natural neckline, no aggressive high fade.",
    modules: ["Taper point", "Temple", "Side wall", "Neckline", "Back shape", "Fade warning"],
    imageSlots: ["Side AI preview", "Taper arrow map"],
    variant: "side",
  },
  {
    no: "12",
    title: "Styling Routine & Products",
    label: "Daily repeatability",
    purpose: "Mencegah user kecewa karena haircut bagus tapi styling salah. Ini bikin report lebih useful setelah potong.",
    message: "The goal is a natural matte finish with controlled texture, not a stiff or wet look.",
    big: "Towel dry, blow dry forward/up, apply small matte clay, break texture with fingers, avoid heavy gel.",
    modules: ["Morning routine", "Product type", "Amount", "Technique", "Avoid", "Fix flat hair"],
    imageSlots: ["Product cards", "Step-by-step icons"],
    variant: "routine",
  },
  {
    no: "13",
    title: "Maintenance Timeline",
    label: "Grow-out plan",
    purpose: "Bikin user tahu kapan harus cleanup dan apa yang berubah dari minggu ke minggu.",
    message: "This cut looks best in weeks 1–3. By week 4, side bulk will start to show.",
    big: "Book taper cleanup every 3–4 weeks. Full reshape around week 5 if the top loses texture.",
    modules: ["Week 1", "Week 2–3", "Week 4", "Week 5+", "Cleanup", "Reshape"],
    imageSlots: ["Timeline", "Growth behavior mini chart"],
    variant: "timeline",
  },
  {
    no: "14",
    title: "Social Reference Board",
    label: "Curated inspiration",
    purpose: "Menjawab kebutuhan user soal trend/reference dari sosmed, tapi aman karena curated dan face-matched.",
    message: "Use these references as direction, not exact copies. Choose the cleaner, softer version.",
    big: "Reference direction: clean Korean texture, modern textured crop, soft taper, natural fringe, smart casual finish.",
    modules: ["Best match", "Good inspiration", "Use caution", "Do not copy", "Barber angle", "Photo pose"],
    imageSlots: ["6 reference cards", "Fit labels", "Trend tags"],
    variant: "board",
  },
  {
    no: "15",
    title: "Final Action Plan",
    label: "Next step",
    purpose: "Tutup dengan checklist. User nggak cuma impressed, tapi tahu harus ngapain besok.",
    message: "Save the barber card, pick one reference, ask for low taper, use matte product, and schedule cleanup in 3–4 weeks.",
    big: "Your next cut: textured crop, low taper, broken top texture, natural matte styling.",
    modules: ["Show barber", "Pick reference", "Ask for", "Avoid", "Buy product", "Book cleanup"],
    imageSlots: ["Final look", "Checklist card"],
    variant: "final",
  },
];

const heroMetrics = ["15-page premium report", "20+ visual slots", "Barber-ready brief", "Trend-aware references"];
const sampleModules = ["Face Shape", "Hair Type", "Best Cut", "Avoid Styles", "Barber Card", "Routine", "Maintenance", "References"];
---

<BaseLayout title={title} description={description}>
  <section class="hc-shell">
    <div class="hc-phone">
      <header class="hc-nav">
        <div class="hc-logo"><span>✦</span> HairCard</div>
        <a href="#report-pages">Pages</a>
      </header>

      <div class="hc-hero-grid">
        <div class="hc-copy">
          <p class="eyebrow">AI Hair Report</p>
          <h1>Find your HairCard cut.</h1>
          <p class="lead">Get a personalized haircut report from your selfie — face-shape analysis, AI hairstyle previews, barber instructions, and curated social references.</p>
          <div class="hero-metrics">
            {heroMetrics.map((metric) => <span>{metric}</span>)}
          </div>
        </div>

        <div class="premium-preview" aria-label="Premium report preview">
          <div class="preview-paper">
            <div class="paper-top">
              <span>HAIRCARD REPORT</span>
              <strong>05 / 15</strong>
            </div>
            <div class="paper-title-row">
              <div>
                <p>Best Fit</p>
                <h2>Primary Haircut Recommendation</h2>
              </div>
              <div class="fit-score"><span>92</span><small>fit score</small></div>
            </div>
            <div class="paper-layout">
              <div class="main-portrait"><span>AI hairstyle preview</span></div>
              <div class="analysis-stack">
                <div><span>Recommended cut</span><strong>Textured crop + low taper</strong></div>
                <div><span>Why it works</span><p>Sharpens the frame, controls side width, keeps top movement natural.</p></div>
                <div><span>Barber note</span><p>Top 5–7 cm · broken texture · low taper · matte finish.</p></div>
              </div>
            </div>
            <div class="dense-grid">
              {sampleModules.map((item) => <div><span>{item}</span><strong>Included</strong></div>)}
            </div>
            <div class="mini-board">
              <div></div><div></div><div></div><div></div><div></div><div></div>
            </div>
          </div>
        </div>
      </div>

      <div class="hc-cta-row">
        <button type="button">Get my HairCard <span>→</span></button>
        <p>Private by default. Photos are used to generate your report and can be deleted after delivery.</p>
      </div>
    </div>
  </section>

  <section class="brief-card">
    <p class="eyebrow">Design direction</p>
    <h2>Lebih dekat ke FaceCard: landing simple, report preview-nya yang padat.</h2>
      <p>
      Versi ini sengaja dibuat lebih comprehensive dan premium: halaman report kelihatan seperti real deliverable, bukan cuma wireframe. Copy report tetap English; catatan fungsi tetap Indonesia supaya gampang review produk.
    </p>
    <a class="review-cta" href="#report-pages">Review 15 report pages <span>↓</span></a>
  </section>

  <section id="report-pages" class="report-gallery">
    {reportPages.map((page) => (
      <article class={`report-card variant-${page.variant}`}>
        <div class="report-sheet">
          <div class="sheet-header">
            <div><span>HAIRCARD</span><small>{page.label}</small></div>
            <strong>{page.no} / 15</strong>
          </div>

          <div class="sheet-title">
            <p>{page.label}</p>
            <h2>{page.title}</h2>
          </div>

          <div class="sheet-body">
            <div class="visual-zone">
              <div class="visual-main"><span>{page.imageSlots[0]}</span></div>
              <div class="visual-strip">
                {page.imageSlots.slice(1, 5).map((slot) => <div><span>{slot}</span></div>)}
              </div>
            </div>

            <div class="insight-zone">
              <div class="verdict">
                <span>Stylist verdict</span>
                <strong>{page.big}</strong>
              </div>
              <div class="module-grid">
                {page.modules.map((module, index) => (
                  <div>
                    <small>{String(index + 1).padStart(2, "0")}</small>
                    <strong>{module}</strong>
                    <span>{index % 2 === 0 ? "personalized" : "barber-ready"}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="sheet-footer">
            <p>{page.message}</p>
            <span>Premium hair report · English copy draft</span>
          </div>
        </div>

        <aside class="page-notes">
          <div>
            <p class="eyebrow">Page {page.no}</p>
            <h3>{page.title}</h3>
          </div>
          <p><strong>Fungsi:</strong> {page.purpose}</p>
          <p><strong>Yang disampaikan ke user:</strong> {page.message}</p>
          <div>
            <strong>Visual slot:</strong>
            <ul>
              {page.imageSlots.map((slot) => <li>{slot}</li>)}
            </ul>
          </div>
        </aside>
      </article>
    ))}
  </section>

  <section class="brief-card final-note">
    <p class="eyebrow">Next iteration</p>
    <h2>Kalau direction ini oke, next step-nya bukan nambah copy — tapi masukin real visual.</h2>
    <p>
      Gue akan generate sample visual untuk 8–12 slot kunci: cover portrait, current vs recommended, 3 best haircut previews, 3 avoid styles, side/front guide, dan social reference board. Baru setelah itu kita judge apakah perceived value-nya sudah FaceCard-level.
    </p>
  </section>
</BaseLayout>

<style>
  :global(main) { max-width: 1180px; }

  .hc-shell {
    min-height: 860px;
    display: grid;
    place-items: center;
    padding: 20px 0 10px;
    background:
      radial-gradient(circle at 9% 16%, rgba(216, 153, 86, 0.25), transparent 18%),
      radial-gradient(circle at 93% 8%, rgba(116, 75, 42, 0.18), transparent 18%),
      #f5eee2;
    border: 1px solid rgba(40, 28, 19, 0.12);
    border-radius: 42px;
  }

  .hc-phone {
    width: min(100%, 520px);
    min-height: 790px;
    border: 2px solid #1f1710;
    border-radius: 42px;
    background: #fff8ec;
    box-shadow: 14px 16px 0 #1f1710;
    padding: 24px;
    position: relative;
    overflow: hidden;
  }

  .hc-phone::before,
  .hc-phone::after {
    content: "✦";
    position: absolute;
    color: #c87934;
    font-size: 38px;
    opacity: 0.85;
  }
  .hc-phone::before { left: 28px; top: 210px; transform: rotate(-14deg); }
  .hc-phone::after { right: 32px; top: 126px; transform: rotate(18deg); }

  .hc-nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; position: relative; z-index: 2; }
  .hc-logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 900; letter-spacing: -0.04em; color: #1f1710; }
  .hc-logo span { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 12px; background: #d08a43; border: 2px solid #1f1710; }
  .hc-nav a { border: 1.5px solid #1f1710; border-radius: 999px; padding: 8px 14px; color: #1f1710; font-size: 13px; font-weight: 800; text-decoration: none; background: rgba(255,255,255,0.55); }

  .hc-hero-grid { display: grid; gap: 24px; margin-top: 44px; position: relative; z-index: 1; }
  .eyebrow { color: #a05e22; text-transform: uppercase; font-size: 11px; letter-spacing: 0.18em; font-weight: 900; }
  .hc-copy h1 { margin: 8px 0 14px; font-size: clamp(52px, 12vw, 78px); line-height: 0.84; letter-spacing: -0.085em; color: #1f1710; text-wrap: balance; }
  .lead { max-width: 410px; color: #4f4034; font-weight: 700; line-height: 1.55; }
  .hero-metrics { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .hero-metrics span { border: 1px solid rgba(31, 23, 16, 0.18); background: #fff; border-radius: 999px; padding: 8px 10px; font-size: 11px; font-weight: 900; color: #2c2118; }

  .premium-preview { perspective: 1200px; }
  .preview-paper {
    background: #fffdf8;
    border: 2px solid #1f1710;
    border-radius: 24px;
    padding: 16px;
    box-shadow: 8px 10px 0 rgba(31, 23, 16, 0.9);
    transform: rotate(-1.5deg);
  }
  .paper-top, .sheet-header { display: flex; justify-content: space-between; align-items: start; gap: 18px; border-bottom: 1px solid rgba(31, 23, 16, 0.13); padding-bottom: 10px; }
  .paper-top span, .sheet-header span { font-size: 10px; font-weight: 900; letter-spacing: 0.18em; color: #a05e22; }
  .paper-top strong, .sheet-header strong { font-size: 12px; color: #1f1710; }
  .paper-title-row { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; margin: 16px 0; }
  .paper-title-row p, .sheet-title p { margin: 0 0 5px; color: #a05e22; font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.14em; }
  .paper-title-row h2, .sheet-title h2 { margin: 0; font-size: 27px; line-height: 0.95; letter-spacing: -0.06em; color: #1f1710; }
  .fit-score { display: grid; place-items: center; width: 76px; height: 76px; border: 2px solid #1f1710; border-radius: 50%; background: #f3c981; }
  .fit-score span { font-size: 30px; font-weight: 900; line-height: 1; }
  .fit-score small { font-size: 9px; font-weight: 900; text-transform: uppercase; }
  .paper-layout { display: grid; grid-template-columns: 1fr 0.9fr; gap: 12px; }
  .main-portrait, .visual-main, .visual-strip div, .mini-board div {
    background:
      linear-gradient(140deg, rgba(31,23,16,0.10), rgba(208,138,67,0.14)),
      repeating-linear-gradient(135deg, rgba(31,23,16,0.14) 0 7px, rgba(255,255,255,0.3) 7px 14px);
    border: 1px solid rgba(31,23,16,0.18);
    border-radius: 18px;
    display: grid;
    place-items: center;
    min-height: 210px;
    text-align: center;
    color: rgba(31,23,16,0.56);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .analysis-stack { display: grid; gap: 9px; }
  .analysis-stack div, .dense-grid div { border: 1px solid rgba(31,23,16,0.13); border-radius: 14px; padding: 10px; background: #fff6e6; }
  .analysis-stack span, .dense-grid span { display: block; color: #a05e22; font-size: 9px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 4px; }
  .analysis-stack strong { font-size: 13px; line-height: 1.1; color: #1f1710; }
  .analysis-stack p { margin: 0; font-size: 10px; line-height: 1.35; color: #4f4034; font-weight: 700; }
  .dense-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; margin-top: 12px; }
  .dense-grid strong { font-size: 10px; }
  .mini-board { display: grid; grid-template-columns: repeat(6, 1fr); gap: 7px; margin-top: 12px; }
  .mini-board div { min-height: 54px; border-radius: 14px; }
  .hc-cta-row { margin-top: 26px; display: grid; gap: 12px; position: relative; z-index: 2; }
  .hc-cta-row button { border: 2px solid #1f1710; border-radius: 999px; background: #1f1710; color: #fff8ec; padding: 16px 20px; font-weight: 900; font-size: 16px; box-shadow: 0 4px 0 #000; cursor: pointer; }
  .hc-cta-row p { margin: 0; text-align: center; font-size: 12px; color: #67564a; font-weight: 700; }

  .brief-card { border: 1px solid rgba(31, 23, 16, 0.12); border-radius: 34px; background: #fffaf1; padding: 28px; box-shadow: 0 18px 50px rgba(31, 23, 16, 0.06); }
  .brief-card h2 { margin: 8px 0 12px; color: #1f1710; font-size: clamp(30px, 5vw, 52px); line-height: 0.95; letter-spacing: -0.065em; max-width: 820px; }
  .brief-card p:not(.eyebrow) { margin: 0; color: #5b4a3b; font-size: 17px; line-height: 1.75; font-weight: 700; max-width: 850px; }
  .review-cta { display: inline-flex; align-items: center; gap: 10px; margin-top: 22px; border: 2px solid #1f1710; border-radius: 999px; background: #1f1710; color: #fff8ec; padding: 14px 18px; font-weight: 900; text-decoration: none; box-shadow: 0 4px 0 #000; }

  .report-gallery { display: grid; gap: 34px; }
  .report-card { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr); gap: 22px; align-items: stretch; padding: 18px; border: 1px solid rgba(31,23,16,0.12); border-radius: 34px; background: linear-gradient(145deg, #f7efe2, #fffaf1); box-shadow: 0 24px 70px rgba(31, 23, 16, 0.08); }
  .report-sheet { border: 2px solid #23170f; border-radius: 28px; background: #fffdf8; padding: 22px; box-shadow: 9px 11px 0 rgba(31,23,16,0.9); min-height: 620px; display: grid; grid-template-rows: auto auto 1fr auto; gap: 18px; position: relative; overflow: hidden; }
  .report-sheet::before { content: ""; position: absolute; inset: auto -70px -90px auto; width: 240px; height: 240px; border-radius: 50%; background: rgba(208, 138, 67, 0.14); pointer-events: none; }
  .sheet-header small { display: block; margin-top: 3px; color: #6c5847; font-size: 10px; font-weight: 800; text-transform: uppercase; }
  .sheet-title h2 { max-width: 620px; font-size: clamp(34px, 4.2vw, 58px); }
  .sheet-body { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: 18px; position: relative; z-index: 1; }
  .visual-zone { display: grid; gap: 12px; align-content: start; }
  .visual-main { min-height: 320px; }
  .visual-strip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
  .visual-strip div { min-height: 88px; border-radius: 15px; padding: 8px; }
  .insight-zone { display: grid; gap: 14px; align-content: start; }
  .verdict { border: 1px solid rgba(31,23,16,0.14); border-radius: 22px; background: #281b12; color: #fff7e9; padding: 18px; }
  .verdict span { display: block; color: #f1c581; text-transform: uppercase; letter-spacing: 0.14em; font-size: 10px; font-weight: 900; margin-bottom: 8px; }
  .verdict strong { display: block; font-size: 18px; line-height: 1.35; }
  .module-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .module-grid div { min-height: 92px; border: 1px solid rgba(31,23,16,0.12); border-radius: 18px; background: #fff4df; padding: 12px; }
  .module-grid small { display: block; color: #b06828; font-weight: 900; margin-bottom: 7px; }
  .module-grid strong { display: block; color: #1f1710; font-size: 15px; line-height: 1.12; }
