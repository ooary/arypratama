---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "HairCard Report Mockup";
const description = "Premium 15-page HairCard report mockup: English report copy, visual slots, barber-ready instructions, and social reference board.";

const pages = [
  {
    no: "01",
    title: "HairCard Personal Report",
    kicker: "Identity Snapshot",
    purpose: "Membuat user langsung merasa report ini personalized, bukan template generik.",
    message: "Report ini dibuat khusus dari face shape, hair type, dan grooming goal user.",
    visuals: ["Hero portrait", "Style direction badge"],
    layout: "cover",
  },
  {
    no: "02",
    title: "Executive Summary",
    kicker: "If you only read one page",
    purpose: "Kasih jawaban cepat: haircut terbaik, opsi backup, avoid list, dan maintenance level.",
    message: "User langsung tahu harus minta potongan apa ke barber.",
    visuals: ["Current look", "Recommended direction"],
    layout: "summary",
  },
  {
    no: "03",
    title: "Face Shape & Proportion",
    kicker: "Why this haircut fits",
    purpose: "Membuat rekomendasi terasa punya alasan, bukan random dari AI.",
    message: "Haircut harus balance struktur wajah, bukan sekadar ikut trend.",
    visuals: ["Face outline", "Proportion markers"],
    layout: "diagnostic",
  },
  {
    no: "04",
    title: "Hair Type & Growth Pattern",
    kicker: "Work with your natural hair",
    purpose: "Menjelaskan batasan rambut asli: density, texture, volume, growth pattern.",
    message: "Style terbaik adalah yang bisa jalan dengan rambut user sehari-hari.",
    visuals: ["Texture card", "Volume behavior diagram"],
    layout: "hairtype",
  },
  {
    no: "05",
    title: "Best Haircut Recommendation",
    kicker: "Primary cut",
    purpose: "Halaman core product: user melihat gaya utama yang direkomendasikan.",
    message: "Ini potongan yang paling aman dan paling cocok untuk dicoba dulu.",
    visuals: ["Front preview", "Side preview", "Detail preview"],
    layout: "recommendation",
  },
  {
    no: "06",
    title: "Alternative 1: Safe Upgrade",
    kicker: "Low-risk option",
    purpose: "Memberi opsi buat user yang belum siap perubahan besar.",
    message: "Upgrade grooming tanpa terlihat terlalu styled atau terlalu trend-driven.",
    visuals: ["Safe haircut preview"],
    layout: "altSafe",
  },
  {
    no: "07",
    title: "Alternative 2: Trend-Aware Option",
    kicker: "Modern but controlled",
    purpose: "Memasukkan social trend value tanpa asal ikut TikTok/Pinterest.",
    message: "User bisa ikut trend, tapi versi yang cocok dengan wajahnya.",
    visuals: ["Trend preview", "Reference direction"],
    layout: "altTrend",
  },
  {
    no: "08",
    title: "Styles to Avoid",
    kicker: "Not every popular cut works",
    purpose: "Bikin report terasa jujur dan useful; bukan semua style dibilang cocok.",
    message: "User tahu gaya mana yang harus dihindari dan alternatif yang lebih aman.",
    visuals: ["Avoid card 1", "Avoid card 2", "Avoid card 3"],
    layout: "avoid",
  },
  {
    no: "09",
    title: "Barber Instruction Card",
    kicker: "Show this page to your barber",
    purpose: "Salah satu value terbesar: halaman screenshot-ready untuk ditunjukkan ke barber.",
    message: "User tidak perlu bingung menjelaskan fade, length, texture, dan finish.",
    visuals: ["Instruction card"],
    layout: "barber",
  },
  {
    no: "10",
    title: "Front View Guide",
    kicker: "Shape from the front",
    purpose: "Menjelaskan silhouette dari depan: fringe, volume, side compactness.",
    message: "Dari depan, haircut harus membuka dan membentuk wajah, bukan menutupnya.",
    visuals: ["Good front shape", "Bad front shape"],
    layout: "frontGuide",
  },
  {
    no: "11",
    title: "Side Profile Guide",
    kicker: "Keep the side clean",
    purpose: "Menjelaskan taper height, temple area, back shape, dan neckline.",
    message: "Side profile harus clean dan compact, bukan bulky atau disconnected.",
    visuals: ["Side profile preview", "Taper arrows"],
    layout: "sideGuide",
  },
  {
    no: "12",
    title: "Styling Routine",
    kicker: "Make it look like the preview",
    purpose: "Mengurangi gap antara hasil potong dan hasil styling sehari-hari.",
    message: "User tahu produk apa yang dipakai dan cara styling tanpa overdo.",
    visuals: ["Product icons", "Step cards"],
    layout: "routine",
  },
  {
    no: "13",
    title: "Maintenance Plan",
    kicker: "How this cut grows out",
    purpose: "Memberi lifecycle: kapan rambut mulai bulky dan kapan perlu cleanup.",
    message: "User punya jadwal realistis supaya haircut tetap rapi.",
    visuals: ["Week timeline", "Maintenance meter"],
    layout: "maintenance",
  },
  {
    no: "14",
    title: "Social Reference Board",
    kicker: "Trend-aware inspiration",
    purpose: "Menghubungkan report ke referensi sosmed/current style tanpa klaim trend palsu.",
    message: "Gunakan referensi sebagai direction, bukan exact copy.",
    visuals: ["6 reference cards", "Fit labels"],
    layout: "reference",
  },
  {
    no: "15",
    title: "Final Action Plan",
    kicker: "What to do next",
    purpose: "Menutup report dengan checklist yang bisa langsung dieksekusi.",
    message: "User tahu next step: haircut, referensi, produk, dan jadwal maintenance.",
    visuals: ["Final look", "Checklist"],
    layout: "action",
  },
];

const copyBlocks = {
  cover: [
    "Prepared for: Sample Client",
    "Style Direction: Clean, structured, modern",
    "Best Fit: Textured crop with soft taper",
    "Report Date: June 2026",
  ],
  summary: [
    "Your best direction is a textured crop with a low taper.",
    "This works because your face benefits from controlled sides and natural top texture.",
    "Avoid heavy side volume, blunt fringe, and overly shiny styling.",
  ],
  diagnostic: [
    "Your face reads as oval-leaning with mild width around the cheek area.",
    "The goal is to keep the sides compact and add controlled texture on top.",
  ],
  hairtype: [
    "Visible hair type: medium density, straight to slightly wavy.",
    "Best product direction: matte clay, texture powder, or sea salt spray.",
    "Risk: the front section may fall flat without light shaping.",
  ],
  recommendation: [
    "Recommended Cut: Textured Crop with Low Taper",
    "Top: 5–7 cm, broken texture, point cut",
    "Sides: low taper, not a high skin fade",
    "Finish: matte and natural, no wet shine",
  ],
  altSafe: [
    "Safe Upgrade: Natural Side Part with Soft Taper",
    "Best for: work, campus, interviews, and first grooming upgrade.",
    "This improves structure without making the haircut feel too styled.",
  ],
  altTrend: [
    "Trend-Aware Option: Soft Two-Block Inspired Texture",
    "Use the cleaner version of the trend, not the extreme version.",
    "Keep the sides lighter and the fringe less heavy.",
  ],
  avoid: [
    "Avoid: Heavy middle part — adds width around the temples.",
    "Avoid: Blunt mushroom fringe — closes the face too much.",
    "Avoid: High disconnected undercut — creates harsh contrast.",
  ],
  barber: [
    "I want a textured crop with a low taper.",
    "Keep the top around 5–7 cm with natural texture.",
    "Do not make the fringe too blunt. Avoid a high skin fade.",
    "Finish matte and natural, not shiny or slick.",
  ],
  frontGuide: [
    "From the front, keep the shape slightly vertical and textured.",
    "Avoid a wide, heavy fringe that makes the face look shorter.",
  ],
  sideGuide: [
    "The side profile should stay compact around the temple.",
    "Taper gradually near the ear and keep the back natural.",
  ],
  routine: [
    "Towel dry, then blow dry forward and slightly upward.",
    "Apply a small amount of matte clay from back to front.",
    "Break the fringe with your fingers. Do not comb it too flat.",
  ],
  maintenance: [
    "Week 1: sharpest shape.",
    "Week 2–3: still clean and easy to style.",
    "Week 4: side bulk starts to show.",
    "Week 5+: book a reshape or taper cleanup.",
  ],
  reference: [
    "Use these references as direction, not exact copies.",
    "Your best version is cleaner on the sides, softer on the fringe, and more natural in texture.",
  ],
  action: [
    "Save the barber instruction card.",
    "Pick one primary reference image from this report.",
    "Ask for low taper, not high fade.",
    "Use matte clay or texture powder.",
    "Book cleanup in 3–4 weeks.",
  ],
};
---

<BaseLayout title={title} description={description}>
  <section class="space-y-6">
    <div class="inline-flex items-center rounded-full border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-bold text-amber-800 dark:border-amber-900/70 dark:bg-amber-950/40 dark:text-amber-200">
      Premium Report Mockup
    </div>
    <div class="space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">HairCard Report Mockup</h1>
      <p class="max-w-3xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">
        A visual-first draft for the 15-page HairCard PDF. The report copy is intentionally in English to keep the tone premium, direct, and less AI-slop. The notes under each page explain the function in Indonesian.
      </p>
    </div>
    <div class="grid gap-3 sm:grid-cols-3">
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Core value</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">Personalized visual haircut direction</div>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Action value</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">Barber-ready instruction card</div>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Trend layer</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">Curated social reference board</div>
      </div>
    </div>
  </section>

  <section class="space-y-8">
    {pages.map((page) => (
      <article class="overflow-hidden rounded-[2rem] border border-zinc-200 bg-zinc-100 shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
        <div class="grid gap-0 lg:grid-cols-[1.05fr_0.95fr]">
          <div class={`report-page report-${page.layout}`}>
            <div class="report-topbar">
              <span>HAIRCARD</span>
              <span>{page.no}/15</span>
            </div>

            {page.layout === "cover" && (
              <div class="cover-layout">
                <div class="portrait-frame hero-portrait">
                  <span>AI portrait slot</span>
                </div>
                <div>
                  <p class="report-kicker">{page.kicker}</p>
                  <h2>{page.title}</h2>
                  <div class="copy-list">
                    {copyBlocks[page.layout].map((copy) => <p>{copy}</p>)}
                  </div>
                </div>
              </div>
            )}

            {page.layout !== "cover" && (
              <div class="standard-layout">
                <div>
                  <p class="report-kicker">{page.kicker}</p>
                  <h2>{page.title}</h2>
                  <div class="copy-list">
                    {copyBlocks[page.layout].map((copy) => <p>{copy}</p>)}
                  </div>
                </div>

                {page.layout === "summary" && (
                  <div class="visual-grid two">
                    <div class="portrait-frame"><span>Current</span></div>
                    <div class="portrait-frame accent"><span>Recommended</span></div>
                  </div>
                )}

                {page.layout === "diagnostic" && (
                  <div class="diagram-card face-map">
                    <div class="face-oval"></div>
                    <span class="marker marker-a">forehead</span>
                    <span class="marker marker-b">cheek width</span>
                    <span class="marker marker-c">jaw balance</span>
                  </div>
                )}

                {page.layout === "hairtype" && (
                  <div class="metric-grid">
                    <div><span>Density</span><strong>Medium</strong></div>
                    <div><span>Texture</span><strong>Straight / slight wave</strong></div>
                    <div><span>Volume</span><strong>Medium front lift</strong></div>
                  </div>
                )}

                {page.layout === "recommendation" && (
                  <div class="visual-grid three">
                    <div class="portrait-frame"><span>Front</span></div>
                    <div class="portrait-frame accent"><span>Side</span></div>
                    <div class="portrait-frame"><span>Detail</span></div>
                  </div>
                )}

                {page.layout === "altSafe" && (
                  <div class="single-preview"><div class="portrait-frame accent"><span>Safe upgrade preview</span></div></div>
                )}

                {page.layout === "altTrend" && (
                  <div class="visual-grid two">
                    <div class="portrait-frame accent"><span>Trend fit</span></div>
                    <div class="reference-mini"><span>Popular reference direction</span></div>
                  </div>
                )}

                {page.layout === "avoid" && (
                  <div class="avoid-grid">
                    {['Heavy middle part', 'Blunt fringe', 'High disconnect'].map((item) => (
                      <div class="avoid-card"><span>Avoid</span><strong>{item}</strong></div>
                    ))}
                  </div>
                )}

                {page.layout === "barber" && (
                  <div class="barber-card">
                    <span>SHOW THIS TO YOUR BARBER</span>
                    <strong>Textured crop with low taper</strong>
                    <p>Top 5–7 cm · Broken texture · Low taper · Matte finish</p>
                  </div>
                )}

                {page.layout === "frontGuide" && (
                  <div class="compare-grid">
                    <div class="shape-card good">Good<br />vertical texture</div>
                    <div class="shape-card bad">Avoid<br />heavy width</div>
                  </div>
                )}

                {page.layout === "sideGuide" && (
                  <div class="side-diagram"><span>low taper point</span><span>compact temple</span><span>natural neckline</span></div>
                )}

                {page.layout === "routine" && (
                  <div class="steps-grid">
                    {['Towel dry', 'Blow dry', 'Matte clay', 'Finger texture'].map((step, index) => (
                      <div><span>0{index + 1}</span><strong>{step}</strong></div>
                    ))}
                  </div>
                )}

                {page.layout === "maintenance" && (
                  <div class="timeline">
                    {['W1', 'W2–3', 'W4', 'W5+'].map((week) => <span>{week}</span>)}
                  </div>
                )}

                {page.layout === "reference" && (
                  <div class="reference-board">
                    {['Best match', 'Good inspiration', 'Use with caution', 'Clean texture', 'Soft taper', 'Natural fringe'].map((label) => (
                      <div><span>{label}</span></div>
                    ))}
                  </div>
                )}

                {page.layout === "action" && (
                  <div class="action-layout">
                    <div class="portrait-frame accent"><span>Final look</span></div>
                    <div class="check-card">✓ Barber card<br />✓ Main reference<br />✓ Matte product<br />✓ Cleanup in 3–4 weeks</div>
                  </div>
                )}
              </div>
            )}
          </div>

          <div class="space-y-5 bg-white p-6 dark:bg-zinc-900">
            <div>
              <div class="text-xs font-bold uppercase tracking-[0.2em] text-amber-600 dark:text-amber-300">Page {page.no}</div>
              <h3 class="mt-2 text-2xl font-bold text-zinc-950 dark:text-white">{page.title}</h3>
            </div>
            <div class="space-y-4 text-sm leading-7 text-zinc-600 dark:text-zinc-300">
              <div>
                <strong class="text-zinc-950 dark:text-white">Fungsi:</strong> {page.purpose}
              </div>
              <div>
                <strong class="text-zinc-950 dark:text-white">Yang disampaikan ke user:</strong> {page.message}
              </div>
              <div>
                <strong class="text-zinc-950 dark:text-white">Visual slot:</strong>
                <ul class="mt-2 list-disc space-y-1 pl-5">
                  {page.visuals.map((visual) => <li>{visual}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">Design note</h2>
    <div class="mt-4 space-y-3 text-sm leading-7 text-zinc-600 dark:text-zinc-300">
      <p>
        Mockup ini sengaja masih pakai placeholder visual. Next step yang masuk akal: generate 8–12 sample hairstyle visuals dulu, lalu masukkan ke page 1, 2, 5, 6, 7, 8, 10, 11, 14, dan 15. Jangan langsung 40–60 visual sebelum layout dan promise-nya enak.
      </p>
      <p>
        Tone report harus tetap direct: stylist/grooming consultant, bukan motivational AI. Report harus terasa bisa dibawa ke barber, bukan cuma dibaca sekali lalu dilupakan.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .report-page {
    min-height: 720px;
    background:
      radial-gradient(circle at top left, rgba(245, 158, 11, 0.18), transparent 34%),
      linear-gradient(145deg, #16110d 0%, #27211b 46%, #f2eadf 46.2%, #f8f3ec 100%);
    color: #1f1710;
    padding: 28px;
    position: relative;
  }

  .report-topbar {
    display: flex;
    justify-content: space-between;
    color: rgba(255,255,255,0.85);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 38px;
  }

  .report-kicker {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b7791f;
    margin-bottom: 10px;
  }

  .report-page h2 {
    font-size: clamp(30px, 5vw, 54px);
    line-height: 0.95;
    max-width: 520px;
    font-weight: 900;
    letter-spacing: -0.06em;
    color: #22170f;
  }

  .cover-layout,
  .standard-layout {
    display: grid;
    gap: 28px;
  }

  .cover-layout {
    grid-template-columns: 0.9fr 1.1fr;
    align-items: end;
    min-height: 590px;
  }

  .copy-list {
    display: grid;
    gap: 10px;
    margin-top: 24px;
    max-width: 520px;
  }

  .copy-list p {
    background: rgba(255,255,255,0.7);
    border: 1px solid rgba(120, 88, 55, 0.18);
    border-radius: 18px;
    padding: 12px 14px;
    font-size: 13px;
    line-height: 1.55;
    font-weight: 700;
  }

  .portrait-frame,
  .reference-mini,
  .single-preview,
  .diagram-card {
    border: 1px solid rgba(120, 88, 55, 0.2);
    border-radius: 28px;
    background:
      linear-gradient(160deg, rgba(255,255,255,0.34), rgba(255,255,255,0.05)),
      repeating-linear-gradient(135deg, rgba(35, 26, 17, 0.12) 0 8px, rgba(255,255,255,0.14) 8px 16px);
    min-height: 210px;
    display: grid;
    place-items: center;
    color: rgba(35, 26, 17, 0.62);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 11px;
    font-weight: 900;
    overflow: hidden;
  }

  .hero-portrait { min-height: 480px; background-color: rgba(255,255,255,0.15); color: rgba(255,255,255,0.86); }
  .accent { background-color: rgba(180, 117, 46, 0.18); }

  .visual-grid { display: grid; gap: 16px; }
  .visual-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .visual-grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .face-map { position: relative; min-height: 330px; background: rgba(255,255,255,0.42); }
  .face-oval { width: 140px; height: 210px; border: 3px solid rgba(39, 31, 23, 0.5); border-radius: 48% 48% 44% 44%; }
  .marker { position: absolute; background: #24180f; color: #fff; border-radius: 999px; padding: 7px 10px; font-size: 10px; font-weight: 900; text-transform: uppercase; }
  .marker-a { top: 74px; left: 58px; } .marker-b { top: 170px; right: 56px; } .marker-c { bottom: 70px; left: 80px; }

  .metric-grid,
  .steps-grid,
  .avoid-grid,
  .reference-board,
  .compare-grid,
  .action-layout {
    display: grid;
    gap: 14px;
  }

  .metric-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .metric-grid div,
  .steps-grid div,
  .avoid-card,
  .shape-card,
  .check-card {
    border-radius: 22px;
    background: rgba(255,255,255,0.74);
    border: 1px solid rgba(120, 88, 55, 0.18);
    padding: 18px;
    min-height: 120px;
  }
  .metric-grid span, .steps-grid span, .avoid-card span { display: block; color: #9a651d; font-size: 11px; font-weight: 900; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 10px; }
  .metric-grid strong, .steps-grid strong, .avoid-card strong { display: block; color: #23170f; font-size: 18px; line-height: 1.15; }

  .avoid-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .barber-card { border-radius: 30px; background: #23170f; color: #fff; padding: 28px; min-height: 280px; display: grid; align-content: center; gap: 18px; }
  .barber-card span { color: #f5c16d; font-size: 11px; font-weight: 900; letter-spacing: 0.2em; }
  .barber-card strong { font-size: 34px; line-height: 1; }
  .barber-card p { color: rgba(255,255,255,0.72); }

  .compare-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .shape-card.good { border-color: rgba(22, 163, 74, 0.35); }
  .shape-card.bad { border-color: rgba(220, 38, 38, 0.35); }

  .side-diagram { border-radius: 28px; min-height: 280px; padding: 22px; display: flex; justify-content: space-around; align-items: center; background: rgba(255,255,255,0.58); }
  .side-diagram span { border-radius: 999px; background: #23170f; color: #fff; padding: 8px 12px; font-size: 10px; font-weight: 900; text-transform: uppercase; }

  .steps-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .timeline { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; align-items: center; min-height: 230px; }
  .timeline span { display: grid; place-items: center; height: 80px; border-radius: 999px; background: #23170f; color: #f5c16d; font-weight: 900; }
  .reference-board { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .reference-board div { min-height: 145px; border-radius: 24px; display: grid; align-items: end; padding: 14px; background: linear-gradient(160deg, rgba(35, 23, 15, 0.72), rgba(188, 126, 50, 0.22)), repeating-linear-gradient(135deg, rgba(255,255,255,0.2) 0 8px, transparent 8px 16px); color: #fff; }
  .reference-board span { font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; }
  .action-layout { grid-template-columns: 0.9fr 1.1fr; align-items: stretch; }
  .check-card { font-size: 18px; line-height: 2; font-weight: 900; }

  @media (max-width: 720px) {
    .report-page { min-height: auto; padding: 20px; }
    .cover-layout, .visual-grid.two, .visual-grid.three, .metric-grid, .avoid-grid, .steps-grid, .reference-board, .compare-grid, .action-layout { grid-template-columns: 1fr; }
    .hero-portrait { min-height: 260px; }
    .report-page h2 { font-size: 34px; }
  }
</style>
