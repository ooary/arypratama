---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "HairCard Report Reference";
const description = "Reference page for the HairCard MVP report: final sample PDF, page-by-page prompt contract, and quiz input decisions for building the app.";

const reportPdf = "/references/haircard/haircard-report-v3-reference.pdf";
const coverImage = "/references/haircard/cover-reference.png";

const mvpDecision = {
  keep: [
    "Front selfie as the required visual input.",
    "Gender / style preference, because copy tone and hairstyle category depend on it.",
    "Current hair problem, because the report has to solve a felt pain, not only describe face shape.",
    "Current length + texture/density self-report, because the photo may not reveal true hair behavior.",
    "Maintenance tolerance, because a good recommendation is useless if the user will not style it.",
    "Lifestyle/context, because the final report includes work, LinkedIn, weekend, and social fit.",
  ],
  add: [
    "Upcoming occasion: haircut for daily life, work profile photo, date, wedding/event, graduation, or just refresh.",
    "Hair growth / problem area: sides puff out, front falls flat, cowlick, thin-looking top, thick/unmanageable, forehead concern.",
    "Hard no styles: too short, exposed forehead, high fade, middle part, bangs/fringe, color, must keep length, etc.",
    "Barber/salon risk level: safe cleanup vs noticeable change. This controls how bold the recommendation page should be.",
  ],
  cut: [
    "Detailed product ownership questions at onboarding. Put products in report output, not quiz input.",
    "Too many face-shape questions. Let the model infer this from the photo, then ask only if the photo is weak.",
    "Side-profile upload for MVP. Useful later, but it adds friction. Keep it optional/post-payment if needed.",
    "Long personality/style quizzes. Use 1 vibe question instead of 5 aesthetic questions.",
  ],
};

const requiredInputs = [
  ["selfie_front", "Required", "Primary image for face proportion, visible hairline, volume, forehead, jaw/cheek balance, current cut."],
  ["gender_style_lane", "Required", "Narrows hairstyle universe and report language: men/women/androgynous/unsure."],
  ["current_problem", "Required", "Anchors recommendation to the user pain: flat, puffy, messy, too young, too old, hard to style, etc."],
  ["current_length", "Required", "Prevents impossible recommendations and drives barber length instructions."],
  ["hair_texture", "Required", "Model can guess from photo, but self-report reduces bad advice for wavy/curly/thin/thick hair."],
  ["maintenance_level", "Required", "Controls routine, product, and whether to suggest high-effort styling."],
  ["desired_outcome", "Required", "Cleaner, mature, professional, attractive, trendy, low maintenance, sharper photos."],
  ["lifestyle_context", "Required", "Feeds outfit/activity fit, LinkedIn/work/weekend copy, and action plan."],
  ["risk_level", "Add", "Safe cleanup vs noticeable change. This is important for conversion trust."],
  ["hard_no_styles", "Add", "Avoids recommending a technically good cut the user would reject emotionally."],
  ["occasion", "Add", "Makes output feel timely and changes emphasis: photo-ready vs everyday vs event."],
  ["side_profile", "Later", "Useful for taper/back/side profile guide, but optional for MVP to reduce upload friction."],
];

const pageContract = [
  {
    no: "Cover",
    title: "Personalized report cover",
    purpose: "Make the PDF feel premium and personal immediately.",
    inputs: ["selfie_front", "name", "age optional", "lifestyle_context", "desired_outcome"],
    promptNeeds: "Use the uploaded photo only as source identity. No beauty score. Summarize direction in a confident editorial tone.",
  },
  {
    no: "01",
    title: "Baseline Input",
    purpose: "Show the original uploaded photo so the user trusts what the report is based on.",
    inputs: ["selfie_front", "photo_quality_check"],
    promptNeeds: "Do not invent a result image here. Mention photo limitations if lighting/angle is weak.",
  },
  {
    no: "02",
    title: "Executive Summary",
    purpose: "Fast answer: best direction, score, key warnings, and why.",
    inputs: ["all core quiz answers", "selfie analysis"],
    promptNeeds: "Produce concise verdict, fit score rationale, best cut, backup cut, and avoid headline.",
  },
  {
    no: "03",
    title: "Face Shape & Proportion",
    purpose: "Explain why the haircut fits the face, not just trend matching.",
    inputs: ["selfie_front"],
    promptNeeds: "Infer face shape cautiously; describe forehead, cheek, jaw, face length, side-width risk.",
  },
  {
    no: "04",
    title: "Hair Type & Behavior",
    purpose: "Separate photo-based face analysis from practical hair behavior.",
    inputs: ["selfie_front", "hair_texture", "current_length", "current_problem"],
    promptNeeds: "Combine visible cues with self-report; avoid overclaiming density if photo is inconclusive.",
  },
  {
    no: "05",
    title: "Primary Haircut Recommendation",
    purpose: "Main paid value: exact haircut direction and why it works.",
    inputs: ["selfie analysis", "risk_level", "hard_no_styles", "maintenance_level"],
    promptNeeds: "Give top length, side treatment, fringe/front, neckline/back, finish, and fit rationale.",
  },
  {
    no: "06",
    title: "Safe Upgrade Option",
    purpose: "Reduce anxiety for users who want improvement without a dramatic change.",
    inputs: ["risk_level", "current_length", "desired_outcome"],
    promptNeeds: "Generate conservative alternative with lower barber risk and clear tradeoff vs primary cut.",
  },
  {
    no: "07",
    title: "Outfit & Activity Fit",
    purpose: "Connect haircut to real-life use cases: work, LinkedIn, social, weekend.",
    inputs: ["lifestyle_context", "occasion", "desired_outcome"],
    promptNeeds: "Recommend how the hair reads across settings; avoid fashion advice that ignores the haircut.",
  },
  {
    no: "08",
    title: "Styles to Avoid",
    purpose: "Build trust by saying no to bad-fit popular styles.",
    inputs: ["selfie analysis", "hair_texture", "hard_no_styles", "current_problem"],
    promptNeeds: "List avoid styles with concrete reasons: adds width, flattens front, too harsh, too high maintenance.",
  },
  {
    no: "09",
    title: "Barber Instruction Card",
    purpose: "Screenshot-ready page the user can show to barber/salon.",
    inputs: ["primary recommendation", "safe option", "hard_no_styles"],
    promptNeeds: "Write exact barber script, do/don't list, length numbers, finish, and reference note.",
  },
  {
    no: "10",
    title: "Front View Shape Guide",
    purpose: "Clarify front silhouette and fringe/side width execution.",
    inputs: ["selfie_front", "primary recommendation"],
    promptNeeds: "Describe good vs bad front shape; use image-generation prompt only if result image is needed.",
  },
  {
    no: "11",
    title: "Side Profile & Taper Guide",
    purpose: "Prevent fade/taper execution mistakes.",
    inputs: ["primary recommendation", "side_profile optional"],
    promptNeeds: "If no side profile exists, provide generic taper guidance and label uncertainty clearly.",
  },
  {
    no: "12",
    title: "Styling Routine & Products",
    purpose: "Make the haircut repeatable after the salon/barber visit.",
    inputs: ["hair_texture", "maintenance_level", "current_problem"],
    promptNeeds: "Give morning routine, product type, amount, technique, and what to avoid. No brand requirement in MVP.",
  },
  {
    no: "13",
    title: "Maintenance Timeline",
    purpose: "Tell user when the cut will look best and when to clean it up.",
    inputs: ["hair_texture", "growth/problem area", "primary recommendation"],
    promptNeeds: "Week-by-week plan with cleanup trigger; avoid pretending exact growth speed is known.",
  },
  {
    no: "14",
    title: "Reference Direction Board",
    purpose: "Curated inspiration so user can communicate style without copying random Pinterest/TikTok blindly.",
    inputs: ["primary recommendation", "hard_no_styles", "desired_outcome"],
    promptNeeds: "Generate reference keywords and rules. If using images, label them as direction, not exact copy.",
  },
  {
    no: "15",
    title: "Final Action Plan",
    purpose: "Close with concrete next actions.",
    inputs: ["all final recommendations"],
    promptNeeds: "Checklist: save barber card, pick reference, book cleanup, styling routine, avoid list.",
  },
];

const promptArchitecture = [
  "Use one multimodal analysis step to read the selfie and produce a normalized visual_analysis object.",
  "Merge visual_analysis with quiz answers into one report_context object.",
  "Generate each page from the same report_context, but with page-specific instructions and strict JSON schema.",
  "Validate every page: no medical diagnosis, no attractiveness scoring, no unsupported claims, no contradiction between pages.",
  "Render PDF only after the JSON passes schema and consistency checks.",
];
---

<BaseLayout title={title} description={description} image={coverImage}>
  <section class="rounded-[2rem] border border-amber-200 bg-[#fff7ea] p-6 shadow-sm md:p-10">
    <p class="text-xs font-bold uppercase tracking-[0.24em] text-amber-700">HairCard MVP Reference</p>
    <div class="mt-5 grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <h1 class="text-4xl font-black leading-none tracking-tight text-slate-950 md:text-6xl">Report ini jadi source of truth build app.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700">Final sample report dipakai sebagai acuan UX, input quiz, structured output schema, system prompt, dan PDF template. MVP jangan nambah pertanyaan asal banyak; pertanyaan harus punya efek langsung ke minimal satu halaman report.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white" href={reportPdf}>Open PDF reference</a>
          <a class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-900" href="#input-contract">Input contract</a>
          <a class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-900" href="#page-contract">Page contract</a>
        </div>
      </div>
      <a href={reportPdf} class="block overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl">
        <img src={coverImage} alt="HairCard final report cover reference" class="h-full w-full object-cover" />
      </a>
    </div>
  </section>

  <section class="grid gap-6 md:grid-cols-3">
    <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-6">
      <h2 class="text-xl font-black text-emerald-950">Keep</h2>
      <ul class="mt-4 space-y-3 text-sm leading-6 text-emerald-900">{mvpDecision.keep.map((item) => <li>• {item}</li>)}</ul>
    </div>
    <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6">
      <h2 class="text-xl font-black text-amber-950">Add</h2>
      <ul class="mt-4 space-y-3 text-sm leading-6 text-amber-900">{mvpDecision.add.map((item) => <li>• {item}</li>)}</ul>
    </div>
    <div class="rounded-3xl border border-red-200 bg-red-50 p-6">
      <h2 class="text-xl font-black text-red-950">Cut / Later</h2>
      <ul class="mt-4 space-y-3 text-sm leading-6 text-red-900">{mvpDecision.cut.map((item) => <li>• {item}</li>)}</ul>
    </div>
  </section>

  <section id="input-contract" class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm md:p-8">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-700">MVP quiz decision</p>
    <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950">Pertanyaan MVP: 8 required + 3 add, sisanya jangan dulu.</h2>
    <p class="mt-4 max-w-3xl leading-7 text-slate-700">Rule-nya simpel: kalau jawaban tidak mengubah rekomendasi, barber card, routine, avoid list, atau lifestyle fit, jangan ditanya di onboarding.</p>
    <div class="mt-6 grid gap-4">
      {requiredInputs.map(([key, status, note]) => (
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="font-mono text-sm font-bold text-slate-950">{key}</h3>
            <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-slate-700 ring-1 ring-slate-200">{status}</span>
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-700">{note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="rounded-[2rem] border border-slate-200 bg-slate-950 p-6 text-white shadow-sm md:p-8">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-300">Prompt architecture</p>
    <h2 class="mt-3 text-3xl font-black tracking-tight">Report beda page = beda prompt task, bukan satu prompt panjang liar.</h2>
    <ol class="mt-6 grid gap-4 md:grid-cols-2">
      {promptArchitecture.map((item, index) => (
        <li class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm leading-6 text-slate-200"><strong class="mr-2 text-amber-300">{index + 1}.</strong>{item}</li>
      ))}
    </ol>
  </section>

  <section id="page-contract" class="space-y-5">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-amber-700">Page-by-page contract</p>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950">Setiap halaman punya input dan prompt responsibility sendiri.</h2>
    </div>
    <div class="grid gap-5">
      {pageContract.map((page) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-amber-700">Page {page.no}</p>
              <h3 class="mt-2 text-2xl font-black tracking-tight text-slate-950">{page.title}</h3>
            </div>
            <div class="flex flex-wrap gap-2">{page.inputs.map((input) => <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-900 ring-1 ring-amber-200">{input}</span>)}</div>
          </div>
          <p class="mt-4 leading-7 text-slate-700"><strong>Purpose:</strong> {page.purpose}</p>
          <p class="mt-2 leading-7 text-slate-700"><strong>Prompt responsibility:</strong> {page.promptNeeds}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="rounded-[2rem] border border-slate-200 bg-[#fff7ea] p-6 md:p-8">
    <h2 class="text-3xl font-black tracking-tight text-slate-950">Kesimpulan UX MVP</h2>
    <p class="mt-4 max-w-3xl leading-8 text-slate-700">Tambahin 3 pertanyaan: occasion, risk level, hard-no styles. Kurangi pertanyaan yang sifatnya kosmetik/personality panjang. Side-profile jangan diwajibkan dulu. Yang paling penting: upload foto harus punya guidance dan quality check, karena kalau input foto jelek, system prompt sebagus apa pun bakal ngarang.</p>
  </section>
</BaseLayout>
