---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogArchiveList from "../components/BlogArchiveList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const allBlogPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

let allProjects: any[] = [];
try {
  allProjects = (await getCollection("projects")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
} catch {
  // No projects yet
}

const pageSize = 10;
const currentPage = 1;
const totalBlogPages = Math.max(1, Math.ceil(allBlogPosts.length / pageSize));
const posts = allBlogPosts.slice(0, pageSize);
const recentProjects = allProjects.slice(0, 3);
---

<BaseLayout>
  <!-- About Section -->
  <section id="about" class="relative">
    <div
      class="absolute inset-0 -z-10 bg-grid-dashed pointer-events-none -m-4 sm:-m-8 rounded-3xl"
    >
    </div>
    <div
      class="flex flex-col sm:flex-row items-center sm:items-start gap-8 sm:gap-12"
    >
      <div class="flex-shrink-0 group relative">
        <div
          class="w-32 h-32 sm:w-40 sm:h-40 rounded-2xl rotate-3 hover:rotate-0 transition-transform duration-300 bg-zinc-200 dark:bg-zinc-700 overflow-hidden border-4 border-white dark:border-zinc-800 shadow-xl flex items-center justify-center"
        >
          <img
            src="/img/avatar.png"
            alt="Profile Image"
            class="w-full h-full object-cover"
          />
        </div>
        <div
          class="absolute inset-0 rounded-2xl border-2 border-blue-500/30 -rotate-3 -z-10 scale-105"
        >
        </div>
      </div>
      <div class="text-center sm:text-left flex-1">
        <h1 class="text-3xl sm:text-4xl font-bold mb-2 tracking-tight">
          Ary Pratama
        </h1>
        <p class="text-lg text-blue-600 dark:text-blue-400 font-bold mb-6">
          Generalist Engineer
        </p>
        <div
          class="prose dark:prose-invert max-w-none text-zinc-600 dark:text-zinc-300 leading-relaxed text-base"
        >
          <h2 class="!text-2xl !text-zinc-900 dark:!text-white !mt-0">
            Hello, <span class="bg-yellow-200 dark:bg-yellow-900 p-1 rounded-md"
              >I'm Ary.</span
            >
          </h2>
          <p>
            I’m a backend-focused software engineer who likes building reliable
            systems, thinking through system design, and experimenting with AI
            when it solves a real problem. Most of what I enjoy lives on the
            backend: APIs, data flow, automation, and the kind of tooling that
            makes work less messy.
          </p>
          <p>
            My path with code hasn’t been perfectly linear. I was deep in it from
            2015 to 2018, stepped away for a while, then slowly found my way back
            starting in 2022. Since then I’ve been rebuilding the habit, learning
            in public, and putting together projects that feel honest to where I
            am now.
          </p>
          <h2 class="!text-xl">What I work with</h2>
          <ul class="list-disc pl-5 space-y-1">
            <li><strong>Main focus:</strong> backend engineering</li>
            <li>
              <strong>Usually working in:</strong> Python, FastAPI, JavaScript,
              HTML, and CSS
            </li>
            <li><strong>Data work:</strong> Pandas, Polars, and SQL</li>
            <li>
              <strong>Dashboards and reporting:</strong> Power BI, Looker Studio,
              and Tableau
            </li>
            <li>
              <strong>AI work:</strong> RAG pipelines and LLM features inside backend
              products
            </li>
            <li>
              <strong>Databases and infra:</strong> PostgreSQL, Redis, and workflow
              automation with n8n
            </li>
            <li>
              <strong>Frontend, when I have to:</strong> Vue and React
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- GitHub Activity -->
  <section class="github-contrib">
    <h2 class="text-xl font-bold flex items-center gap-2">
      <i class="ph ph-book-open text-blue-600"></i>
      Activity
    </h2>
    <div class="mt-4">
      <div class="flex justify-center">
        <img
          src="https://ghchart.rshah.org/ooary"
          alt="GitHub Contributions"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="relative py-4">
    <div class="absolute inset-0 flex items-center">
      <div class="w-full border-t border-zinc-200 dark:border-zinc-800"></div>
    </div>
    <div class="relative flex justify-center">
      <span
        class="bg-light-bg dark:bg-dark-900 px-3 text-zinc-400 dark:text-zinc-600"
      >
        <i class="ph-fill ph-star-four text-lg"></i>
      </span>
    </div>
  </div>

  <!-- Blogs Section -->
  <section id="blogs">
    <div class="flex items-center gap-4 mb-8">
      <div>
        <h2 class="text-xl font-bold flex items-center gap-2">
          <i class="ph ph-book-open text-blue-600"></i>
          Posts
        </h2>
        <p
          class="text-xs text-zinc-500 dark:text-zinc-400 mt-1 uppercase tracking-wide"
        >
          Archive
        </p>
      </div>
      <div class="h-px flex-grow bg-zinc-200 dark:bg-zinc-700"></div>
    </div>

    <BlogArchiveList posts={posts} />

    {totalBlogPages > 1 && (
      <nav class="mt-6 flex flex-wrap justify-center gap-2" aria-label="Posts pagination">
        {Array.from({ length: totalBlogPages }, (_, index) => index + 1).map((page) => (
          <a
            href={page === 1 ? "/" : `/page/${page}`}
            class:list={[
              "min-w-10 rounded-xl border px-3 py-2 text-center text-sm font-bold transition-colors",
              page === currentPage
                ? "border-blue-600 bg-blue-600 text-white"
                : "border-zinc-300 text-zinc-600 hover:border-blue-600 hover:text-blue-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-blue-400 dark:hover:text-blue-400",
            ]}
          >
            {page}
          </a>
        ))}
      </nav>
    )}
  </section>

  <!-- Divider -->
  <div class="relative py-4">
    <div class="absolute inset-0 flex items-center">
      <div class="w-full border-t border-gray-200 dark:border-gray-800"></div>
    </div>
    <div class="relative flex justify-center">
      <span
        class="bg-light-bg dark:bg-dark-900 px-3 text-gray-400 dark:text-gray-600"
      >
        <i class="ph-fill ph-star-four text-lg"></i>
      </span>
    </div>
  </div>

  <!-- Projects Section -->
  <section id="projects">
    <div class="flex justify-between items-end mb-8">
      <div>
        <h2 class="text-xl font-bold flex items-center gap-2">
          <i class="ph ph-code text-blue-600"></i>
          Projects
        </h2>
        <p
          class="text-xs text-zinc-500 dark:text-zinc-400 mt-1 uppercase tracking-wide"
        >
          Recent Work
        </p>
      </div>
      {
        recentProjects.length > 0 && (
          <a
            href="/projects"
            class="text-sm font-bold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 flex items-center gap-1 group"
          >
            View All
            <i class="ph ph-arrow-right group-hover:translate-x-1 transition-transform" />
          </a>
        )
      }
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        recentProjects.length > 0 ? (
          recentProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              date={project.data.date}
              slug={project.slug}
              description={project.data.description}
              image={project.data.image}
            />
          ))
        ) : (
          <p class="text-zinc-500 dark:text-zinc-400 col-span-3 text-center py-8 italic">
            Projects coming soon...
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
