---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

let allProjects: any[] = [];
try {
  allProjects = (await getCollection("projects")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
} catch {
  // No projects yet
}
---

<BaseLayout
  title="Projects | Ary Pratama"
  description="Projects by Ary Pratama — backend engineering, AI, and more."
  noindex
>
  <a
    href="/"
    class="mb-8 flex items-center gap-2 text-sm font-bold text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors uppercase tracking-wide"
  >
    <i class="ph ph-arrow-left"></i> Back to Home
  </a>

  <div class="flex items-baseline gap-4 mb-8">
    <h1 class="text-2xl font-bold">All Projects</h1>
    <div class="h-px flex-grow bg-zinc-200 dark:bg-zinc-700"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      allProjects.length > 0 ? (
        allProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            date={project.data.date}
            slug={project.slug}
            description={project.data.description}
            image={project.data.image}
          />
        ))
      ) : (
        <p class="text-zinc-500 dark:text-zinc-400 col-span-2 text-center py-12 italic">
          Projects coming soon...
        </p>
      )
    }
  </div>
</BaseLayout>
