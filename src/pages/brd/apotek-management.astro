---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "BRD — Core Managed Pharmacy";
const description = "Business Requirements Document for an inventory-first pharmacy management system covering master data, configuration, stock ledger, procurement, POS, reports, and dashboards.";

const principles = [
  "Inventory ledger first, POS second. POS is one source of stock movements, not the center of the domain.",
  "Stock must not live only in products.stock. It must be traceable by outlet, warehouse, batch, expiry date, and movement history.",
  "Unit conversion is a core business rule. Buying by box and selling by strip or tablet must be safe from day one.",
  "Every important stock, price, transaction, and configuration change must be auditable.",
  "The first release should work for a small pharmacy, but the data model must not lock the product into a single-outlet design.",
];

const modules = [
  "Organization, Outlet, Warehouse, and Pharmacy Profile",
  "Users, Roles, and Permissions",
  "Pharmacy Master Data",
  "Product Units, Pricing, and Conversion",
  "Inventory Batch Engine",
  "Append-Only Stock Movement Ledger",
  "Procurement: Defecta, Purchase Orders, and Goods Receipts",
  "Stock Control: Stock Take, Transfer, Returns, and Expiry Handling",
  "POS and Shift Management",
  "Customer Management and Sales Notes",
  "Reports: Sales, Stock, Purchase, Performance, and Finance Lite",
  "Role-Based Dashboards",
];

const kpis = [
  ["Stock accuracy", "Owner and staff can trust available stock by outlet, warehouse, product, and batch."],
  ["Expiry control", "Near-expiry and expired items are visible early enough for action."],
  ["Procurement discipline", "Purchase decisions are driven by low stock, fast-moving items, and supplier history."],
  ["Fast checkout", "Cashiers can complete common sales quickly while stock is posted correctly."],
  ["Auditability", "Every stock-impacting transaction can be traced back to a user, source document, and timestamp."],
];

const personas = [
  {
    name: "Pharmacy Owner",
    jobs: [
      "Monitor revenue, gross margin, critical stock, expired items, supplier payables, and cash variance.",
      "Control purchasing so the pharmacy avoids both overstock and stockouts for fast-moving products.",
      "Audit stock changes, price changes, returns, voided transactions, and sensitive operations.",
    ],
  },
  {
    name: "Pharmacist / Admin",
    jobs: [
      "Manage products, batches, expiry dates, product usage guidance, optional customers, and stock takes.",
      "Ensure outgoing stock follows the configured FEFO or expiry-first policy.",
      "Process returns, quarantine, and expired stock disposal actions.",
    ],
  },
  {
    name: "Cashier",
    jobs: [
      "Sell products quickly through barcode scan or product search with unit selection.",
      "Manage shifts: open shift, process sales, process sale returns, close shift, and record cash variance.",
      "Print receipts and simple sales notes when needed.",
    ],
  },
  {
    name: "Warehouse / Procurement Staff",
    jobs: [
      "Create defecta items and purchase orders.",
      "Receive goods with batch number, expiry date, purchase price, tax, discount, and destination warehouse.",
      "Track transfers between warehouses or outlets and process purchase returns.",
    ],
  },
];

const masterData = [
  {
    title: "Products",
    items: [
      "SKU, barcode, product name, generic name, composition, and indication",
      "Manufacturer, product category, product class, dosage form, and strength",
      "Minimum stock, default rack location, default supplier, active/inactive status",
      "Flags for special products, precursor items, narcotic/psychotropic items, or pharmacist review requirement",
    ],
  },
  {
    title: "Units and Conversion",
    items: [
      "Base unit per product, such as tablet, ml, gram, or pcs",
      "Different purchase and selling units",
      "Multi-level conversion, for example 1 box = 10 strips and 1 strip = 10 tablets",
      "All stock movements stored in base units for accuracy",
    ],
  },
  {
    title: "Pricing",
    items: [
      "Latest purchase price and batch-level cost of goods",
      "Multiple selling prices for retail, member, and wholesale contexts",
      "Optional target margin",
      "Mandatory selling-price change history",
    ],
  },
  {
    title: "Suppliers / PBF",
    items: [
      "Supplier name, legal name, address, contact, phone, email",
      "Default payment terms and due-date behavior",
      "Optional tax ID or license number",
      "Preferred supplier-product mapping and last purchase price",
    ],
  },
  {
    title: "Supporting Master Data",
    items: [
      "Manufacturers, product classes, product categories, rack locations, warehouses",
      "Customers, customer groups, and sales note templates",
      "Payment methods and document numbering series",
    ],
  },
];

const businessRules = [
  "Stock source of truth is stock_batches plus stock_movements, not a mutable product stock field.",
  "Posted stock movements are append-only. Corrections must use reversal or adjustment movements.",
  "All stock-affecting workflows must run inside a database transaction.",
  "Outgoing stock must choose a batch explicitly or automatically through FEFO / expiry-first policy.",
  "The system must prevent negative stock unless a controlled admin override is explicitly enabled and audited.",
  "Opening stock, purchase receipt, sale, sale return, purchase return, stock take adjustment, transfer, quarantine, and disposal all create movement rows.",
  "Batch expiry date, cost, source document, and user must be traceable from the stock card.",
  "Customer data is optional for normal retail sales. It exists for segmentation, member pricing, B2B accounts, notes, and reporting.",
  "Sales notes are optional operational notes attached to a sale. They are not a medical workflow.",
];

const workflows = [
  {
    title: "Opening Stock",
    steps: ["Create product and unit conversion", "Create initial stock batch", "Post opening_stock movement", "Verify stock card balance"],
  },
  {
    title: "Procurement",
    steps: ["Generate defecta item from low stock or manual request", "Convert approved item into purchase order", "Receive goods with batch and expiry", "Post purchase_receive movement"],
  },
  {
    title: "POS Sale",
    steps: ["Open cashier shift", "Scan or search product", "Choose selling unit", "Select customer if needed", "Take payment", "Post sale movement using FEFO", "Print receipt"],
  },
  {
    title: "Stock Take",
    steps: ["Freeze expected stock snapshot", "Input physical count", "Review difference", "Post adjustment movement", "Record reason and actor"],
  },
  {
    title: "Expiry Handling",
    steps: ["Detect near-expiry batches", "Move item to quarantine when required", "Post quarantine movement", "Post disposal movement and loss amount when destroyed"],
  },
  {
    title: "Shift Closing",
    steps: ["Cashier closes shift", "System calculates expected cash", "Cashier inputs actual cash", "Variance is recorded", "Owner/Admin reviews exceptions"],
  },
];

const reports = [
  "Sales by date, outlet, cashier, product, category, customer group, and payment method",
  "Stock on hand by outlet, warehouse, product, batch, and expiry date",
  "Critical stock, out-of-stock items, fast-moving items, slow-moving items, and dead stock",
  "Purchase history, supplier performance, outstanding supplier invoices, and purchase returns",
  "Gross margin, cash variance, expired-stock loss, and finance-lite summary",
  "Audit log for stock corrections, price changes, voids, returns, and configuration changes",
];

const buildOrder = [
  "Project foundation: backend, frontend, database, migrations, seed, tests, CI basics",
  "Organization, outlet, warehouse, user, role, permission, and pharmacy profile",
  "Master data: product references, products, units, conversion, prices, suppliers, customers",
  "Inventory ledger: stock batches, stock movements, posting service, stock card, FEFO allocation",
  "Opening stock and procurement: defecta, purchase order, goods receipt, supplier invoice",
  "Stock control: stock take, transfer, sale return, purchase return, expiry quarantine and disposal",
  "POS and shift: sale flow, payment, receipt, sales notes, shift open/close",
  "Reports, dashboards, audit trail, import/export, print polish, and end-to-end verification",
];
---

<BaseLayout title={title} description={description}>
  <section class="space-y-6">
    <div class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-bold text-blue-700 dark:border-blue-900/70 dark:bg-blue-950/40 dark:text-blue-300">
      Business Requirements Document
    </div>
    <div class="space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">
        Core Managed Pharmacy
      </h1>
      <p class="max-w-3xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">
        BRD for an inventory-first pharmacy management system. The product is designed around stock ledger, batch and expiry control, pharmacy master data, procurement, stock control, POS, reports, and role-based dashboards. This is not a thin cashier app; the core business domain is reliable pharmacy operations.
      </p>
    </div>
    <div class="grid gap-3 sm:grid-cols-3">
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Initial target</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">Small to mid-sized pharmacies</div>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Core thesis</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">Inventory-first pharmacy OS</div>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">URL</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">/brd/apotek-management</div>
      </div>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">1. Business Problem</h2>
    <div class="prose prose-zinc max-w-none dark:prose-invert">
      <p>
        Many small and mid-sized pharmacies still run stock, purchasing, expiry tracking, sales, and reports through a mix of cashier apps, spreadsheets, paper notes, and staff memory. A pharmacy is not ordinary retail. Products have batches, expiry dates, multi-level units, regulated item categories, supplier returns, disposal workflows, and higher audit expectations.
      </p>
      <p>
        The business needs one operational system where incoming goods are clear, stock is accurate, stock cards are auditable, expiry risk is controlled, cashier flow is fast, shifts are accountable, and owners can understand sales, stock, purchasing, and performance without rebuilding reports in spreadsheets.
      </p>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">2. Business Objectives</h2>
    <div class="grid gap-3 md:grid-cols-2">
      {kpis.map(([label, body]) => (
        <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="font-bold text-zinc-950 dark:text-white">{label}</div>
          <div class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-300">{body}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">3. Product Principles</h2>
    <div class="grid gap-3">
      {principles.map((item) => (
        <div class="rounded-2xl border border-zinc-200 bg-white p-4 text-zinc-700 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
          {item}
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">4. Core Scope</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      {modules.map((item, index) => (
        <div class="flex gap-3 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
            {index + 1}
          </div>
          <div class="font-semibold text-zinc-800 dark:text-zinc-100">{item}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">5. Personas and Jobs To Be Done</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {personas.map((persona) => (
        <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <h3 class="font-bold text-zinc-950 dark:text-white">{persona.name}</h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-zinc-700 dark:text-zinc-300">
            {persona.jobs.map((job) => <li>{job}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">6. Master Data Requirements</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {masterData.map((group) => (
        <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <h3 class="font-bold text-zinc-950 dark:text-white">{group.title}</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-zinc-700 dark:text-zinc-300">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">7. Operational Workflows</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {workflows.map((workflow) => (
        <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <h3 class="font-bold text-zinc-950 dark:text-white">{workflow.title}</h3>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm text-zinc-700 dark:text-zinc-300">
            {workflow.steps.map((step) => <li>{step}</li>)}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">8. Inventory and Ledger Business Rules</h2>
    <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
      <ul class="list-disc space-y-2 pl-5 text-sm text-zinc-700 dark:text-zinc-300">
        {businessRules.map((rule) => <li>{rule}</li>)}
      </ul>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">9. Reports and Dashboards</h2>
    <div class="grid gap-3 md:grid-cols-2">
      {reports.map((report) => (
        <div class="rounded-2xl border border-zinc-200 bg-white p-4 text-sm text-zinc-700 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
          {report}
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">10. Out of Scope for Core Release</h2>
    <div class="prose prose-zinc max-w-none dark:prose-invert">
      <ul>
        <li>Full accounting suite beyond finance-lite summary and supplier payable visibility.</li>
        <li>Advanced loyalty engine beyond customer groups and basic pricing segmentation.</li>
        <li>Marketplace integration, delivery integration, and online ordering.</li>
        <li>Multi-outlet consolidation beyond data-model readiness, unless explicitly prioritized later.</li>
        <li>Any medical-record or healthcare-provider workflow. This product stays in pharmacy operations.</li>
      </ul>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">11. Acceptance Criteria</h2>
    <div class="grid gap-3">
      <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h3 class="font-bold text-zinc-950 dark:text-white">Minimum end-to-end demo</h3>
        <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-300">
          A user can set up a product with units, post opening stock, receive goods with batch and expiry date, sell the item through POS, reduce stock through FEFO, close cashier shift, view stock card, and see the sale in reports.
        </p>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h3 class="font-bold text-zinc-950 dark:text-white">Data integrity</h3>
        <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-300">
          Stock balances must reconcile from stock movements and stock batches. Posted transactions cannot be silently edited. Corrections require traceable adjustment rows.
        </p>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h3 class="font-bold text-zinc-950 dark:text-white">Operational usability</h3>
        <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-300">
          Cashier, admin, warehouse, and owner users can complete their primary workflows without touching raw database records or spreadsheets.
        </p>
      </div>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">12. Suggested Build Order</h2>
    <div class="space-y-3">
      {buildOrder.map((item, index) => (
        <div class="flex gap-3 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-sm font-bold text-zinc-700 dark:bg-zinc-800 dark:text-zinc-200">
            {index + 1}
          </div>
          <div class="text-sm leading-6 text-zinc-700 dark:text-zinc-300">{item}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="rounded-3xl border border-blue-200 bg-blue-50 p-6 dark:border-blue-900/70 dark:bg-blue-950/30">
    <h2 class="text-xl font-bold text-blue-950 dark:text-blue-100">Linked artifacts</h2>
    <div class="mt-3 flex flex-wrap gap-3 text-sm font-semibold">
      <a class="rounded-full bg-white px-4 py-2 text-blue-700 shadow-sm dark:bg-zinc-900 dark:text-blue-300" href="/erd/apotek-management/">View ERD</a>
    </div>
  </section>
</BaseLayout>
