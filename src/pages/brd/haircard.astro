---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "BRD — HairCard";
const description = "Business Requirements Document for HairCard, an AI-powered personalized hairstyle report that turns a selfie and short quiz into a barber-ready 15-page PDF.";

const objectives = [
  "Validate whether users will pay for a personalized hairstyle report before a haircut or salon visit.",
  "Build a simple consumer funnel: landing page, short quiz, selfie upload, free teaser, paid PDF unlock.",
  "Position the product around practical haircut confidence, not beauty scoring.",
  "Collect early buyer feedback to improve the report template, pricing, and acquisition angle.",
];

const personas = [
  {
    name: "Men, 18–35",
    description: "Users who want to look cleaner, sharper, more mature, more attractive, or more professional but usually tell the barber to just trim it.",
    pains: ["Cannot explain the haircut they want", "Fear of a bad haircut", "Confused by fade, fringe, crop, middle part, comma hair, and similar trends"],
    outcomes: ["Know which haircut direction fits", "Get a clear barber brief", "Feel more confident for photos, work, dating, and daily life"],
  },
  {
    name: "Women, 18–35",
    description: "Users considering a new cut, layer, bangs, color, or face-framing direction but unsure whether the reference will fit their face and hair.",
    pains: ["Fear that a cut will make the face look wider or shorter", "Unsure whether bangs, layers, or color will work", "Pinterest references feel generic"],
    outcomes: ["Know which cut direction is safer", "Know what to avoid", "Bring a clearer brief to the salon"],
  },
];

const mvpScope = [
  "Landing page with sample report preview and privacy reassurance",
  "Single-question quiz flow with progress indicator",
  "Selfie upload with preview and clear/reupload action",
  "Free teaser result with one recommendation and one avoid note",
  "Paywall with name and email capture",
  "Payment checkout",
  "Background report generation so users do not wait on a long AI request",
  "AI-generated structured report content",
  "Premium 15-page PDF generated from an HTML template",
  "Result page and email delivery",
  "FAQ covering privacy, retention, free vs premium, report recovery, payment issues, and medical disclaimer",
  "Basic order and report status tracking",
];

const outOfScope = [
  "Native mobile app",
  "Real-time virtual try-on as the core MVP",
  "Barber or salon marketplace",
  "Salon booking",
  "Full user account dashboard",
  "Medical hair or scalp diagnosis",
  "Automated affiliate product marketplace",
];

const uxUserFlow = [
  {
    title: "Landing page",
    userIntent: "Understand the promise quickly and decide whether it is worth trying.",
    screen: "Hero, sample report preview, privacy line, FAQ link, and primary CTA: Find my haircut.",
    productPurpose: "Create trust and make the outcome concrete: a barber-ready hairstyle report, not a beauty score.",
  },
  {
    title: "Start quiz",
    userIntent: "Give lightweight context without feeling like a long form.",
    screen: "Single-question screens with progress indicator, back button, and auto-advance for simple choices.",
    productPurpose: "Build commitment while collecting enough preference data to make the report feel personal.",
  },
  {
    title: "Identity and current confidence",
    userIntent: "Tell the product what kind of styling direction is relevant.",
    screen: "Gender/style preference and current hair satisfaction scale from needs help to fully confident.",
    productPurpose: "Set tone, pronouns/style assumptions, and baseline confidence for the report summary.",
  },
  {
    title: "Hair problem diagnosis",
    userIntent: "Explain what feels wrong with the current hair.",
    screen: "Main hair problem, current hair length, and hair texture questions.",
    productPurpose: "Identify constraints such as flatness, puffiness, thin appearance, forehead balance, or styling difficulty.",
  },
  {
    title: "Preference and lifestyle fit",
    userIntent: "Make sure recommendations match daily effort and desired vibe.",
    screen: "Maintenance level, style direction, and desired improvement questions.",
    productPurpose: "Avoid recommending high-effort or off-vibe hairstyles that users will not actually maintain.",
  },
  {
    title: "Selfie upload",
    userIntent: "Provide the visual input needed for face-shape and proportion analysis.",
    screen: "Front selfie upload with preview, clear/reupload action, and clear photo guidance. Side profile is optional for later versions.",
    productPurpose: "Connect quiz context with visible cues: face shape, forehead balance, jawline, hair volume, and current cut.",
  },
  {
    title: "Free teaser result",
    userIntent: "See immediate value before paying.",
    screen: "Probable face shape, one best haircut direction, one avoid note, and blurred premium report preview.",
    productPurpose: "Prove personalization and create a natural reason to unlock the full report.",
  },
  {
    title: "Paywall and checkout",
    userIntent: "Decide whether the full 15-page report is worth buying.",
    screen: "Name/email form, premium report benefits, price, trust line, and payment CTA.",
    productPurpose: "Convert after the user has invested effort and seen a useful teaser.",
  },
  {
    title: "Report generation",
    userIntent: "Wait with confidence that the report is being prepared.",
    screen: "Result page with generation status, expected timing, support note, and recovery link behavior.",
    productPurpose: "Reduce anxiety after payment and prevent duplicate payments or support confusion.",
  },
  {
    title: "Report delivery and next action",
    userIntent: "Use the report before visiting a barber or salon.",
    screen: "Downloadable 15-page PDF, barber/salon brief, checklist, and email backup link.",
    productPurpose: "Make the output actionable and collect feedback on whether the user would show it to a barber/salon.",
  },
];

const reportPages = [
  ["HairCard Summary", "Overall direction, confidence score, and top recommendation."],
  ["Face Shape & Proportion", "Face shape, forehead, jaw, and cheekbone balance."],
  ["Hair Type & Texture Read", "Visible texture, density assumption, and volume behavior."],
  ["Best Haircut Direction", "Main style category and why it fits."],
  ["Top 3 Recommended Hairstyles", "Style name, fit rationale, and maintenance level."],
  ["Styles to Avoid", "Cuts and shapes that may hurt proportion or maintenance."],
  ["Barber / Salon Brief", "Exact instruction the user can show to a barber or salon."],
  ["Front View Guide", "Fringe, top volume, face-framing, and front silhouette."],
  ["Side Profile Guide", "Sideburn, taper, fade, layers, neckline, and ear area."],
  ["Daily Styling Routine", "3-minute, 5-minute, and event-mode styling."],
  ["Product Match", "Clay, pomade, cream, mousse, sea salt, gel, and heat protectant guidance."],
  ["Color Direction", "Natural tone, warm/cool direction, and highlight safety."],
  ["Occasion Looks", "Daily, work/interview, date, event, and photo modes."],
  ["Maintenance Plan", "Trim schedule, next appointment instruction, and growth plan."],
  ["Reference Board & Checklist", "Reference keywords, product list, and barber checklist."],
];

const functionalRequirements = [
  {
    title: "Landing page",
    items: ["Show product positioning clearly", "Start quiz from a primary CTA", "Show sample report preview", "Include privacy reassurance and FAQ"],
  },
  {
    title: "Quiz",
    items: ["Single question per screen", "Progress indicator", "Auto-advance for single choice", "Manual next for multi-choice", "Back button", "Session answer storage"],
  },
  {
    title: "Upload",
    items: ["Accept JPG, PNG, WEBP, and HEIC/HEIF if feasible", "Validate file size", "Show preview", "Allow reupload", "Require a clear front selfie"],
  },
  {
    title: "AI generation",
    items: ["Use quiz answers and selfie to produce structured JSON", "Ground output in visible cues and stated preferences", "Avoid body-shaming language", "Include non-medical disclaimer"],
  },
  {
    title: "PDF and delivery",
    items: ["Generate from HTML template", "Look premium and mobile-readable", "Include page numbers", "Provide result page and email download link"],
  },
];

const safetyRules = [
  "Do not diagnose medical hair or scalp conditions.",
  "Do not claim certainty about genetics, health, or ethnicity.",
  "Do not frame the product as an objective attractiveness score.",
  "Use language like based on the photo provided, likely, appears, and best direction.",
  "Focus on practical style direction and barber/salon communication.",
];

const faqItems = [
  ["Is my selfie safe?", "The selfie is used only to generate the HairCard teaser and paid hairstyle report. It should not be used for ads, resale, model training, or unrelated profiling."],
  ["How long do you keep my selfie and report?", "Default retention is up to 30 days so users can recover downloads. Users should be able to delete the selfie and generated report sooner from the result page or report email."],
  ["Is HairCard medical advice?", "No. HairCard does not diagnose hair loss, scalp conditions, alopecia, genetics, or health issues. It only gives visual styling direction based on the uploaded photo and quiz answers."],
  ["Is this an attractiveness score?", "No. The product should avoid objective beauty or attractiveness scoring. The output is haircut direction, styling guidance, and barber/salon communication."],
  ["What is free vs premium?", "Free gives a small teaser: likely face shape, one haircut direction, one avoid note, and a blurred report preview. Premium unlocks the full 15-page PDF."],
  ["What if the report email does not arrive?", "Users should check the result page first, then Spam/Promotions. Support can recover the order from Order ID and payment email."],
  ["What if payment succeeds but the report is not ready?", "The user should not pay again. The order status must be recoverable and a background job can retry or be manually reviewed."],
  ["Can I show this to a barber or salon?", "Yes. The barber/salon brief is the key paid deliverable and should be written in practical instruction language."],
];

const architectureFlow = [
  "Next.js app renders landing, quiz, upload, teaser, paywall, result, FAQ, and admin/support screens.",
  "Supabase Postgres stores sessions, quiz answers, customers, orders, payment status, generation jobs, report payloads, and feedback.",
  "Object storage stores selfies and generated PDFs with signed URLs and a 30-day lifecycle/deletion policy.",
  "Payment webhook marks the order as paid and enqueues a report generation job.",
  "Background worker analyzes the selfie and quiz answers with a vision LLM, validates structured JSON, renders the PDF, stores the result, and updates report status.",
  "Result page polls or subscribes to order/report status so the user sees progress instead of waiting on a blocking AI request.",
  "Email delivery sends the report link, Order ID, deletion link, and support instructions.",
];

const techStackOptions = [
  {
    area: "App framework",
    recommendation: "Next.js",
    rationale: "Best fit for multi-step funnel, server actions/API routes, payment webhooks, auth-less recovery links, and dynamic result pages. Astro remains fine for docs, not the paid app flow.",
  },
  {
    area: "Database",
    recommendation: "Supabase Postgres",
    rationale: "Fast MVP path with managed Postgres, migrations, Row Level Security options, dashboard inspection, and easy connection from Next.js.",
  },
  {
    area: "File storage",
    recommendation: "Cloudflare R2 for production; Supabase Storage acceptable for fastest MVP",
    rationale: "R2 has 10 GB free monthly storage, free egress, and cheap storage at about $0.015/GB-month. Supabase is simpler when already using Supabase but Pro includes 100 GB storage then about $0.021/GB and egress can matter. For privacy + cost, R2 is better long-term; for speed, Supabase Storage is fine in week 1.",
  },
  {
    area: "Payment",
    recommendation: "Xendit or Midtrans for Indonesia; Stripe if global-first",
    rationale: "HairCard likely starts with Indonesian buyers, so local payment methods matter more than Stripe elegance.",
  },
  {
    area: "Email",
    recommendation: "Resend",
    rationale: "Simple transactional emails for report ready, recovery link, deletion link, and support flow.",
  },
];

const aiOptions = [
  {
    model: "Gemini 2.5 Flash",
    fit: "Default MVP recommendation",
    notes: "Good affordable multimodal analysis for selfie + quiz to structured JSON. Public pricing observed: about $0.30/1M input tokens for text/image/video and $2.50/1M output tokens.",
  },
  {
    model: "Gemini 2.5 Flash-Lite",
    fit: "Lowest-cost fallback / validation pass",
    notes: "Cheaper at about $0.10/1M input tokens and $0.40/1M output tokens, but may need quality checks for nuanced hairstyle reasoning.",
  },
  {
    model: "OpenAI vision / GPT model",
    fit: "Higher-quality fallback or comparison set",
    notes: "Use for A/B quality testing if Gemini output feels generic. Keep provider abstraction so orders can be regenerated with a different model.",
  },
  {
    model: "GPT-Image-2 / Gemini image generation / Imagen",
    fit: "Later add-on, not MVP core",
    notes: "Useful for optional hairstyle mockup images, but risky for MVP because generated hair previews can disappoint. Written barber/salon-ready instructions should ship first.",
  },
  {
    model: "Seedance / video models",
    fit: "Not recommended for MVP",
    notes: "Video generation is not needed for a paid PDF report and would add unnecessary cost and latency.",
  },
];

const workerOptions = [
  {
    option: "Trigger.dev",
    take: "Best Next.js-native recommendation for MVP",
    notes: "Durable background tasks, retries, logs, concurrency, and serverless-friendly execution. Pricing observed includes a free tier with usage credits and paid plans starting around $10–$50/month depending on needs.",
  },
  {
    option: "Inngest",
    take: "Also strong for event-driven workflows",
    notes: "Good durable execution and step functions. Pricing observed includes 50k free executions/month and Pro around $75/month. Slightly heavier cost floor than Trigger.dev for this MVP.",
  },
  {
    option: "Supabase Edge Functions + cron/polling",
    take: "Okay for first hack, not ideal long-term",
    notes: "Works for simple jobs, but retries, observability, and long-running AI/PDF tasks get awkward fast.",
  },
  {
    option: "Celery/Huey with Python worker",
    take: "Fine if Python services are already deployed, but avoid for a pure Next.js MVP",
    notes: "Adds Redis, worker hosting, deploy complexity, and cross-language operational burden. Use later only if PDF/AI pipeline becomes Python-heavy.",
  },
];

const metrics = [
  "Landing to quiz-start rate",
  "Quiz-start to upload rate",
  "Upload to paywall-view rate",
  "Paywall to checkout-click rate",
  "Checkout to paid-conversion rate",
  "Payment to successful-report-generation rate",
  "Report usefulness rating",
  "Would you show this to your barber/salon?",
];

const risks = [
  ["Generic recommendations", "Use specific quiz answers, personalized avoid lists, and concrete barber/salon instructions."],
  ["Poor photo quality", "Give clear upload instructions and ask for reupload when the face is not visible."],
  ["Unrealistic hairstyle previews", "Keep virtual try-on out of the MVP core; use written instructions and references first."],
  ["Sensitive appearance feedback", "Use supportive language and avoid beauty-score framing."],
  ["Medical expectation", "Add clear disclaimers and avoid scalp or hair-loss diagnosis."],
];

const buildOrder = [
  "Landing page and sample report preview",
  "Quiz UI",
  "Upload and paywall",
  "Manual or semi-automated report generation for the first 10–20 orders",
  "Structured AI generation and PDF template automation",
  "Payment and result recovery",
  "Report quality improvements from buyer feedback",
];
---

<BaseLayout title={title} description={description}>
  <main class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">Business Requirements Document</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">HairCard</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-700">{description}</p>

    <section class="mt-10 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-950">Product Summary</h2>
      <p class="mt-4 leading-7 text-slate-700">
        HairCard is an AI personalized hairstyle report that helps users choose a better haircut from a selfie, a short preference quiz, and a practical target outcome. The paid product is a premium 15-page PDF with face-shape analysis, haircut direction, avoid list, barber or salon instructions, styling routine, product guidance, and maintenance plan.
      </p>
      <blockquote class="mt-5 border-l-4 border-slate-950 pl-4 text-lg font-semibold text-slate-950">
        Stop guessing your next haircut. Upload a selfie and get a barber-ready hairstyle report.
      </blockquote>
    </section>

    <section class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
        <h2 class="text-xl font-bold text-slate-950">Business Objectives</h2>
        <ul class="mt-4 space-y-3 text-slate-700">
          {objectives.map((item) => <li>• {item}</li>)}
        </ul>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
        <h2 class="text-xl font-bold text-slate-950">Core Value Proposition</h2>
        <p class="mt-4 leading-7 text-slate-700">
          HairCard gives users a practical haircut direction and an exact way to communicate it to a barber or salon. The product should feel useful enough to bring to an appointment, not just entertaining enough to share.
        </p>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-950">Target Users</h2>
      <div class="mt-5 grid gap-6 md:grid-cols-2">
        {personas.map((persona) => (
          <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-xl font-semibold text-slate-950">{persona.name}</h3>
            <p class="mt-3 text-slate-700">{persona.description}</p>
            <h4 class="mt-5 font-semibold text-slate-950">Pain points</h4>
            <ul class="mt-2 space-y-2 text-slate-700">{persona.pains.map((item) => <li>• {item}</li>)}</ul>
            <h4 class="mt-5 font-semibold text-slate-950">Desired outcomes</h4>
            <ul class="mt-2 space-y-2 text-slate-700">{persona.outcomes.map((item) => <li>• {item}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-950">MVP Scope</h2>
        <ul class="mt-4 space-y-2 text-slate-700">{mvpScope.map((item) => <li>• {item}</li>)}</ul>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-950">Out of Scope</h2>
        <ul class="mt-4 space-y-2 text-slate-700">{outOfScope.map((item) => <li>• {item}</li>)}</ul>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-950">MVP UX User Flow</h2>
      <p class="mt-3 max-w-3xl leading-7 text-slate-700">
        The MVP flow should feel like a lightweight guided consultation, not a questionnaire. Each step must either build trust, collect a useful styling constraint, or move the user closer to a barber-ready report.
      </p>
      <div class="mt-5 space-y-4">
        {uxUserFlow.map((step, index) => (
          <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-sm font-semibold text-slate-500">Step {index + 1}</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-950">{step.title}</h3>
            <div class="mt-3 grid gap-3 text-sm leading-6 text-slate-700 md:grid-cols-3">
              <p><span class="font-semibold text-slate-950">User intent:</span> {step.userIntent}</p>
              <p><span class="font-semibold text-slate-950">Screen:</span> {step.screen}</p>
              <p><span class="font-semibold text-slate-950">Product purpose:</span> {step.productPurpose}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-950">Free vs Paid Result</h2>
      <div class="mt-5 grid gap-6 md:grid-cols-2">
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-semibold text-slate-950">Free Teaser</h3>
          <ul class="mt-4 space-y-2 text-slate-700">
            <li>• Probable face shape</li>
            <li>• One recommended haircut direction</li>
            <li>• One thing to avoid</li>
            <li>• Blurred preview of the full report</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-semibold text-slate-950">Paid Report</h3>
          <ul class="mt-4 space-y-2 text-slate-700">
            <li>• Full 15-page PDF</li>
            <li>• Top 3 hairstyles</li>
            <li>• Avoid list</li>
            <li>• Barber / salon instruction card</li>
            <li>• Styling, product, and maintenance plan</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-950">15-Page Report Structure</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {reportPages.map(([pageTitle, body], index) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-semibold text-slate-500">Page {index + 1}</p>
            <h3 class="mt-1 font-semibold text-slate-950">{pageTitle}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-950">Functional Requirements</h2>
      <div class="mt-5 grid gap-6 md:grid-cols-2">
        {functionalRequirements.map((group) => (
          <article class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
            <h3 class="text-lg font-semibold text-slate-950">{group.title}</h3>
            <ul class="mt-3 space-y-2 text-slate-700">{group.items.map((item) => <li>• {item}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-950">Safety and Privacy</h2>
        <ul class="mt-4 space-y-2 text-slate-700">{safetyRules.map((item) => <li>• {item}</li>)}</ul>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-950">Pricing Hypothesis</h2>
        <p class="mt-4 leading-7 text-slate-700">
          Recommended MVP pricing: one paid product at Rp49.000, with a Rp29.000 launch discount for early users. Later tiers can add hairstyle mockups or a richer reference board at Rp79.000–99.000.
        </p>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-950">FAQ Requirements</h2>
      <p class="mt-3 max-w-3xl leading-7 text-slate-700">
        HairCard needs a FAQ from the MVP because users are uploading selfies, paying before the full artifact is ready, and receiving the report asynchronously. The FAQ should reduce privacy anxiety, payment confusion, and support tickets.
      </p>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {faqItems.map(([question, answer]) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-semibold text-slate-950">{question}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-950">MVP Architecture</h2>
      <div class="mt-5 rounded-3xl border border-slate-200 bg-slate-50 p-6">
        <ol class="list-decimal space-y-3 pl-5 text-slate-700">
          {architectureFlow.map((item) => <li>{item}</li>)}
        </ol>
      </div>
      <p class="mt-4 leading-7 text-slate-700">
        The result page must not block on AI generation. After payment, it should show a progress state while a background worker generates the report. The user can leave and return through a recovery link or email.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-950">Recommended Tech Stack</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {techStackOptions.map((item) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-semibold text-slate-500">{item.area}</p>
            <h3 class="mt-1 font-semibold text-slate-950">{item.recommendation}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{item.rationale}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-12 grid gap-6 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold text-slate-950">AI Provider Options</h2>
        <div class="mt-5 space-y-4">
          {aiOptions.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <p class="text-sm font-semibold text-slate-500">{item.fit}</p>
              <h3 class="mt-1 font-semibold text-slate-950">{item.model}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-700">{item.notes}</p>
            </article>
          ))}
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-slate-950">Background Worker Options</h2>
        <div class="mt-5 space-y-4">
          {workerOptions.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <p class="text-sm font-semibold text-slate-500">{item.take}</p>
              <h3 class="mt-1 font-semibold text-slate-950">{item.option}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-700">{item.notes}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
        <h2 class="text-2xl font-bold text-slate-950">Success Metrics</h2>
        <ul class="mt-4 space-y-2 text-slate-700">{metrics.map((item) => <li>• {item}</li>)}</ul>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
        <h2 class="text-2xl font-bold text-slate-950">Build Order</h2>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">{buildOrder.map((item) => <li>{item}</li>)}</ol>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-950">Risks and Mitigations</h2>
      <div class="mt-5 space-y-4">
        {risks.map(([risk, mitigation]) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-semibold text-slate-950">{risk}</h3>
            <p class="mt-2 text-slate-700">{mitigation}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-12 rounded-3xl border border-slate-950 bg-slate-950 p-6 text-white">
      <h2 class="text-2xl font-bold">Recommendation</h2>
      <p class="mt-4 leading-7 text-slate-200">
        Start with HairCard as the broad product name, but run the first campaign around the clearest use case: “Get a barber-ready haircut report from your selfie.” This keeps the product practical, reduces cringe, and makes the paid PDF feel immediately useful.
      </p>
    </section>
  </main>
</BaseLayout>
