        <div class="mt-7 space-y-5">
          <div class="placeholder-grid flex min-h-[260px] flex-col items-center justify-center rounded-3xl border-2 border-dashed border-blue-300 bg-blue-50 p-5 text-center">
            <div class="text-5xl">📊</div>
            <p class="mt-3 text-xl font-black">SCREENSHOT DASHBOARD UTAMA</p>
