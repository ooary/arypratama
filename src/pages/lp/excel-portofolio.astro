      <section class="border-y border-yellow-100 bg-yellow-50 px-6 py-9">
        <div class="rounded-full bg-red-600 px-4 py-2 text-center text-sm font-black uppercase tracking-wide text-white">Beli hari ini, dapet bonus ini</div>
