---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogArchiveList from "../../../components/BlogArchiveList.astro";
import { getCollection } from "astro:content";

const pageSize = 10;

export async function getStaticPaths() {
  const pageSize = 10;
  const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  const totalPages = Math.ceil(allPosts.length / pageSize);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: allPosts.slice((page - 1) * pageSize, page * pageSize),
        currentPage: page,
        totalPages,
      },
    };
  });
}

const { posts, currentPage, totalPages } = Astro.props;
---

<BaseLayout
  title={`Blog Page ${currentPage} | Ary Pratama`}
  description="Blog posts by Ary Pratama — thoughts on backend engineering, AI, and tech."
>
  <a
    href="/blog"
    class="mb-8 flex items-center gap-2 text-sm font-bold text-zinc-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors uppercase tracking-wide"
  >
    <i class="ph ph-arrow-left"></i> Back to Blog
  </a>

  <div class="rounded-3xl border border-zinc-300 dark:border-zinc-700 bg-white/70 dark:bg-dark-800/60 p-5 sm:p-8 shadow-sm">
    <header class="text-center space-y-4">
      <p class="text-xs uppercase tracking-[0.28em] text-blue-600 dark:text-blue-400 font-bold">
        Blog Archive
      </p>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-tight">
        All Blog Posts
      </h1>
    </header>

    <div class="my-8 border-t border-zinc-300 dark:border-zinc-700"></div>

    <section>
      <div class="flex items-center justify-between gap-4 mb-5">
        <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400">
          Archive
        </h2>
        <span class="text-xs text-zinc-500 dark:text-zinc-400">
          Page {currentPage} / {totalPages}
        </span>
      </div>

      <BlogArchiveList posts={posts} startIndex={(currentPage - 1) * pageSize} />
    </section>

    <div class="my-8 border-t border-zinc-300 dark:border-zinc-700"></div>

    <nav class="flex flex-wrap justify-center gap-2" aria-label="Blog pagination">
      {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
        <a
          href={page === 1 ? "/blog" : `/blog/page/${page}`}
          class:list={[
            "min-w-10 rounded-xl border px-3 py-2 text-center text-sm font-bold transition-colors",
            page === currentPage
              ? "border-blue-600 bg-blue-600 text-white"
              : "border-zinc-300 text-zinc-600 hover:border-blue-600 hover:text-blue-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-blue-400 dark:hover:text-blue-400",
          ]}
        >
          {page}
        </a>
      ))}
    </nav>
  </div>
</BaseLayout>
