---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "PRD — Apotek Management System MVP";
const description = "MVP product document for an inventory-ledger-first Apotek Management System with Excel onboarding, batch/expiry stock, simple POS, Vue + Capacitor frontend, and FastAPI backend.";

const phases = [
  ["Phase 0", "Fondasi", "Scaffold repo backend/frontend, PostgreSQL, migrations, auth, app shell, healthcheck."],
  ["Phase 1", "Katalog Produk", "Product CRUD, search by nama/SKU/barcode, minimum stock, pricing fields."],
  ["Phase 2", "Ledger Core", "StockBatch, append-only StockMovement, receive stock, adjustment, no-negative invariant."],
  ["Phase 3", "Import Excel", "Template, upload, dry-run preview, row errors, commit to product/batch/movement."],
  ["Phase 4", "POS Ringan", "Search/scan, cart, FEFO allocation, sale posting, payment simple, void reversal."],
  ["Phase 5", "Dashboard & Export", "Low stock, near-expiry, expired, inventory value, CSV/XLSX exports."],
  ["Phase 6", "Vue App", "Mobile-first screens for dashboard, products, stock, import, POS, reports."],
  ["Phase 7", "Android & Hardening", "Capacitor Android build, barcode scan, tests, deploy, backup basics."],
];

const endpoints = [
  ["Auth", "POST /auth/login", "Login email/password, returns access token + user."],
  ["Auth", "GET /auth/me", "Current authenticated user."],
  ["Products", "GET /products", "List products with search, pagination, and computed on-hand."],
  ["Products", "POST /products", "Create product master data; no stock mutation here."],
  ["Products", "PATCH /products/{id}", "Update non-stock product fields."],
  ["Stock", "POST /batches", "Receive stock: create batch if needed + movement IN."],
  ["Stock", "GET /products/{id}/stock", "Product on-hand summary by batch."],
  ["Ledger", "GET /movements", "Filterable append-only stock ledger."],
  ["Ledger", "POST /movements/adjust", "Create adjustment movement with required reason."],
  ["Import", "POST /imports?dry_run=true", "Validate Excel and return row-level preview/errors."],
  ["Import", "POST /imports", "Commit Excel import to products, batches, and movements."],
  ["Sales", "POST /sales", "Post sale, allocate FEFO, create OUT movements atomically."],
  ["Sales", "POST /sales/{id}/void", "Void sale via reversal movements, never delete ledger rows."],
  ["Dashboard", "GET /dashboard/summary", "Counts/value for low stock, near-expiry, sales today."],
  ["Export", "GET /exports/stock", "CSV/XLSX stock snapshot per product/batch."],
];

const entities = [
  ["User", "id, email, password_hash, name, role, is_active, created_at", "Creates sales, movements, batches, imports."],
  ["Product", "id, sku, name, category, unit, barcode, sell_price, reorder_level, is_active", "No products.stock. On-hand is computed from ledger."],
  ["StockBatch", "id, product_id, batch_no, expiry_date, cost_price, received_at, created_by", "Batch identity/metadata; quantity comes from movements."],
  ["StockMovement", "id, product_id, batch_id, type, qty, reason, ref_type, ref_id, created_by, created_at", "Append-only ledger. IN positive, OUT negative, ADJUST signed."],
  ["Sale", "id, code, subtotal, discount, total, paid, change, status, cashier_id, created_at", "Sale header; status paid or void."],
  ["SaleItem", "id, sale_id, product_id, qty, unit_price, subtotal", "One item can allocate across multiple batches via movements."],
  ["ImportJob", "id, filename, status, total_rows, success_rows, error_rows, error_report, created_by", "Tracks Excel validation and commit result."],
];
---

<BaseLayout title={title} description={description}>
  <article class="space-y-12">
    <section class="space-y-6">
      <div class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-bold text-emerald-700 dark:border-emerald-900/70 dark:bg-emerald-950/40 dark:text-emerald-300">
        MVP Product Document
      </div>
      <div class="space-y-4">
        <h1 class="text-4xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">
          Apotek Management System MVP
        </h1>
        <p class="max-w-4xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">
          Sistem manajemen apotek berbasis stock ledger: import Excel, batch/expiry tracking, dashboard stok, POS ringan, dan export operasional. Branding tetap Apotek Management System, tapi build plan-nya sengaja kecil supaya bisa ship.
        </p>
      </div>
      <div class="grid gap-3 md:grid-cols-4">
        <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Product wedge</div>
          <div class="mt-2 font-bold text-zinc-950 dark:text-white">Stok akurat + expired kelihatan</div>
        </div>
        <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Frontend</div>
          <div class="mt-2 font-bold text-zinc-950 dark:text-white">Vue + Capacitor</div>
        </div>
        <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Backend</div>
          <div class="mt-2 font-bold text-zinc-950 dark:text-white">FastAPI + PostgreSQL</div>
        </div>
        <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Mode</div>
          <div class="mt-2 font-bold text-zinc-950 dark:text-white">Online-first, Android + Web</div>
        </div>
      </div>
    </section>

    <section class="rounded-3xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
      <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">Table of contents</h2>
      <ol class="mt-4 grid gap-2 pl-5 text-sm leading-6 text-zinc-700 dark:text-zinc-300 md:grid-cols-2">
        <li><a href="#prd">PRD ringkas</a></li>
        <li><a href="#scope">Scope dan non-goals</a></li>
        <li><a href="#erd">ERD textual</a></li>
        <li><a href="#api">API contract</a></li>
        <li><a href="#design-system">Design system</a></li>
        <li><a href="#tech-stack">Tech stack</a></li>
        <li><a href="#folder-structure">Folder structure</a></li>
        <li><a href="#layering">Backend layering</a></li>
        <li><a href="#task-list">Implementation task list</a></li>
        <li><a href="#risks">Risks and open decisions</a></li>
      </ol>
    </section>

    <section id="prd" class="prose prose-zinc max-w-none dark:prose-invert">
      <h2>1. PRD ringkas</h2>
      <p><strong>Apotek Management System</strong> adalah aplikasi operasional untuk apotek kecil-menengah yang masih bergantung pada Excel, catatan manual, atau aplikasi kasir yang tidak kuat di stok. MVP ini tidak mencoba menjadi ERP lengkap. Fokusnya: membuat stok bisa dipercaya.</p>
      <p>Core thesis: <strong>inventory ledger first, POS as stock updater</strong>. POS penting karena tanpa transaksi harian yang mengurangi stok, dashboard akan cepat bohong. Tapi POS di MVP tetap tipis: cari/scan barang, qty, bayar, stok berkurang.</p>
      <h3>Goals</h3>
      <ul>
        <li>Stok dihitung dari pergerakan ledger, bukan angka manual yang bisa ditimpa.</li>
        <li>Apotek bisa melihat barang menipis, near-expiry, expired, dan nilai stok.</li>
        <li>Onboarding cepat lewat import Excel dengan preview dan error per baris.</li>
        <li>Penjualan ringan mengurangi stok otomatis dengan FEFO.</li>
        <li>Stock correction/opname bisa dilakukan tanpa merusak histori.</li>
      </ul>
      <h3>Success metrics</h3>
      <ul>
        <li>Import 1.000 baris Excel bisa divalidasi dan dikomit dengan laporan error yang jelas.</li>
        <li>Transaksi POS keranjang kecil selesai kurang dari 10 detik untuk user yang sudah terbiasa.</li>
        <li>Stock on-hand dari ledger sama dengan hasil opname setelah koreksi.</li>
        <li>Owner bisa melihat daftar low-stock dan near-expiry dalam satu layar dashboard.</li>
      </ul>
    </section>

    <section id="scope" class="grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-6 dark:border-emerald-900/70 dark:bg-emerald-950/30">
        <h2 class="text-2xl font-bold text-emerald-950 dark:text-emerald-100">MVP scope</h2>
        <ul class="mt-4 space-y-2 text-sm leading-6 text-emerald-950/80 dark:text-emerald-100/80">
          <li>Product master minimal: SKU, nama, barcode, unit, harga, minimum stock.</li>
          <li>Stock batch dengan batch number dan expiry date opsional.</li>
          <li>Append-only stock movements: IN, OUT, ADJUST.</li>
          <li>Excel import: template, dry-run preview, row-level errors, commit.</li>
          <li>Dashboard: low stock, near-expiry, expired, value, sales today.</li>
          <li>Simple POS: search/scan, cart, payment simple, FEFO deduction.</li>
          <li>Adjustment/opname ringan dengan reason wajib.</li>
          <li>CSV/XLSX export untuk stock, movement, sales.</li>
        </ul>
      </div>
      <div class="rounded-3xl border border-red-200 bg-red-50 p-6 dark:border-red-900/70 dark:bg-red-950/30">
        <h2 class="text-2xl font-bold text-red-950 dark:text-red-100">Non-goals</h2>
        <ul class="mt-4 space-y-2 text-sm leading-6 text-red-950/80 dark:text-red-100/80">
          <li>Multi-cabang, multi-tenant SaaS, billing, platform admin.</li>
          <li>Purchase order, supplier/PBF workflow, hutang/piutang.</li>
          <li>SIPNAP, SP regulated purchase, CDOB certification workflow.</li>
          <li>Offline sync, local sale queue, conflict resolution.</li>
          <li>Shift close, bon/hutang customer, loyalty, refund kompleks.</li>
          <li>RBAC granular, report builder, full accounting.</li>
          <li>Thermal printer and payment gateway integration.</li>
        </ul>
      </div>
    </section>

    <section id="erd" class="space-y-5">
      <div class="prose prose-zinc max-w-none dark:prose-invert">
        <h2>2. ERD textual</h2>
        <p>ERD sengaja kecil. Product tidak menyimpan <code>stock</code>. Source of truth adalah <code>stock_batches</code> dan <code>stock_movements</code>.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {entities.map(([name, fields, note]) => (
          <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <h3 class="text-lg font-bold text-zinc-950 dark:text-white">{name}</h3>
            <p class="mt-2 font-mono text-xs leading-6 text-zinc-600 dark:text-zinc-300">{fields}</p>
            <p class="mt-3 text-sm leading-6 text-zinc-500 dark:text-zinc-400">{note}</p>
          </div>
        ))}
      </div>
      <div class="rounded-3xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900/60">
        <h3 class="text-xl font-bold text-zinc-950 dark:text-white">Domain invariants</h3>
        <ul class="mt-4 space-y-2 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
          <li>Ledger append-only: tidak ada update/delete movement melalui app flow normal.</li>
          <li><code>on_hand(batch)</code> = SUM movement qty untuk batch tersebut.</li>
          <li><code>on_hand(product)</code> = SUM movement qty untuk product tersebut.</li>
          <li>OUT ditolak kalau stok tidak cukup; no negative stock di MVP.</li>
          <li>Void sale membuat movement reversal, bukan menghapus sale atau movement lama.</li>
          <li>FEFO memilih batch non-expired dengan expiry paling dekat, <code>NULLS LAST</code>.</li>
        </ul>
      </div>
    </section>

    <section id="api" class="space-y-5">
      <div class="prose prose-zinc max-w-none dark:prose-invert">
        <h2>3. API contract</h2>
        <p>REST/JSON, JWT auth, pagination dengan <code>page</code> dan <code>size</code>. Route harus tipis; business rule masuk service layer.</p>
      </div>
      <div class="overflow-hidden rounded-3xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900">
        <div class="grid grid-cols-12 border-b border-zinc-200 bg-zinc-50 px-4 py-3 text-xs font-bold uppercase tracking-wide text-zinc-500 dark:border-zinc-800 dark:bg-zinc-950/60">
          <div class="col-span-3">Group</div>
          <div class="col-span-4">Endpoint</div>
          <div class="col-span-5">Contract</div>
        </div>
        {endpoints.map(([group, endpoint, contract]) => (
          <div class="grid grid-cols-12 gap-3 border-b border-zinc-100 px-4 py-4 text-sm last:border-0 dark:border-zinc-800">
            <div class="col-span-3 font-bold text-zinc-950 dark:text-white">{group}</div>
            <div class="col-span-4 font-mono text-xs text-emerald-700 dark:text-emerald-300">{endpoint}</div>
            <div class="col-span-5 leading-6 text-zinc-600 dark:text-zinc-300">{contract}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="design-system" class="prose prose-zinc max-w-none dark:prose-invert">
      <h2>4. Design system</h2>
      <h3>UX principles</h3>
      <ul>
        <li><strong>Speed-first for cashier:</strong> POS punya search/scan besar, tombol qty jelas, checkout sticky.</li>
        <li><strong>Signal over decoration:</strong> low-stock, near-expiry, expired harus kelihatan tanpa baca tabel panjang.</li>
        <li><strong>Mobile-first, web-comfortable:</strong> satu codebase Vue untuk browser dan Android via Capacitor.</li>
        <li><strong>Operational copy:</strong> pakai bahasa “Stok masuk”, “Koreksi stok”, “Mau expired”, bukan istilah enterprise.</li>
      </ul>
      <h3>Navigation</h3>
      <ul>
        <li>Mobile bottom nav: Dashboard, POS, Produk, Stok, Lainnya.</li>
        <li>Desktop sidebar: Dashboard, POS, Produk, Stok, Import, Laporan.</li>
      </ul>
      <h3>Components</h3>
      <p>SearchBar, ProductCard, BatchTable, MovementTimeline, POSCart, NumberPad, StatCard, ImportWizard, ExportButton, ExpiryBadge, LowStockBadge, ConfirmDialog, EmptyState.</p>
      <h3>Tokens</h3>
      <ul>
        <li>Primary: emerald/teal pharmacy tone, approx <code>#0E9F8E</code>.</li>
        <li>Semantic: green success, amber warning, red danger, blue info.</li>
        <li>Spacing: 4, 8, 12, 16, 24, 32.</li>
        <li>Radius: 8 for controls, 12–16 for cards.</li>
        <li>Typography: Inter or system sans, scale 12/14/16/20/24/32.</li>
      </ul>
    </section>

    <section id="tech-stack" class="grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">5. Tech stack</h2>
        <dl class="mt-4 space-y-3 text-sm leading-6">
          <div><dt class="font-bold text-zinc-950 dark:text-white">Frontend</dt><dd class="text-zinc-600 dark:text-zinc-300">Vue 3, Vite, TypeScript, Tailwind, Pinia, Vue Router, TanStack Query/Vue Query.</dd></div>
          <div><dt class="font-bold text-zinc-950 dark:text-white">Mobile</dt><dd class="text-zinc-600 dark:text-zinc-300">Capacitor Android, barcode scanner plugin, online-first shell.</dd></div>
          <div><dt class="font-bold text-zinc-950 dark:text-white">Backend</dt><dd class="text-zinc-600 dark:text-zinc-300">FastAPI, Pydantic v2, SQLAlchemy 2, Alembic, PostgreSQL.</dd></div>
          <div><dt class="font-bold text-zinc-950 dark:text-white">Excel</dt><dd class="text-zinc-600 dark:text-zinc-300">openpyxl first; pandas only if validation grows complex.</dd></div>
          <div><dt class="font-bold text-zinc-950 dark:text-white">Infra</dt><dd class="text-zinc-600 dark:text-zinc-300">Docker Compose on VPS, Caddy/Traefik, CI lint/test/build.</dd></div>
        </dl>
      </div>
      <div id="folder-structure" class="rounded-3xl border border-zinc-200 bg-zinc-950 p-6 text-zinc-100 shadow-sm">
        <h2 class="text-2xl font-bold text-white">6. Folder structure</h2>
        <pre class="mt-4 overflow-x-auto text-xs leading-6 text-zinc-300"><code>{`backend/
  app/
    core/        config, security, db
    models/      SQLAlchemy ORM
    schemas/     Pydantic I/O contracts
    services/    ledger, FEFO, import, sales
    api/
      routes/    auth, products, stock, sales
      deps.py
    main.py
  alembic/
  tests/
  pyproject.toml

frontend/
  src/
    api/
    stores/
    router/
    components/
    views/
    composables/
    types/
    styles/
  capacitor.config.ts
  android/
  vite.config.ts`}</code></pre>
      </div>
    </section>

    <section id="layering" class="prose prose-zinc max-w-none dark:prose-invert">
      <h2>7. Backend layering convention</h2>
      <p>Alur wajib: <code>api/routes → service → model</code>. Route tidak boleh langsung query model untuk business operation.</p>
      <ul>
        <li><strong>models/</strong>: SQLAlchemy tables, relationships, constraints. Tidak ada business logic.</li>
        <li><strong>schemas/</strong>: Pydantic request/response, field validation, serialization. Pisahkan create/update/read.</li>
        <li><strong>services/</strong>: transaction boundary dan domain rules: <code>receive_stock()</code>, <code>allocate_fefo()</code>, <code>record_movement()</code>, <code>void_sale()</code>, <code>run_import()</code>.</li>
        <li><strong>api/routes/</strong>: controller tipis, auth deps, error mapping, response schema.</li>
      </ul>
      <p>Operasi stok selalu lewat service transaction supaya batch, movement, sale, dan payment konsisten. Hitung on-hand lewat aggregate query atau projection/cache setelah MVP; source of truth tetap ledger.</p>
    </section>

    <section id="task-list" class="space-y-5">
      <div class="prose prose-zinc max-w-none dark:prose-invert">
        <h2>8. Implementation task list</h2>
        <p>Urutan ini sengaja memaksa ledger core selesai sebelum import, POS, dan dashboard. Kalau ledger salah, semua fitur setelahnya cuma UI di atas data palsu.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {phases.map(([phase, name, desc]) => (
          <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <div class="text-xs font-bold uppercase tracking-wide text-emerald-600 dark:text-emerald-300">{phase}</div>
            <h3 class="mt-2 text-lg font-bold text-zinc-950 dark:text-white">{name}</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-300">{desc}</p>
          </div>
        ))}
      </div>
      <div class="rounded-3xl border border-blue-200 bg-blue-50 p-6 dark:border-blue-900/70 dark:bg-blue-950/30">
        <h3 class="text-xl font-bold text-blue-950 dark:text-blue-100">Kanban execution pattern</h3>
        <p class="mt-3 text-sm leading-6 text-blue-950/80 dark:text-blue-100/80">
          BIMA owns phase spec and acceptance criteria, MUTIA owns UX/mobile flow, RAKA implements backend/frontend slices, BASKARA reviews correctness and code quality, SATRIA reviews auth/security-sensitive flows, DION handles deploy and Android packaging. Run per wave, not all phases at once.
        </p>
      </div>
    </section>

    <section id="risks" class="prose prose-zinc max-w-none dark:prose-invert">
      <h2>9. Risks and open decisions</h2>
      <h3>Risks</h3>
      <ul>
        <li><strong>Data stok membusuk</strong> kalau POS tidak dipakai setiap transaksi. Mitigation: POS ringan tetap P0.</li>
        <li><strong>Excel berantakan</strong> bisa membuat onboarding gagal. Mitigation: template fixed, dry-run, error per baris.</li>
        <li><strong>Aggregate ledger lambat</strong> saat data besar. Mitigation: index dulu, projection/cache setelah MVP.</li>
        <li><strong>Concurrency batch</strong> saat dua transaksi rebut stok. Mitigation: row lock dalam sale posting transaction.</li>
      </ul>
      <h3>Default decisions</h3>
      <ul>
        <li>Payment MVP: cash, QRIS/manual, transfer/manual.</li>
        <li>Discount MVP: transaction-level only, optional.</li>
        <li>Near-expiry default: 30 hari, nanti configurable.</li>
        <li>Unit conversion: single base unit dulu; box/strip/tablet conversion masuk roadmap setelah pilot.</li>
        <li>Void: admin-only after sale, requires reason, creates reversal movement.</li>
      </ul>
    </section>
  </article>
</BaseLayout>
