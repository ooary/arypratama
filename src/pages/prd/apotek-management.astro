---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Moved — Core Managed Pharmacy BRD";
const description = "The Core Managed Pharmacy planning document has been converted from PRD to BRD and moved to /brd/apotek-management/.";
---

<BaseLayout title={title} description={description}>
  <section class="space-y-6">
    <div class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-bold text-blue-700 dark:border-blue-900/70 dark:bg-blue-950/40 dark:text-blue-300">
      Document moved
    </div>
    <div class="space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">
        Core Managed Pharmacy BRD
      </h1>
      <p class="max-w-3xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">
        This artifact has been converted from a Product Requirements Document into a Business Requirements Document. Use the BRD route as the source of truth going forward.
      </p>
      <a class="inline-flex rounded-full bg-blue-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-blue-700" href="/brd/apotek-management/">
        Open BRD
      </a>
    </div>
  </section>
</BaseLayout>
