---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "PRD — POS Apotek Lite";
const description = "Product Requirements Document for POS Apotek Lite: offline-first Android and web POS for pharmacy owners with sales, inventory ledger, digital receipts, Excel import/export, cloud sync, and MVP roadmap.";

const modules = [
  ["Produk", "Master produk obat/barang dengan SKU, barcode opsional, satuan, harga beli/jual, stok minimal, batch, expired date, dan status aktif."],
  ["Penjualan", "Owner membuat transaksi, item otomatis mengurangi stok via ledger movement, pembayaran cash/transfer/QRIS manual, dan struk digital."],
  ["Barang Masuk / Stock Receipt", "Input stok masuk dari pembelian/restock dengan supplier opsional, batch number, expired date, dan harga beli."],
  ["Penyesuaian Stok", "Koreksi stok untuk rusak, expired, hilang, atau opname. Semua koreksi wajib masuk ledger, bukan update angka diam-diam."],
  ["Laporan", "Omzet harian/range tanggal, transaksi, estimasi laba kotor, produk terlaris, stok menipis, stok mendekati expired, dan riwayat movement."],
  ["Struk Digital + Print Thermal", "Struk HTML/PDF/share WhatsApp berisi identitas apotek, nomor transaksi, item, total, metode bayar, footer, dan target dukungan printer thermal MVP jika device/printer memungkinkan."],
  ["Excel Import/Export", "Import produk dengan preview-validasi; export produk, stok, transaksi, dan laporan sederhana."],
  ["Offline Sync", "Android dan web tetap bisa jalan offline. Client menyimpan perubahan lokal lalu sync ke cloud saat online."],
  ["Admin Panel", "Panel internal untuk Ary memantau user daftar, apotek dibuat, transaksi/sync activity, error import/sync, dan aktivitas harian."],
];

const v1Checklist = [
  { done: true, label: "Backend FastAPI foundation, Scalar/OpenAPI docs, Alembic migrations, and test gates." },
  { done: true, label: "Owner register/login and active-store resolution." },
  { done: true, label: "Store profile data for receipt identity: name, address, phone, logo/header/footer fields." },
  { done: true, label: "Product CRUD with SKU, barcode, unit, purchase/selling price, min stock, active/soft-delete behavior." },
  { done: true, label: "Product categories per store and products.category_id relation." },
  { done: true, label: "Supplier CRUD per store and seeded supplier reference data." },
  { done: true, label: "Optional product batches with batch number, expiry date, and derived available quantity." },
  { done: true, label: "Sales API with sale_items and automatic stock_movements decrement." },
  { done: true, label: "Stock receipts/barang masuk with supplier, receipt items, batches, and stock_movements increment." },
  { done: true, label: "Stock adjustments with required reason and ledger-backed correction movement." },
  { done: true, label: "Basic reports API: revenue/transactions, low stock, near expiry, movements, and top products." },
  { done: true, label: "Product Excel import preview/commit with import job tracking." },
  { done: true, label: "Offline sync API foundation with idempotency/duplicate protection." },
  { done: true, label: "Internal admin APIs for users, stores, transactions, sync/import activity, and admin activity events." },
  { done: true, label: "Request/activity logging via Loguru." },
  { done: false, label: "Frontend barcode camera scanner connected to product lookup." },
  { done: false, label: "Receipt digital UI/share flow and thermal print best-effort integration." },
  { done: false, label: "Export products, stock, transactions, and reports." },
  { done: false, label: "Offline-first Android/web client storage and sync queue." },
  { done: false, label: "Full end-to-end owner demo: register → product/category/supplier → restock → sale → receipt → report → sync." },
];

const v1DoneCount = v1Checklist.filter((item) => item.done).length;
const v1TotalCount = v1Checklist.length;
const v1Progress = Math.round((v1DoneCount / v1TotalCount) * 100);

const roadmap = [
  {
    name: "v1 — MVP Owner-Only POS",
    features: ["User owner + data apotek untuk struk", "Master produk + category + supplier + SKU/barcode + harga + stok minimal", "Barcode scanner kamera untuk cari produk", "Batch/expired opsional", "Penjualan dengan ledger movement otomatis", "Stock receipt/barang masuk", "Penyesuaian stok dengan alasan", "Dashboard laporan dasar", "Struk digital + print thermal best-effort", "Excel import/export produk dan transaksi", "Offline-first Android + web dengan sync cloud ringan", "Admin panel internal: user, store, transaction, sync activity"],
    acceptance: ["Owner bisa daftar/login dan membuat data apotek.", "Nama/alamat/telepon apotek muncul di struk digital.", "Owner bisa tambah/edit produk, category, supplier, dan batch/expired opsional.", "Owner bisa scan barcode via kamera untuk menemukan produk yang sudah punya barcode.", "Owner bisa jual produk offline dan stok berkurang via stock_movements.", "Owner bisa input barang masuk dari supplier dan stok bertambah via stock_movements.", "Owner bisa koreksi stok dengan reason wajib.", "Owner bisa import/export data operasional penting dengan preview validasi untuk import.", "Owner bisa lihat omzet hari ini, stok menipis, dan produk mendekati expired.", "Owner bisa share struk digital dan mencoba print thermal pada printer/device yang didukung.", "Sync online tidak membuat transaksi dobel karena idempotency key.", "Ary bisa buka admin panel dan melihat jumlah user, apotek, transaksi, sync error/activity."],
  },
  {
    name: "v1.5 — Operasional Apotek Lebih Rapi",
    features: ["Retur sederhana", "Supplier lebih rapi", "Notifikasi stok menipis", "Notifikasi expired", "Laporan laba lebih akurat", "FEFO UI dengan konfirmasi batch", "SOP helper untuk rak fisik", "Printer thermal compatibility hardening"],
    acceptance: ["Retur sederhana membuat reversal movement, bukan hapus sale lama.", "Dashboard menampilkan daftar stok menipis dan near-expiry yang actionable.", "Sale screen menampilkan batch/expired yang dipilih sistem berdasarkan FEFO.", "Thermal print flow punya daftar printer/device yang terbukti jalan dan fallback ke share/download struk."],
  },
  {
    name: "v2 — Kasir & Tim",
    features: ["Cashier role", "RBAC ringan", "Shift kasir", "Audit log", "Multi-device sync lebih serius", "Permission per fitur", "Owner dashboard per kasir/shift"],
    acceptance: ["Owner bisa mengundang cashier ke store.", "Cashier hanya bisa menjual dan melihat fitur yang diizinkan.", "Setiap transaksi tercatat user/shift pembuatnya.", "Owner bisa melihat ringkasan transaksi per kasir/shift.", "Multi-device conflict minimal ditangani dengan idempotency dan server-side ordering."],
  },
  {
    name: "v3 — Compliance & Procurement",
    features: ["SIPNAP", "Faktur pajak", "Purchase order supplier", "Permintaan obat", "Dokumen supplier", "Reporting regulasi", "Batch/expired lebih ketat", "Audit trail compliance"],
    acceptance: ["PO supplier bisa dibuat, diterima sebagian, dan masuk stok lewat stock_receipts.", "Dokumen compliance bisa diekspor sesuai format yang disepakati.", "Batch/expired wajib untuk kategori obat tertentu jika compliance mode aktif.", "Audit trail menyimpan siapa melakukan perubahan, kapan, dan alasan."],
  },
];
---

<BaseLayout title={title} description={description} noindex>
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-slate-950">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-600">Product Requirements Document</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 dark:text-white">POS Apotek Lite</h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">POS apotek sederhana untuk owner: tetap bisa jualan saat internet mati, stok rapi berbasis ledger, laporan harian jelas, struk digital, Excel import/export, admin monitoring, dan sync cloud ringan.</p>
      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl bg-blue-50 p-4 dark:bg-blue-950/40"><b>Target:</b><br />User owner apotek single-outlet</div>
        <div class="rounded-2xl bg-emerald-50 p-4 dark:bg-emerald-950/40"><b>Platform:</b><br />Android + Web offline-first</div>
        <div class="rounded-2xl bg-amber-50 p-4 dark:bg-amber-950/40"><b>Backend:</b><br />FastAPI + PostgreSQL</div>
      </div>
    </section>

    <section class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 p-6 dark:border-slate-800"><h2 class="text-2xl font-bold">Problem</h2><p class="mt-3 text-slate-600 dark:text-slate-300">Owner apotek kecil butuh alat yang cepat untuk jualan dan menjaga stok tanpa bergantung internet. Spreadsheet mudah rusak, POS umum kurang peduli batch/expired, sementara software apotek lengkap sering terlalu berat untuk mulai.</p></div>
      <div class="rounded-3xl border border-slate-200 p-6 dark:border-slate-800"><h2 class="text-2xl font-bold">Product Principle</h2><p class="mt-3 text-slate-600 dark:text-slate-300">Jangan jadi ERP dulu. Ship core transaksi + stok + laporan. Semua perubahan stok wajib tercatat sebagai ledger movement; current stock hanya read model/cache.</p></div>
    </section>

    <section class="mt-10"><h2 class="text-2xl font-bold">MVP Modules</h2><div class="mt-5 grid gap-4 md:grid-cols-2">{modules.map(([name, body]) => <article class="rounded-2xl border border-slate-200 p-5 dark:border-slate-800"><h3 class="font-semibold text-slate-950 dark:text-white">{name}</h3><p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{body}</p></article>)}</div></section>

    <section class="mt-10 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-950">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">Roadmap V1 Checklist</p>
          <h2 class="mt-2 text-2xl font-bold">Implemented vs Remaining</h2>
          <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600 dark:text-slate-300">Checklist ini mengikuti format task-list: item hijau berarti sudah ada di backend/dev contract, item abu-abu berarti masih perlu FE, export, atau end-to-end hardening sebelum v1 dianggap selesai.</p>
        </div>
        <div class="rounded-2xl bg-blue-50 p-4 text-right dark:bg-blue-950/30">
          <div class="text-3xl font-bold text-blue-700 dark:text-blue-300">{v1Progress}%</div>
          <div class="text-sm text-blue-700/80 dark:text-blue-300/80">{v1DoneCount}/{v1TotalCount} checked</div>
        </div>
      </div>
      <div class="mt-6 space-y-2">
        {v1Checklist.map((item) => (
          <div class={`flex gap-3 rounded-xl border px-4 py-3 text-sm ${item.done ? "border-emerald-200 bg-emerald-50 text-slate-700 dark:border-emerald-900/60 dark:bg-emerald-950/20 dark:text-slate-200" : "border-slate-200 bg-slate-50 text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200"}`}>
            {item.done ? <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-emerald-600 text-xs font-bold text-white">✓</span> : <span class="mt-0.5 h-5 w-5 shrink-0 rounded-md border border-slate-400 dark:border-slate-600"></span>}
            <span>{item.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10 rounded-3xl border border-slate-200 p-6 dark:border-slate-800"><h2 class="text-2xl font-bold">Inventory Ledger Rule</h2><p class="mt-3 text-slate-600 dark:text-slate-300">Source of truth stok adalah <code>stock_movements</code>. Setiap sale, stock receipt, adjustment, expired, atau reversal membuat baris ledger append-only. <code>products.current_stock</code> dan <code>product_batches.available_qty</code> boleh disimpan sebagai derived read model untuk performa UI, tapi harus bisa direkonsiliasi ulang dari ledger. Data apotek untuk struk disimpan di <code>stores</code>: nama apotek, alamat, telepon, logo/header/footer.</p></section>

    <section class="mt-10 rounded-3xl border border-amber-200 bg-amber-50 p-6 dark:border-amber-900 dark:bg-amber-950/30"><h2 class="text-2xl font-bold">Batch, Barcode, and Physical Rack SOP</h2><p class="mt-3 text-slate-700 dark:text-slate-300">Barcode MVP diasumsikan sebagai identitas produk/SKU, bukan identitas batch. Batch number dan expired date diinput saat barang masuk. Saat penjualan, sistem bisa otomatis memilih batch dengan expired date paling dekat (FEFO), tapi data hanya akurat kalau fisik rak mengikuti SOP: obat dengan expired terdekat diletakkan paling depan dan kasir mengambil dari depan. Kalau rak dicampur, sistem tidak bisa menjamin batch fisik yang keluar sama dengan batch yang tercatat.</p></section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold">MVP Roadmap & Acceptance Criteria</h2>
      <div class="mt-5 space-y-6">{roadmap.map((item) => <article class="rounded-3xl border border-slate-200 p-6 dark:border-slate-800"><h3 class="text-xl font-bold">{item.name}</h3><div class="mt-5 grid gap-6 lg:grid-cols-2"><div><h4 class="font-semibold">Features</h4><ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-300">{item.features.map((feature) => <li>• {feature}</li>)}</ul></div><div><h4 class="font-semibold">Acceptance Criteria</h4><ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-300">{item.acceptance.map((criterion) => <li>• {criterion}</li>)}</ul></div></div></article>)}</div>
    </section>

    <section class="mt-10 rounded-3xl bg-slate-950 p-6 text-white"><h2 class="text-2xl font-bold">Related Build Docs</h2><div class="mt-4 flex flex-wrap gap-3"><a class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-950" href="/task-list/pos-apotek-lite/">Task List</a><a class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-950" href="/erd/pos-apotek-lite/">ERD</a></div></section>
  </main>
</BaseLayout>
