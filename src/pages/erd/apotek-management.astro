    fields: ["tenant_role_id FK", "permission_id FK", "granted_at"],
  },
  {
    name: "user_outlet_access",
    tag: "Outlet scope",
    fields: ["tenant_user_id FK", "outlet_id FK", "access_level", "is_default"],
  },
];

const masterEntities = [
