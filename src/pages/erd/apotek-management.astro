    tag: "Cashier shift",
    fields: ["id PK", "tenant_id FK", "outlet_id FK", "cashier_id FK", "pos_device_id FK", "opened_at", "opening_cash", "closed_at", "expected_cash", "actual_cash", "cash_variance", "status"],
  },
  {
    name: "sales",
    tag: "POS transaction",
