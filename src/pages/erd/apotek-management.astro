    fields: ["id PK", "tenant_id FK", "outlet_id FK", "product_id FK", "suggested_supplier_id FK", "source", "recommended_qty_base", "pending_po_qty_base", "status", "reviewed_by FK", "converted_po_item_id FK"],
  },
  {
    name: "purchase_orders",
