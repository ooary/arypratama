    fields: ["id PK", "tenant_id FK", "category_id FK", "drug_class_id FK", "manufacturer_id FK", "base_unit_id FK", "sku", "barcode", "name", "generic_name", "composition", "dosage_form", "strength", "is_narcotic", "is_psychotropic", "is_precursor", "is_obat_keras", "requires_pharmacist_gate", "min_stock_base", "status"],
