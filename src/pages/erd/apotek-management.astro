---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntityCard from "../../components/EntityCard.astro";

const title = "ERD — Core Managed Pharmacy";
const description = "PRD-aligned Entity Relationship Diagram for Core Managed Pharmacy: real SaaS tenancy, platform admin separation, pharmacy master data, procurement, SP, batch ledger, POS, offline sync, compliance, exports, and audit.";

const platformEntities = [
  {
    name: "platform_admin_users",
    tag: "SaaS operator",
    fields: ["id PK", "name", "email UNIQUE", "password_hash", "mfa_enabled", "status", "last_login_at", "created_at"],
  },
  {
    name: "platform_roles",
    tag: "Platform RBAC",
    fields: ["id PK", "name", "permission_codes jsonb", "status"],
  },
  {
    name: "platform_user_roles",
    tag: "Platform RBAC pivot",
    fields: ["platform_admin_user_id FK", "platform_role_id FK", "assigned_by FK", "assigned_at"],
  },
  {
    name: "tenants",
    tag: "Tenant / pharmacy business",
    fields: ["id PK", "legal_name", "display_name", "billing_email", "phone", "address", "timezone", "currency", "billing_status", "suspension_status", "created_at"],
  },
  {
    name: "plans",
    tag: "SaaS plan",
    fields: ["id PK", "code", "name", "max_outlets", "max_users", "max_products", "max_offline_devices", "export_limit_per_day", "status"],
  },
  {
    name: "tenant_subscriptions",
    tag: "Billing state",
    fields: ["id PK", "tenant_id FK", "plan_id FK", "status", "trial_ends_at", "current_period_start", "current_period_end", "past_due_since", "canceled_at"],
  },
  {
    name: "tenant_config_flags",
    tag: "Config over complexity",
    fields: ["id PK", "tenant_id FK", "config_key", "config_value jsonb", "source", "updated_by_user_id FK", "updated_by_platform_admin_id FK", "updated_at"],
  },
  {
    name: "support_access_sessions",
    tag: "Audited support access",
    fields: ["id PK", "tenant_id FK", "approved_by_user_id FK", "platform_admin_user_id FK", "reason", "starts_at", "expires_at", "status", "revoked_at"],
  },
  {
    name: "platform_audit_logs",
    tag: "Platform audit",
    fields: ["id PK", "platform_admin_user_id FK", "target_tenant_id FK", "action", "entity_type", "entity_id", "before_json", "after_json", "reason", "ip_address", "created_at"],
  },
];

const tenantFoundationEntities = [
