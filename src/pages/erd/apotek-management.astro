---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntityCard from "../../components/EntityCard.astro";

const title = "ERD — Core Managed Pharmacy";
const description = "Entity Relationship Diagram for Core Managed Pharmacy: organization, master data, procurement, inventory ledger, POS, optional customers, expiry handling, and audit trail.";

const coreEntities = [
  {
    name: "organizations",
    tag: "Tenant",
    fields: ["id PK", "name", "legal_name", "tax_id", "status", "created_at"],
  },
  {
    name: "outlets",
    tag: "Outlet",
    fields: ["id PK", "organization_id FK", "name", "address", "phone", "is_default", "status"],
  },
  {
    name: "warehouses",
    tag: "Stock location",
    fields: ["id PK", "outlet_id FK", "name", "warehouse_type", "is_default", "status"],
  },
  {
    name: "pharmacy_profiles",
    tag: "Pharmacy config",
    fields: ["id PK", "outlet_id FK", "pharmacist_name", "sia_no", "sipa_no", "receipt_footer", "stock_policy"],
  },
  {
    name: "users",
    tag: "Actor",
    fields: ["id PK", "organization_id FK", "outlet_id FK", "name", "email", "password_hash", "status"],
  },
  {
    name: "roles",
    tag: "Access",
    fields: ["id PK", "organization_id FK", "name", "scope", "status"],
  },
  {
    name: "permissions",
    tag: "Access",
    fields: ["id PK", "code", "name", "module"],
  },
];

const masterEntities = [
  {
    name: "products",
    tag: "Product / sale item",
    fields: ["id PK", "organization_id FK", "category_id FK", "drug_class_id FK", "manufacturer_id FK", "default_supplier_id FK", "sku", "barcode", "name", "generic_name", "strength", "dosage_form", "needs_pharmacist_review", "min_stock_base_unit", "base_unit_id FK", "status"],
  },
  {
    name: "product_units",
    tag: "Unit",
    fields: ["id PK", "product_id FK", "unit_name", "unit_code", "is_base_unit", "sort_order"],
  },
  {
    name: "product_unit_conversions",
    tag: "Conversion",
    fields: ["id PK", "product_id FK", "from_unit_id FK", "to_unit_id FK", "multiplier_to_base", "is_active"],
  },
  {
    name: "product_prices",
    tag: "Selling price",
    fields: ["id PK", "product_id FK", "unit_id FK", "price_type", "selling_price", "margin_target", "effective_from", "effective_to", "created_by FK"],
  },
  {
    name: "suppliers",
    tag: "PBF",
    fields: ["id PK", "organization_id FK", "name", "legal_name", "address", "contact_name", "phone", "email", "payment_terms_days", "license_no", "status"],
  },
  {
    name: "supplier_products",
    tag: "Supplier item",
    fields: ["id PK", "supplier_id FK", "product_id FK", "supplier_sku", "last_purchase_price", "is_preferred"],
  },
  {
    name: "product_locations",
    tag: "Default rack",
    fields: ["id PK", "product_id FK", "warehouse_id FK", "rack_code", "bin_code"],
  },
  {
    name: "customers",
    tag: "Optional customer",
    fields: ["id PK", "organization_id FK", "customer_group_id FK", "name", "phone", "address", "notes", "future_profile_ref", "status"],
  },
  {
    name: "customer_groups",
    tag: "Customer segment",
    fields: ["id PK", "organization_id FK", "name", "description", "status"],
  },
];

const inventoryEntities = [
  {
    name: "stock_batches",
    tag: "Physical stock source",
    fields: ["id PK", "outlet_id FK", "warehouse_id FK", "product_id FK", "batch_no", "expiry_date", "qty_available_base_unit", "hpp_per_base_unit", "source_type", "source_id", "status"],
  },
  {
    name: "stock_movements",
    tag: "Stock ledger",
    fields: ["id PK", "movement_no", "outlet_id FK", "warehouse_id FK", "product_id FK", "batch_id FK", "movement_type", "qty_in_base_unit", "qty_out_base_unit", "balance_after_base_unit", "unit_id FK", "display_qty", "reference_type", "reference_id", "reason", "created_by FK", "created_at"],
  },
  {
    name: "stock_opnames",
    tag: "Stock take",
    fields: ["id PK", "outlet_id FK", "warehouse_id FK", "opname_no", "status", "started_by FK", "posted_by FK", "posted_at"],
  },
  {
    name: "stock_opname_items",
    tag: "Stock take detail",
    fields: ["id PK", "stock_opname_id FK", "product_id FK", "batch_id FK", "system_qty_base", "physical_qty_base", "difference_qty_base", "reason"],
  },
  {
    name: "stock_mutations",
    tag: "Warehouse/outlet transfer",
    fields: ["id PK", "mutation_no", "from_outlet_id FK", "to_outlet_id FK", "from_warehouse_id FK", "to_warehouse_id FK", "status", "created_by FK", "posted_at"],
  },
  {
    name: "stock_mutation_items",
    tag: "Transfer detail",
    fields: ["id PK", "stock_mutation_id FK", "product_id FK", "batch_id FK", "unit_id FK", "qty", "qty_base_unit"],
  },
  {
    name: "expired_actions",
    tag: "Expiry/quarantine",
    fields: ["id PK", "batch_id FK", "action_type", "qty_base_unit", "reference_type", "reference_id", "loss_amount", "created_by FK", "created_at"],
  },
];

const procurementEntities = [
  {
    name: "defecta_items",
    tag: "Procurement queue",
    fields: ["id PK", "outlet_id FK", "product_id FK", "suggested_supplier_id FK", "source", "requested_qty_base", "status", "reviewed_by FK", "converted_po_item_id FK"],
  },
  {
    name: "purchase_orders",
    tag: "PO header",
    fields: ["id PK", "po_no", "outlet_id FK", "supplier_id FK", "status", "order_date", "expected_date", "created_by FK"],
  },
  {
    name: "purchase_order_items",
    tag: "PO detail",
    fields: ["id PK", "purchase_order_id FK", "product_id FK", "unit_id FK", "qty_ordered", "qty_ordered_base", "estimated_price", "qty_received_base"],
  },
  {
    name: "goods_receipts",
    tag: "Goods receipt",
    fields: ["id PK", "receipt_no", "outlet_id FK", "warehouse_id FK", "supplier_id FK", "purchase_order_id FK", "invoice_no", "received_at", "status", "received_by FK"],
  },
  {
    name: "goods_receipt_items",
    tag: "Goods receipt detail",
    fields: ["id PK", "goods_receipt_id FK", "purchase_order_item_id FK", "product_id FK", "unit_id FK", "qty_received", "qty_received_base", "purchase_price", "discount_amount", "tax_amount", "batch_no", "expiry_date", "stock_batch_id FK"],
  },
  {
    name: "supplier_invoices",
    tag: "Supplier payable",
    fields: ["id PK", "supplier_id FK", "goods_receipt_id FK", "invoice_no", "invoice_date", "due_date", "total_amount", "paid_amount", "status"],
  },
  {
    name: "supplier_payments",
    tag: "Pay payable",
    fields: ["id PK", "supplier_invoice_id FK", "payment_date", "amount", "payment_method", "reference_no", "created_by FK"],
  },
];

const posEntities = [
  {
    name: "shift_schedules",
    tag: "Shift schedule",
    fields: ["id PK", "outlet_id FK", "user_id FK", "scheduled_start", "scheduled_end", "status"],
  },
  {
    name: "shifts",
    tag: "Cashier shift",
    fields: ["id PK", "outlet_id FK", "user_id FK", "schedule_id FK", "opened_at", "opening_cash", "closed_at", "system_cash", "physical_cash", "cash_difference", "status"],
  },
  {
    name: "sales",
    tag: "POS transaction",
    fields: ["id PK", "sale_no", "outlet_id FK", "shift_id FK", "cashier_id FK", "customer_id FK", "sale_note_id FK", "sale_type", "subtotal", "discount_total", "tax_total", "grand_total", "status", "posted_at"],
  },
  {
    name: "sale_items",
    tag: "Sale item",
    fields: ["id PK", "sale_id FK", "product_id FK", "batch_id FK", "unit_id FK", "qty", "qty_base_unit", "unit_price", "discount_amount", "hpp_per_base_unit", "line_total"],
  },
  {
    name: "payments",
    tag: "Payment",
    fields: ["id PK", "sale_id FK", "payment_method", "amount", "reference_no", "paid_at", "created_by FK"],
  },
  {
    name: "sale_returns",
    tag: "Sale return",
    fields: ["id PK", "return_no", "sale_id FK", "outlet_id FK", "reason", "refund_amount", "status", "created_by FK", "posted_at"],
  },
  {
    name: "sale_return_items",
    tag: "Sale return detail",
    fields: ["id PK", "sale_return_id FK", "sale_item_id FK", "product_id FK", "batch_id FK", "unit_id FK", "qty", "qty_base_unit", "stock_disposition"],
  },
  {
    name: "purchase_returns",
    tag: "Supplier return",
    fields: ["id PK", "return_no", "supplier_id FK", "outlet_id FK", "goods_receipt_id FK", "reason", "status", "created_by FK", "posted_at"],
  },
  {
    name: "purchase_return_items",
    tag: "Supplier return detail",
    fields: ["id PK", "purchase_return_id FK", "product_id FK", "batch_id FK", "unit_id FK", "qty", "qty_base_unit", "refund_amount"],
  },
];

const customerOpsEntities = [
  {
    name: "sales_note_templates",
    tag: "Note template",
    fields: ["id PK", "organization_id FK", "name", "note_text", "is_active"],
  },
  {
    name: "sale_notes",
    tag: "Sales note",
    fields: ["id PK", "sale_id FK", "template_id FK", "customer_id FK", "note_text", "created_by FK", "created_at"],
  },
  {
    name: "audit_logs",
    tag: "Audit trail",
    fields: ["id PK", "organization_id FK", "outlet_id FK", "actor_id FK", "action", "entity_type", "entity_id", "before_json", "after_json", "ip_address", "created_at"],
  },
];

const relationshipGroups = [
  {
    title: "Foundation",
    items: [
      "organizations 1—N outlets",
      "outlets 1—N warehouses",
      "outlets 1—1 pharmacy_profiles",
      "organizations 1—N users / roles / suppliers / products",
      "users N—N roles, roles N—N permissions through user_roles and role_permissions pivot tables",
    ],
  },
  {
    title: "Master Data",
    items: [
      "products N—1 product_categories / drug_classes / manufacturers",
      "products 1—N product_units, product_prices, product_locations",
      "products 1—N product_unit_conversions for different purchase and selling units",
      "suppliers N—N products through supplier_products",
      "products.default_supplier_id optionally references suppliers",
    ],
  },
  {
    title: "Inventory Ledger",
    items: [
      "stock_batches N—1 products, outlets, warehouses",
      "stock_movements N—1 stock_batches and products",
      "all stock-affecting transactions write stock_movements with reference_type + reference_id",
      "stock_opnames 1—N stock_opname_items; posting creates adjustment movements",
      "stock_mutations 1—N stock_mutation_items; posting creates mutation_out and mutation_in movements",
    ],
  },
  {
    title: "Procurement",
    items: [
      "defecta_items can be converted into purchase_order_items",
      "purchase_orders 1—N purchase_order_items",
      "goods_receipts can reference purchase_orders and own goods_receipt_items",
      "goods_receipt_items create stock_batches and purchase_receive stock_movements",
      "supplier_invoices N—1 goods_receipts; supplier_payments N—1 supplier_invoices",
    ],
  },
  {
    title: "POS, Notes, Returns",
    items: [
      "shifts 1—N sales; sales 1—N sale_items and payments",
      "sale_items N—1 products, units, batches; sale posting creates sale stock_movements",
      "sales 1—N sale_notes; optional customers can be referenced by sales",
      "sale_returns 1—N sale_return_items; returned items must define stock_disposition",
      "purchase_returns 1—N purchase_return_items; posting creates purchase_return stock_movements",
    ],
  },
];

const buildOrder = [
  "Foundation: organization, outlet, warehouse, pharmacy profile, users, roles.",
  "Master data: product, unit conversion, price, supplier, rack, customer.",
  "Inventory engine: stock batch, stock movement ledger, stock balance, FEFO deduction.",
  "Procurement: defecta, PO, goods receipt, invoice, supplier payment.",
  "Stock control: stock take, transfer, returns, expiry action.",
  "POS & customer notes: shift, sale, payment, return, sales note.",
  "Audit and reporting layer: audit_logs plus query/report views on top of the ledger.",
];
---

<BaseLayout title={title} description={description}>
  <section class="space-y-6">
    <div class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-bold text-blue-700 dark:border-blue-900/70 dark:bg-blue-950/40 dark:text-blue-300">
      Entity Relationship Diagram
    </div>
    <div class="space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">
        Core Managed Pharmacy
      </h1>
      <p class="max-w-3xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">
        ERD derived from the BRD <a href="/brd/apotek-management" class="font-bold text-blue-600 hover:text-blue-700 dark:text-blue-300">Core Managed Pharmacy</a>. This model is intentionally inventory-first: stock is calculated from batches and the stock movement ledger, not from a single mutable product field.
      </p>
    </div>
    <div class="grid gap-3 sm:grid-cols-3">
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Source of truth</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">stock_batches + stock_movements</div>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Scope</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">Multi-outlet-ready pharmacy core</div>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">URL</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">/erd/apotek-management</div>
      </div>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">1. High-Level ERD</h2>
    <div class="overflow-x-auto rounded-3xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
      <svg viewBox="0 0 1160 760" role="img" aria-label="High-level ERD Core Managed Pharmacy" class="h-auto w-full min-w-[760px]">
        <defs>
          <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
            <path d="M0,0 L0,6 L9,3 z" fill="#2563eb"></path>
          </marker>
        </defs>
        <rect x="24" y="30" width="190" height="92" rx="18" fill="#eff6ff" stroke="#93c5fd" />
        <text x="44" y="65" font-size="18" font-weight="700" fill="#1e3a8a">Organization</text>
        <text x="44" y="92" font-size="13" fill="#475569">outlets, warehouses</text>
        <text x="44" y="112" font-size="13" fill="#475569">users, roles, config</text>

        <rect x="304" y="30" width="200" height="92" rx="18" fill="#f8fafc" stroke="#cbd5e1" />
        <text x="324" y="65" font-size="18" font-weight="700" fill="#0f172a">Master Data</text>
        <text x="324" y="92" font-size="13" fill="#475569">products, units, prices</text>
        <text x="324" y="112" font-size="13" fill="#475569">suppliers, customers</text>

        <rect x="608" y="30" width="220" height="92" rx="18" fill="#ecfdf5" stroke="#86efac" />
        <text x="628" y="65" font-size="18" font-weight="700" fill="#14532d">Procurement</text>
        <text x="628" y="92" font-size="13" fill="#475569">defecta, PO</text>
        <text x="628" y="112" font-size="13" fill="#475569">goods receipt, invoice</text>

        <rect x="898" y="30" width="220" height="92" rx="18" fill="#fefce8" stroke="#fde047" />
        <text x="918" y="65" font-size="18" font-weight="700" fill="#713f12">Stock Control</text>
        <text x="918" y="92" font-size="13" fill="#475569">stock take, transfer</text>
        <text x="918" y="112" font-size="13" fill="#475569">return, expired action</text>

        <rect x="370" y="296" width="420" height="142" rx="24" fill="#dbeafe" stroke="#2563eb" stroke-width="2" />
        <text x="408" y="344" font-size="24" font-weight="800" fill="#1e3a8a">Inventory Ledger Core</text>
        <text x="408" y="376" font-size="15" fill="#1f2937">stock_batches = physical stock by batch/expiry/location</text>
        <text x="408" y="402" font-size="15" fill="#1f2937">stock_movements = all stock changes, append-only</text>

        <rect x="96" y="590" width="210" height="96" rx="18" fill="#fdf2f8" stroke="#f9a8d4" />
        <text x="116" y="628" font-size="18" font-weight="700" fill="#831843">POS & Shift</text>
        <text x="116" y="655" font-size="13" fill="#475569">sales, items, payments</text>
        <text x="116" y="675" font-size="13" fill="#475569">cashier shift</text>

        <rect x="476" y="590" width="210" height="96" rx="18" fill="#faf5ff" stroke="#d8b4fe" />
        <text x="496" y="628" font-size="18" font-weight="700" fill="#581c87">Customer & Notes</text>
        <text x="496" y="655" font-size="13" fill="#475569">customers optional</text>
        <text x="496" y="675" font-size="13" fill="#475569">sales note templates</text>

        <rect x="854" y="590" width="210" height="96" rx="18" fill="#fff7ed" stroke="#fdba74" />
        <text x="874" y="628" font-size="18" font-weight="700" fill="#7c2d12">Audit & Reports</text>
        <text x="874" y="655" font-size="13" fill="#475569">audit_logs</text>
        <text x="874" y="675" font-size="13" fill="#475569">reporting views</text>

        <line x1="214" y1="76" x2="304" y2="76" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <line x1="504" y1="76" x2="608" y2="76" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <line x1="828" y1="76" x2="898" y2="76" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M404 122 C404 190 460 234 510 296" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M718 122 C718 186 676 238 642 296" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M1008 122 C1008 245 852 284 790 340" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M201 590 C252 498 310 430 370 384" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M581 590 L581 438" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M854 638 C780 542 754 478 724 438" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M214 104 C278 194 316 272 370 334" fill="none" stroke="#94a3b8" stroke-width="2" stroke-dasharray="7 7" marker-end="url(#arrow)" />
      </svg>
    </div>
    <p class="text-sm leading-7 text-zinc-600 dark:text-zinc-300">
      Solid blue arrows mean the transaction or domain creates or reads the stock ledger. The dashed line from foundation means all data remains scoped to organization, outlet, warehouse, and user.
    </p>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">2. Relationship Map</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {relationshipGroups.map((group) => (
        <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <h3 class="font-bold text-zinc-950 dark:text-white">{group.title}</h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">3. Entity Groups</h2>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.1 Foundation</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {coreEntities.map((entity) => (
          <EntityCard entity={entity} />
        ))}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.2 Master Data</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {masterEntities.map((entity) => (
          <EntityCard entity={entity} />
        ))}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.3 Inventory Ledger</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {inventoryEntities.map((entity) => (
          <EntityCard entity={entity} />
        ))}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.4 Procurement</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {procurementEntities.map((entity) => (
          <EntityCard entity={entity} />
        ))}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.5 POS, Shift & Return</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {posEntities.map((entity) => (
          <EntityCard entity={entity} />
        ))}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.6 Customer Notes & Audit</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {customerOpsEntities.map((entity) => (
          <EntityCard entity={entity} />
        ))}
      </div>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">4. Ledger Rules</h2>
    <div class="rounded-3xl border border-blue-200 bg-blue-50 p-6 dark:border-blue-900/70 dark:bg-blue-950/30">
      <ul class="list-disc space-y-2 pl-5 text-sm leading-7 text-blue-950 dark:text-blue-100">
        <li>Do not store primary stock in <code>products.stock</code>. If fast reads are needed, create a cache or materialized view from <code>stock_batches</code> and <code>stock_movements</code>.</li>
        <li>All movement quantities are stored in the base unit. Selling and purchase units are display/input UX only.</li>
        <li><code>stock_movements</code> is append-only. Stock corrections must use reversal or adjustment movements.</li>
        <li>Every stock-affecting transaction must be idempotent through <code>reference_type</code> + <code>reference_id</code>.</li>
        <li>Stock deduction chooses batches through the default FEFO policy, but the chosen batch remains explicitly recorded on transaction items.</li>
      </ul>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">5. Build Order Schema</h2>
    <div class="grid gap-3">
      {buildOrder.map((item, index) => (
        <div class="flex gap-3 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
            {index + 1}
          </div>
          <div class="text-sm leading-7 text-zinc-700 dark:text-zinc-300">{item}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="rounded-3xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900/70">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">Design Take</h2>
    <p class="mt-3 leading-8 text-zinc-700 dark:text-zinc-300">
      This ERD is intentionally heavier than a simple POS schema because pharmacy operations break quickly when the stock model is wrong. The key decisions: products do not store stock directly, unit conversion is a first-class model, and every stock-changing operational activity must end in an auditable ledger.
    </p>
  </section>
</BaseLayout>
