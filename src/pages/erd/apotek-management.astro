    tag: "Transfer header",
    fields: ["id PK", "tenant_id FK", "transfer_no", "from_outlet_id FK", "to_outlet_id FK", "from_warehouse_id FK", "to_warehouse_id FK", "status", "created_by FK", "sent_at", "received_at"],
