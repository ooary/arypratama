    fields: ["id PK", "tenant_id FK", "outlet_id FK", "name", "warehouse_type", "is_default", "status"],
  },
  {
    name: "pharmacy_profiles",
    tag: "Licensed profile",
    fields: ["id PK", "tenant_id FK", "outlet_id FK", "pharmacy_name", "license_no", "pharmacist_in_charge", "sipa_no", "sia_no", "receipt_header", "receipt_footer"],
  },
  {
    name: "document_number_series",
    tag: "Document numbering",
    fields: ["id PK", "tenant_id FK", "outlet_id FK", "document_type", "prefix", "next_number", "reset_policy", "status"],
  },
  {
    name: "tenant_users",
    tag: "Tenant actor",
    fields: ["id PK", "tenant_id FK", "name", "email", "phone", "password_hash", "mfa_enabled", "status", "last_login_at"],
  },
  {
    name: "tenant_roles",
    tag: "Tenant RBAC",
    fields: ["id PK", "tenant_id FK nullable", "name", "role_type", "scope", "is_system_role", "status"],
  },
  {
    name: "permissions",
    tag: "Permission catalog",
    fields: ["id PK", "code UNIQUE", "module", "name", "description"],
  },
  {
