const complianceAndOpsEntities = [
  {
    name: "regulated_monthly_reports",
    tag: "SIPNAP-ready export",
    fields: ["id PK", "tenant_id FK", "outlet_id FK", "report_month", "report_type", "status", "generated_by FK", "generated_at", "export_file_id FK"],
  },
  {
    name: "regulated_report_lines",
    tag: "Regulated item summary",
    fields: ["id PK", "tenant_id FK", "regulated_monthly_report_id FK", "product_id FK", "opening_balance_base", "incoming_base", "outgoing_base", "adjustment_base", "closing_balance_base"],
  },
  {
    name: "attachments",
    tag: "Invoice / disposal file",
    fields: ["id PK", "tenant_id FK", "owner_type", "owner_id", "file_name", "mime_type", "storage_key", "uploaded_by FK", "uploaded_at"],
  },
  {
    name: "data_export_jobs",
    tag: "Tenant portability",
    fields: ["id PK", "tenant_id FK", "requested_by FK", "export_type", "status", "file_id FK", "requested_at", "completed_at", "expires_at"],
  },
  {
    name: "audit_logs",
    tag: "Tenant audit trail",
    fields: ["id PK", "tenant_id FK", "outlet_id FK", "actor_user_id FK", "support_session_id FK", "action", "entity_type", "entity_id", "before_json", "after_json", "reason", "ip_address", "created_at"],
  },
];

const relationshipGroups = [
  {
    title: "Real SaaS foundation",
    items: [
      "platform_admin_users are outside tenant RBAC and operate tenant metadata, billing, entitlements, suspension, and support-access workflows.",
      "tenants 1—N outlets, warehouses, tenant_users, products, suppliers, reports, exports, and audit_logs.",
      "plans 1—N tenant_subscriptions; tenant_subscriptions N—1 tenants.",
      "tenant_config_flags store predefined config keys such as require_po_approval, enable_offline_pos, and support_access_expiry_minutes.",
      "support_access_sessions bridge platform_admin_users to a tenant only after tenant approval, reason, expiry, and audit logging.",
      "platform_audit_logs record privileged platform actions separately from tenant audit_logs.",
    ],
  },
  {
    title: "Tenant RBAC and outlet scope",
    items: [
      "tenant_users N—N tenant_roles through tenant_user_roles.",
      "tenant_roles N—N permissions through role_permissions.",
      "tenant_users N—N outlets through user_outlet_access for multi-outlet data visibility.",
      "Owner is tenant-side admin; Platform Admin is not stored as a tenant role.",
    ],
  },
  {
    title: "Master data",
    items: [
      "products reference product_categories, drug_classes, manufacturers, and a base product_unit.",
      "products 1—N product_units, product_unit_conversions, product_prices, product_locations, and supplier_products.",
      "drug_classes and product boolean flags drive SP, SIPNAP, and POS pharmacist-gate behavior.",
      "suppliers N—N products through supplier_products so multiple PBFs can be compared per product.",
      "customers are optional and become required only for bon / customer receivable workflows.",
    ],
  },
  {
    title: "Inventory ledger core",
    items: [
      "stock_batches + stock_movements are the stock source of truth; products never store primary stock.",
      "stock_batches N—1 tenant, outlet, warehouse, product, and source document.",
      "stock_movements N—1 stock_batches and products; all movements are append-only and idempotent via reference_type + reference_id.",
      "stock_take_sessions 1—N stock_take_items; posting creates adjustment movements only for deltas.",
      "stock_transfers 1—N stock_transfer_items; posting creates transfer_out and transfer_in movements, with optional pending receipt.",
      "expiry_actions quarantine or dispose batches and create ledger movements that remove stock from saleable inventory.",
    ],
  },
  {
    title: "Procurement and compliance documents",
    items: [
      "defecta_items can convert into purchase_order_items, with approval controlled by require_defecta_approval.",
      "purchase_orders 1—N purchase_order_items and support partial fulfillment through qty_received_base.",
      "surat_pesanan links PO, supplier/PBF, pharmacy profile, pharmacist, and regulated item lines before goods receipt finalization.",
      "goods_receipts can reference PO and SP; goods_receipt_items create stock_batches and purchase_receive stock_movements.",
      "supplier_invoices capture faktur PBF fields; supplier_payments reduce payables.",
      "purchase_returns deduct selected batches and create purchase_return stock_movements.",
    ],
  },
  {
    title: "POS, offline, payments, receivables",
    items: [
      "shifts 1—N sales; sales require an open shift except controlled recovery/admin correction flows.",
      "sales 1—N sale_items, sale_payments, and optional customer_receivables.",
      "sale_items 1—N sale_item_batch_allocations so FEFO can split one sale line across multiple batches.",
      "mixed payments are represented by multiple sale_payments using tenant payment_methods.",
      "bon / hutang pelanggan creates customer_receivables and later receivable_payments.",
      "offline_sync_queue uses idempotency_key and conflict_reason so offline POS never silently mutates ledger state.",
      "sale_returns and sale_return_items restore to original batch or quarantine based on stock_disposition.",
    ],
  },
  {
    title: "Reporting, export, audit",
    items: [
      "regulated_monthly_reports and regulated_report_lines are generated from stock_movements for SIPNAP-ready manual export.",
      "data_export_jobs package tenant-owned products, batches, movements, purchases, sales, payments, shifts, customers, config, and audit logs.",
      "attachments link invoices, disposal evidence, and export files without embedding binary data in operational tables.",
      "audit_logs capture tenant actions, including support impersonation through support_session_id.",
    ],
  },
];

const invariants = [
  "Every tenant-owned table carries tenant_id. Platform tables do not pretend to be tenant data.",
  "Platform Admin is not pharmacy Owner. Owner administers one tenant; Platform Admin administers SaaS metadata, billing, entitlements, and controlled support access.",
  "Do not model products.stock as source of truth. Use stock_batches and append-only stock_movements; summaries are projections only.",
  "All stock quantities are stored in product base unit. Purchase/sales units are input/display metadata with locked conversions after movement exists.",
  "Posted stock_movements are immutable. Corrections use reversal or adjustment movement rows with reason and actor.",
  "Regulated products must be visible from product → SP / goods receipt / stock movement / SIPNAP report line.",
  "Offline POS events must use idempotency keys and conflict review. Never silently rewrite stock history during sync.",
  "Support impersonation must always link tenant audit logs to a support_access_session.",
];

const buildOrder = [
  "Phase 0 Foundation: platform_admin_users, tenants, plans, subscriptions, config flags, support_access_sessions, tenant_users, RBAC, outlets, warehouses, pharmacy_profiles, audit foundations.",
  "Phase 1 Master data + ledger: products, categories, drug_classes, units, conversions, prices, suppliers, supplier_products, stock_batches, stock_movements, opening stock import.",
  "Phase 2 Procurement + stock control: defecta, purchase_orders, surat_pesanan, goods_receipts, supplier_invoices, stock_take, transfers, purchase_returns, expiry_actions.",
  "Phase 3 POS + shift: pos_devices, shifts, sales, sale_items, batch allocations, payments, receivables, sale_returns, offline_sync_queue.",
  "Phase 4 Reports + audit: regulated_monthly_reports, regulated_report_lines, role dashboards, tenant audit filters, export formats.",
  "Phase 5 SaaS polish: data_export_jobs, billing enforcement, support access UX, backup/restore evidence, monitoring, plan limit enforcement.",
];
---

<BaseLayout title={title} description={description}>
  <section class="space-y-6">
    <div class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-bold text-blue-700 dark:border-blue-900/70 dark:bg-blue-950/40 dark:text-blue-300">
      Entity Relationship Diagram
    </div>
    <div class="space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">
        Core Managed Pharmacy ERD
      </h1>
      <p class="max-w-4xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">
        ERD derived from the current <a href="/prd/apotek-management/" class="font-bold text-blue-600 hover:text-blue-700 dark:text-blue-300">Core Managed Pharmacy PRD</a>. This version models the product as real SaaS: platform administration is separate from tenant pharmacy users, every tenant record is scoped by <code>tenant_id</code>, and stock remains ledger-first through <code>stock_batches</code> plus append-only <code>stock_movements</code>.
      </p>
    </div>
    <div class="grid gap-3 sm:grid-cols-3">
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">SaaS boundary</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">Platform Admin ≠ Tenant Owner</div>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Stock source of truth</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">stock_batches + stock_movements</div>
      </div>
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="text-xs font-bold uppercase tracking-wide text-zinc-500">Compliance</div>
        <div class="mt-2 font-bold text-zinc-950 dark:text-white">SP, PBF faktur, SIPNAP-ready export</div>
      </div>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">1. High-Level ERD</h2>
    <div class="overflow-x-auto rounded-3xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
      <svg viewBox="0 0 1240 820" role="img" aria-label="High-level ERD Core Managed Pharmacy" class="h-auto w-full min-w-[820px]">
        <defs>
          <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
            <path d="M0,0 L0,6 L9,3 z" fill="#2563eb"></path>
          </marker>
        </defs>

        <rect x="36" y="36" width="230" height="110" rx="18" fill="#fef2f2" stroke="#fca5a5" />
        <text x="56" y="72" font-size="18" font-weight="800" fill="#7f1d1d">SaaS Platform</text>
        <text x="56" y="100" font-size="13" fill="#475569">platform admins, plans</text>
        <text x="56" y="120" font-size="13" fill="#475569">billing, support access</text>

        <rect x="356" y="36" width="230" height="110" rx="18" fill="#eff6ff" stroke="#93c5fd" />
        <text x="376" y="72" font-size="18" font-weight="800" fill="#1e3a8a">Tenant Foundation</text>
        <text x="376" y="100" font-size="13" fill="#475569">tenant, outlet, warehouse</text>
        <text x="376" y="120" font-size="13" fill="#475569">tenant users, RBAC, config</text>

        <rect x="676" y="36" width="230" height="110" rx="18" fill="#f8fafc" stroke="#cbd5e1" />
        <text x="696" y="72" font-size="18" font-weight="800" fill="#0f172a">Master Data</text>
        <text x="696" y="100" font-size="13" fill="#475569">products, units, prices</text>
        <text x="696" y="120" font-size="13" fill="#475569">suppliers/PBF, customers</text>

        <rect x="966" y="36" width="230" height="110" rx="18" fill="#ecfdf5" stroke="#86efac" />
        <text x="986" y="72" font-size="18" font-weight="800" fill="#14532d">Procurement</text>
        <text x="986" y="100" font-size="13" fill="#475569">defecta, PO, SP</text>
        <text x="986" y="120" font-size="13" fill="#475569">receipt, faktur PBF</text>

        <rect x="410" y="310" width="420" height="148" rx="24" fill="#dbeafe" stroke="#2563eb" stroke-width="2" />
        <text x="448" y="360" font-size="24" font-weight="900" fill="#1e3a8a">Inventory Ledger Core</text>
        <text x="448" y="392" font-size="15" fill="#1f2937">stock_batches = batch / expiry / location</text>
        <text x="448" y="418" font-size="15" fill="#1f2937">stock_movements = append-only source of truth</text>

        <rect x="54" y="604" width="220" height="106" rx="18" fill="#fdf2f8" stroke="#f9a8d4" />
        <text x="74" y="644" font-size="18" font-weight="800" fill="#831843">POS & Offline</text>
        <text x="74" y="672" font-size="13" fill="#475569">shift, sale, payments</text>
        <text x="74" y="692" font-size="13" fill="#475569">offline sync queue</text>

        <rect x="352" y="604" width="220" height="106" rx="18" fill="#faf5ff" stroke="#d8b4fe" />
        <text x="372" y="644" font-size="18" font-weight="800" fill="#581c87">Customers & Bon</text>
        <text x="372" y="672" font-size="13" fill="#475569">optional customers</text>
        <text x="372" y="692" font-size="13" fill="#475569">receivables, repayments</text>

        <rect x="668" y="604" width="220" height="106" rx="18" fill="#fefce8" stroke="#fde047" />
        <text x="688" y="644" font-size="18" font-weight="800" fill="#713f12">Stock Control</text>
        <text x="688" y="672" font-size="13" fill="#475569">stock take, transfer</text>
        <text x="688" y="692" font-size="13" fill="#475569">quarantine, disposal</text>

        <rect x="966" y="604" width="220" height="106" rx="18" fill="#fff7ed" stroke="#fdba74" />
        <text x="986" y="644" font-size="18" font-weight="800" fill="#7c2d12">Audit & Export</text>
        <text x="986" y="672" font-size="13" fill="#475569">SIPNAP-ready reports</text>
        <text x="986" y="692" font-size="13" fill="#475569">audit logs, data export</text>

        <line x1="266" y1="92" x2="356" y2="92" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <line x1="586" y1="92" x2="676" y2="92" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <line x1="906" y1="92" x2="966" y2="92" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />

        <path d="M471 146 C486 210 530 258 574 310" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M791 146 C776 218 716 260 678 310" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M1081 146 C1064 252 910 298 830 368" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M164 604 C246 510 326 442 410 396" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M778 604 C760 536 738 500 708 458" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M1076 604 C980 520 890 462 830 412" fill="none" stroke="#2563eb" stroke-width="2" marker-end="url(#arrow)" />
        <path d="M462 604 C492 538 532 500 574 458" fill="none" stroke="#94a3b8" stroke-width="2" stroke-dasharray="7 7" marker-end="url(#arrow)" />
      </svg>
    </div>
    <p class="text-sm leading-7 text-zinc-600 dark:text-zinc-300">
      Solid blue arrows represent workflows that create, read, or constrain the stock ledger. The dashed arrow means customer/bon data is optional until a sale requires customer context. Platform admin is deliberately separated from tenant operational records.
    </p>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">2. Relationship Map</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {relationshipGroups.map((group) => (
        <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <h3 class="font-bold text-zinc-950 dark:text-white">{group.title}</h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">3. Entity Groups</h2>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.1 SaaS Platform Boundary</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {platformEntities.map((entity) => <EntityCard entity={entity} />)}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.2 Tenant Foundation</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {tenantFoundationEntities.map((entity) => <EntityCard entity={entity} />)}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.3 Master Data</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {masterEntities.map((entity) => <EntityCard entity={entity} />)}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.4 Inventory Ledger</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {inventoryEntities.map((entity) => <EntityCard entity={entity} />)}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.5 Procurement, SP & PBF Faktur</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {procurementEntities.map((entity) => <EntityCard entity={entity} />)}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.6 POS, Offline, Payments & Returns</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {posEntities.map((entity) => <EntityCard entity={entity} />)}
      </div>
    </div>

    <div class="space-y-4">
      <h3 class="text-xl font-bold text-zinc-950 dark:text-white">3.7 Compliance, Export & Audit</h3>
      <div class="grid gap-4 md:grid-cols-2">
        {complianceAndOpsEntities.map((entity) => <EntityCard entity={entity} />)}
      </div>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">4. Domain Invariants</h2>
    <div class="rounded-3xl border border-blue-200 bg-blue-50 p-6 dark:border-blue-900/70 dark:bg-blue-950/30">
      <ul class="list-disc space-y-2 pl-5 text-sm leading-7 text-blue-950 dark:text-blue-100">
        {invariants.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">5. Build Order Schema</h2>
    <div class="grid gap-3">
      {buildOrder.map((item, index) => (
        <div class="flex gap-3 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
            {index + 1}
          </div>
          <div class="text-sm leading-7 text-zinc-700 dark:text-zinc-300">{item}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="rounded-3xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900/70">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">Design Take</h2>
    <p class="mt-3 leading-8 text-zinc-700 dark:text-zinc-300">
      The ERD is intentionally heavier than a cashier-app schema because the PRD is ledger-first and SaaS-first. The critical separation is platform administration versus tenant pharmacy ownership. The critical pharmacy model is batch + movement ledger, with SP, PBF invoice fields, SIPNAP-ready reports, offline POS sync, bon receivables, and audit trails built around that ledger instead of bolted on later.
    </p>
    <div class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
      <a class="rounded-full bg-white px-4 py-2 text-blue-700 shadow-sm dark:bg-zinc-900 dark:text-blue-300" href="/prd/apotek-management/">View PRD</a>
      <a class="rounded-full bg-white px-4 py-2 text-blue-700 shadow-sm dark:bg-zinc-900 dark:text-blue-300" href="/brd/apotek-management/">View BRD</a>
    </div>
  </section>
</BaseLayout>
