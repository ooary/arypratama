    fields: ["id PK", "tenant_id FK", "surat_pesanan_id FK", "purchase_order_item_id FK", "product_id FK", "unit_id FK", "qty", "qty_base"],
  },
  {
    name: "goods_receipts",
    tag: "Goods receipt",
    fields: ["id PK", "tenant_id FK", "receipt_no", "outlet_id FK", "warehouse_id FK", "supplier_id FK", "purchase_order_id FK", "surat_pesanan_id FK", "pbf_invoice_no", "invoice_date", "due_date", "received_at", "status", "received_by FK"],
  },
  {
