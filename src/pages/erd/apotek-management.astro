    fields: ["id PK", "tenant_id FK", "goods_receipt_id FK", "purchase_order_item_id FK", "product_id FK", "unit_id FK", "qty_received", "qty_received_base", "purchase_price", "discount_amount", "tax_amount", "batch_no", "expiry_date", "stock_batch_id FK"],
