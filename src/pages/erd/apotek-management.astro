  },
  {
    name: "stock_take_sessions",
    tag: "Stock take header",
    fields: ["id PK", "tenant_id FK", "outlet_id FK", "warehouse_id FK", "stock_take_no", "snapshot_at", "status", "started_by FK", "approved_by FK", "posted_by FK", "posted_at"],
  },
  {
