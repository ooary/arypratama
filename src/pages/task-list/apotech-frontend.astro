const lines = markdown.split("\n");
const checkedCount = (markdown.match(/- \[x\]/g) || []).length;
const openCount = (markdown.match(/- \[ \]/g) || []).length;
const totalCount = checkedCount + openCount;
const progress = totalCount ? Math.round((checkedCount / totalCount) * 100) : 0;

function lineKind(line: string) {
  if (line.startsWith("# ")) return "h1";
  if (line.startsWith("## ")) return "h2";
  if (line.startsWith("### ")) return "h3";
  if (line.startsWith("- [x] ")) return "done";
  if (line.startsWith("  - [x] ")) return "done-sub";
  if (line.startsWith("- [ ] ")) return "todo";
  if (line.startsWith("  - [ ] ")) return "todo-sub";
  if (line.startsWith("- ")) return "bullet";
  if (line.startsWith("|")) return "table";
  if (line.trim() === "---") return "hr";
  if (!line.trim()) return "blank";
  return "text";
}

const renderedLines = lines.map((line) => {
  const kind = lineKind(line);
  let text = line;
  if (kind === "h1") text = line.replace(/^# /, "");
  if (kind === "h2") text = line.replace(/^## /, "").replace(/^\*\*(.*)\*\*$/, "$1");
  if (kind === "h3") text = line.replace(/^### /, "");
  if (kind === "done") text = line.replace(/^- \[x\] /, "");
  if (kind === "todo") text = line.replace(/^- \[ \] /, "");
  if (kind === "done-sub") text = line.replace(/^  - \[x\] /, "");
  if (kind === "todo-sub") text = line.replace(/^  - \[ \] /, "");
  if (kind === "bullet") text = line.replace(/^- /, "");
  return { kind, raw: line, text };
});
