          {line.kind === "h2" && <h3 class="mt-8 rounded-2xl bg-slate-100 px-4 py-3 text-2xl font-bold text-slate-950 dark:bg-slate-900 dark:text-white">{line.text}</h3>}
          {line.kind === "h3" && <h4 class="mt-5 text-lg font-semibold text-slate-950 dark:text-white">{line.text}</h4>}
          {line.kind === "done" && <div class="flex gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-slate-700 dark:border-emerald-900/60 dark:bg-emerald-950/20 dark:text-slate-200"><span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-md bg-emerald-600 text-xs font-bold text-white">✓</span><span>{line.text}</span></div>}
          {line.kind === "todo" && <div class="flex gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200"><span class="mt-0.5 h-5 w-5 shrink-0 rounded-md border border-slate-400 dark:border-slate-600"></span><span>{line.text}</span></div>}
          {line.kind === "done-sub" && <div class="ml-6 flex gap-3 rounded-xl border border-emerald-100 bg-emerald-50/60 px-4 py-2 text-sm text-slate-700 dark:border-emerald-900/40 dark:bg-emerald-950/10 dark:text-slate-300"><span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded bg-emerald-600 text-[10px] font-bold text-white">✓</span><span>{line.text}</span></div>}
          {line.kind === "todo-sub" && <div class="ml-6 flex gap-3 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300"><span class="mt-0.5 h-4 w-4 shrink-0 rounded border border-slate-400 dark:border-slate-600"></span><span>{line.text}</span></div>}
          {line.kind === "bullet" && <p class="pl-4 text-sm leading-6 text-slate-600 dark:text-slate-300">• {line.text}</p>}
          {line.kind === "table" && <pre class="overflow-x-auto rounded-xl bg-slate-950 p-3 text-xs text-slate-100">{line.raw}</pre>}
          {line.kind === "text" && <p class="text-sm leading-7 text-slate-600 dark:text-slate-300">{line.text}</p>}
        </>
      ))}
    </section>
  </main>
</BaseLayout>
