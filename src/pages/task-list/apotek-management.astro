---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Task List — apoth.tech";
const description = "Backend-first implementation task list for apoth.tech, aligned with the PRD, ERD, and architecture. Each phase includes granular coding tasks, QA gates, and security tests.";

const phases = [
  {
    id: "1",
    title: "Phase 1 — Backend environment foundation",
    objective: "Create the private monorepo, FastAPI backend skeleton, local Docker environment, CI gates, and deploy path to apoth.arypratama.com.",
    tasks: [
      ["1.1", "Create private GitHub monorepo", "Create private repo for apoth.tech with backend/, frontend/, infra/, scripts/, docs/, README, .gitignore, and branch protection expectation."],
      ["1.2", "Create backend Python project", "Initialize backend/ with pyproject.toml, Python 3.12+, FastAPI, uvicorn, pydantic v2, pydantic-settings, SQLAlchemy 2.0, Alembic, psycopg, loguru, bson, pytest, ruff, and pyright."],
      ["1.3", "Create FastAPI app shell", "Create app/main.py, app/api/v1/router.py, /health endpoint, /version endpoint, and structured JSON error response format."],
      ["1.4", "Create config module", "Create app/core/config.py using pydantic-settings for DATABASE_URL, APP_ENV, APP_URL, CORS_ORIGINS, SECRET_KEY, and LOG_LEVEL."],
      ["1.5", "Create database module", "Create app/core/database.py with SQLAlchemy engine/session factory and dependency for request-scoped DB sessions."],
      ["1.6", "Create BSON ID utility", "Create app/core/id.py with new_id(), is_valid_id(), and reusable SQLAlchemy default callable. Store IDs as String(24)."],
      ["1.7", "Create logging setup", "Create app/core/logging.py using Loguru with request_id, tenant_id, user_id placeholders, and JSON logs for production."],
      ["1.8", "Create Alembic setup", "Initialize migrations, configure metadata import, create first empty migration, and document migration commands."],
      ["1.9", "Create Docker Compose", "Add postgres service, backend service, network, volumes, env file support, and health checks."],
      ["1.10", "Create Makefile/scripts", "Add commands: setup, dev, test, lint, typecheck, migrate, makemigration, reset-db, seed."],
      ["1.11", "Create CI workflow", "GitHub Actions runs backend install, ruff, pyright moderate, pytest, and Alembic migration check."],
      ["1.12", "Create review deploy workflow skeleton", "Add GitHub Actions job outline for SSH deploy to VPS and target host apoth.arypratama.com; leave secrets as required setup."],
    ],
    qa: ["Fresh clone can run local backend with one documented command.", "GET /health returns 200 locally and in Docker.", "Alembic can upgrade an empty database.", "CI fails if lint/test/typecheck fails."],
    security: ["No secrets committed; .env.example only.", "CORS is not wildcard in non-local env.", "DATABASE_URL never logged.", "Dependency audit baseline captured."],
  },
  {
    id: "2",
    title: "Phase 2 — Tenant, auth, RBAC foundation",
    objective: "Build SaaS tenant boundary before any pharmacy data exists.",
    tasks: [
      ["2.1", "Create tenant models", "Create tenants, plans, tenant_subscriptions, tenant_config_flags migrations and SQLAlchemy models."],
      ["2.2", "Create tenant users", "Create tenant_users with bson id, tenant_id, email, phone, password_hash, mfa_enabled, status, last_login_at."],
      ["2.3", "Create platform admin models", "Create platform_admin_users, platform_roles, platform_user_roles, platform_audit_logs."],
      ["2.4", "Create RBAC models", "Create tenant_roles, permissions, tenant_user_roles, role_permissions, user_outlet_access."],
      ["2.5", "Seed permission catalog", "Seed default permissions for tenant, users, master_data, inventory, procurement, pos, reports, export, audit, config."],
      ["2.6", "Seed default roles", "Create Owner, Pharmacist/Admin, Cashier, Warehouse/Procurement, Read-only Accountant, Support roles."],
      ["2.7", "Implement password hashing", "Create app/core/security.py with password hash/verify and token helpers."],
      ["2.8", "Implement tenant registration API", "POST /auth/register creates tenant, owner user, default subscription, default config flags, default outlet placeholder later, and default roles."],
      ["2.9", "Implement login API", "POST /auth/login returns session/access token with tenant context and role claims."],
      ["2.10", "Implement tenant context dependency", "Resolve current tenant from auth context and expose require_tenant() dependency."],
      ["2.11", "Implement permission dependency", "Create require_permission(code) dependency and tests for allowed/denied paths."],
      ["2.12", "Implement platform admin auth skeleton", "Separate login/session path for Platform Admin, not tenant user."],
      ["2.13", "Implement support access session model", "Create support_access_sessions and API skeleton requiring tenant owner approval, reason, expiry, and audit log."],
    ],
    qa: ["Register tenant creates tenant and owner user.", "Owner can login and receive tenant context.", "Default roles and permissions are seeded idempotently.", "Tenant user cannot call platform admin endpoint."],
    security: ["Tenant isolation tests prove tenant A cannot read/write tenant B.", "Password hashes are never returned by API.", "Platform Admin is not a tenant role.", "Suspended tenant behavior is tested as read-only except allowed operations."],
  },
  {
    id: "3",
    title: "Phase 3 — Apotek/outlet and warehouse foundation",
    objective: "Keep ERD outlet concept but treat it as Apotek in product language. Create one default apotek/outlet and warehouse per tenant.",
    tasks: [
      ["3.1", "Create outlets migration", "Create outlets table with tenant_id, name, address, phone, timezone, is_default, status. UI label later: Apotek."],
      ["3.2", "Create warehouses migration", "Create warehouses with tenant_id, outlet_id, name, warehouse_type, is_default, status."],
      ["3.3", "Create pharmacy profile migration", "Create pharmacy_profiles with tenant_id, outlet_id, pharmacy_name, license_no, pharmacist_in_charge, SIPA/SIA fields, receipt header/footer."],
      ["3.4", "Create document numbering migration", "Create document_number_series with tenant_id, outlet_id, document_type, prefix, next_number, reset_policy."],
      ["3.5", "Auto-create default apotek", "Update tenant registration service to create default outlet named Main Apotek and default warehouse named Main Warehouse."],
      ["3.6", "Build apotek profile API", "CRUD endpoints for current tenant apotek profile; no multi-outlet UI assumptions yet."],
      ["3.7", "Build warehouse API", "List/create/update warehouse under current tenant/outlet with guard against deleting warehouse with stock later."],
      ["3.8", "Build document number service", "Generate tenant-safe document numbers for PO, SP, goods receipt, stock movement, sale, return, and transfer."],
    ],
    qa: ["New tenant has exactly one default outlet/apotek and one default warehouse.", "Document number generation is sequential per tenant and document type.", "Warehouse list only shows current tenant data."],
    security: ["Cross-tenant outlet_id/warehouse_id in request is rejected.", "Document number generation cannot leak another tenant's sequence.", "Profile update is permission-gated."],
  },
  {
    id: "4",
    title: "Phase 4 — Master data backend",
    objective: "Build product, supplier/PBF, unit, conversion, pricing, payment method, and customer foundations before stock exists.",
    tasks: [
      ["4.1", "Create product reference migrations", "Create product_categories, drug_classes, manufacturers."],
      ["4.2", "Create product migration", "Create products with tenant_id, sku, barcode, name, generic_name, composition, dosage_form, strength, classification flags, base_unit_id, min_stock_base, status."],
      ["4.3", "Create unit migrations", "Create product_units and product_unit_conversions with multiplier_to_base and locked_after_movement flag."],
      ["4.4", "Create pricing migrations", "Create product_prices and price_change_logs with effective dates and change reason."],
      ["4.5", "Create supplier migrations", "Create suppliers and supplier_products for multi-PBF mapping, last purchase price, lead time, preferred supplier."],
      ["4.6", "Create product locations migration", "Create product_locations for warehouse rack/bin."],
      ["4.7", "Create payment/customer migrations", "Create payment_methods, customer_groups, customers."],
      ["4.8", "Seed drug classes", "Seed regular, obat keras, narkotika, psikotropika, precursor with SP/SIPNAP flags."],
      ["4.9", "Build product CRUD API", "Tenant-scoped endpoints with validation for duplicate SKU/barcode and required base unit."],
      ["4.10", "Build unit conversion service", "Validate conversion chains, prevent circular conversion, and block unsafe changes after movements exist."],
      ["4.11", "Build supplier/PBF API", "CRUD suppliers and product-supplier mapping."],
      ["4.12", "Build pricing API", "Set product price, version price changes, require reason if config enabled."],
    ],
    qa: ["Can create product with base unit and selling unit.", "Duplicate barcode within same tenant is rejected.", "Product can map to multiple suppliers.", "Price change creates price_change_logs row."],
    security: ["Master data APIs filter tenant_id on every query.", "Cashier role cannot change price unless permission allows.", "Regulated product flags require privileged role."],
  },
  {
    id: "5",
    title: "Phase 5 — Stock batch and movement ledger",
    objective: "Implement the inventory source of truth before POS, procurement, reports, or stock take.",
    tasks: [
      ["5.1", "Create stock_batches migration", "Fields: tenant_id, outlet_id, warehouse_id, product_id, batch_no, expiry_date, qty_available_base, qty_quarantined_base, hpp_per_base, source_type, source_id, status."],
      ["5.2", "Create stock_movements migration", "Fields: tenant_id, movement_no, outlet_id, warehouse_id, product_id, batch_id, movement_type, direction, qty_base, balance_after_base, reference_type, reference_id, reason, created_by."],
      ["5.3", "Create stock posting service", "Central service that validates tenant, product, warehouse, unit conversion, and movement type."],
      ["5.4", "Implement opening stock posting", "Create stock batch and opening_stock movement from opening stock command."],
      ["5.5", "Implement movement immutability", "Application blocks edit/delete of posted movements; corrections use adjustment/reversal movement."],
      ["5.6", "Implement FEFO allocation service", "Allocate outgoing stock by earliest expiry, excluding quarantined/expired/unavailable stock."],
      ["5.7", "Implement negative stock guard", "Block negative stock unless audited override flag exists; default false."],
      ["5.8", "Implement stock card query", "Return opening, incoming, outgoing, adjustment, transfer, quarantine, disposal, closing by date range."],
      ["5.9", "Implement concurrency test", "Simulate two transactions selling final batch and prove only one succeeds."],
    ],
    qa: ["Opening stock creates batch and movement.", "Stock card reconciles to batch quantity.", "FEFO allocation chooses earliest expiry.", "Posted movement cannot be edited by normal API."],
    security: ["All stock posting requires permission.", "Every correction requires reason and actor.", "Cross-tenant product/warehouse/batch IDs are rejected in one request."],
  },
  {
    id: "6",
    title: "Phase 6 — Opening stock and stock APIs",
    objective: "Expose usable backend APIs for first operational stock setup without building the frontend yet.",
    tasks: [
      ["6.1", "Create opening stock API", "POST /inventory/opening-stock accepts product, warehouse, batch, expiry, qty, unit, cost and posts ledger."],
      ["6.2", "Create stock batch list API", "GET stock batches by product, warehouse, expiry window, status."],
      ["6.3", "Create stock card API", "GET stock card by product/warehouse/date range from stock movements."],
      ["6.4", "Create low stock API", "List products below min_stock_base using batch projections."],
      ["6.5", "Create near expiry API", "List batches expiring within configurable expiry_warning_days."],
      ["6.6", "Add API examples", "Document curl/http examples for product -> opening stock -> stock card happy path."],
    ],
    qa: ["API happy path can create tenant, product, opening stock, and stock card via automated integration test.", "Near-expiry filter returns correct batches.", "Low-stock calculation ignores quarantined stock."],
    security: ["Opening stock endpoint is blocked for Cashier role.", "Stock card cannot query another tenant by guessing IDs.", "Audit log records opening stock posting."],
  },
  {
    id: "7",
    title: "Phase 7 — Procurement backend",
    objective: "Build the procurement path that creates stock through controlled receipt instead of manual stock edits.",
    tasks: [
      ["7.1", "Create defecta migrations", "Create defecta_items with low-stock/manual source, recommended qty, pending PO qty, status."],
      ["7.2", "Create PO migrations", "Create purchase_orders and purchase_order_items with approval fields and partial receipt tracking."],
      ["7.3", "Create SP migrations", "Create surat_pesanan and surat_pesanan_items for obat keras, narkotika, psikotropika, precursor."],
      ["7.4", "Create goods receipt migrations", "Create goods_receipts and goods_receipt_items with PBF invoice fields, batch, expiry, price, discount, tax."],
      ["7.5", "Create supplier invoice migrations", "Create supplier_invoices and supplier_payments for finance-lite payable tracking."],
      ["7.6", "Build defecta service", "Generate low-stock suggestions and allow manual defecta creation."],
      ["7.7", "Build PO service", "Create PO from defecta/manual lines, support require_po_approval config."],
      ["7.8", "Build SP service", "Generate required SP documents for regulated items and block receipt if missing when config enabled."],
      ["7.9", "Build goods receipt service", "Receive full or partial PO lines; create/update stock batch and purchase_receive movements."],
      ["7.10", "Build PO aging API", "Return open, partial, overdue, closed, canceled PO states."],
    ],
    qa: ["Partial receipt keeps remaining PO qty open.", "Regulated item requires SP before receipt finalization.", "Goods receipt creates purchase_receive movements and updates stock batch."],
    security: ["Supplier invoice numbers are tenant-scoped unique where required.", "Receipt posting is atomic: no stock movement without receipt row.", "Override of missing SP requires privileged role and audit reason."],
  },
  {
    id: "8",
    title: "Phase 8 — Online POS backend",
    objective: "Build server-authoritative sale posting before offline POS or frontend cashier UI.",
    tasks: [
      ["8.1", "Create POS migrations", "Create pos_devices, shifts, sales, sale_items, sale_item_batch_allocations, sale_payments."],
      ["8.2", "Create receivable migrations", "Create customer_receivables and receivable_payments for bon/hutang pelanggan."],
      ["8.3", "Build shift service", "Open shift, close shift, calculate expected cash, non-cash totals, bon, refunds, variance."],
      ["8.4", "Build sale posting command schema", "One request shape for online and future offline sync: local_sale_id, idempotency_key, cart, payments, customer, gate notes."],
      ["8.5", "Build sale posting service", "Validate shift, permission, product status, price, payment totals, bon rules, regulated gate, FEFO allocation, and transactionally create sale + movements."],
      ["8.6", "Build mixed payment support", "Allow multiple sale_payments rows across cash, QRIS, card, transfer, custom methods."],
      ["8.7", "Build bon support", "If allow_partial_payment true and customer selected, create customer_receivable for outstanding amount."],
      ["8.8", "Build regulated gate support", "Require pharmacist approval or prescription note for flagged products when config enabled."],
      ["8.9", "Build receipt response", "Return canonical sale_no, payment summary, stock allocation, and receipt payload."],
    ],
    qa: ["Normal sale posts sale, payment, batch allocation, and stock movement in one transaction.", "Mixed payment totals must equal paid amount rules.", "Bon without customer is rejected.", "Regulated product without gate is rejected."],
    security: ["Cashier cannot sell under closed shift.", "Idempotency prevents duplicate sale posting.", "POS sale cannot deduct another tenant's batch."],
  },
  {
    id: "9",
    title: "Phase 9 — Reports, audit, export backend",
    objective: "Make backend outputs auditable and measurable after ledger and POS/procurement exist.",
    tasks: [
      ["9.1", "Create audit log migration", "Create audit_logs with tenant_id, actor_user_id, support_session_id, action, entity, before/after, reason, IP, timestamp."],
      ["9.2", "Create audit service", "Reusable service called by sensitive workflows: stock, price, role, config, POS void/refund, bon, regulated gate, export."],
      ["9.3", "Create regulated report migrations", "Create regulated_monthly_reports and regulated_report_lines generated from stock_movements."],
      ["9.4", "Build SIPNAP-ready export service", "Generate monthly CSV/XLSX/PDF-ready data for narkotika/psikotropika movements."],
      ["9.5", "Build dashboard APIs", "Owner/admin/cashier/procurement summary endpoints from ledger and sales data."],
      ["9.6", "Build data export migrations", "Create data_export_jobs and attachment/file metadata if needed."],
      ["9.7", "Build tenant export job", "Async export package for products, suppliers, customers, stock batches, movements, purchases, sales, payments, shifts, config, audit logs."],
    ],
    qa: ["Reports reconcile to stock_movements.", "SIPNAP monthly export balances opening + incoming - outgoing +/- adjustment = closing.", "Export job creates machine-readable files."],
    security: ["Export request and download are audited.", "Sensitive regulated records are permission-gated.", "Support impersonation actions link to support_session_id."],
  },
  {
    id: "10",
    title: "Phase 10 — Offline sync backend and frontend foundation",
    objective: "Prepare offline POS after online sale posting is stable. Dexie stores commands; server validates and posts canonical ledger.",
    tasks: [
      ["10.1", "Create offline sync migration", "Create offline_sync_queue with tenant_id, pos_device_id, local_event_id, payload_json, idempotency_key, sync_status, conflict_reason, server_entity_id."],
      ["10.2", "Build device authorization API", "Register POS devices, enable/disable offline mode, store last_sync_at."],
      ["10.3", "Build cache snapshot API", "Return tenant-scoped product, unit, price, payment method, config, and stock snapshot for POS cache."],
      ["10.4", "Build offline sync endpoint", "POST queued sale command with idempotency key; same validation path as online sale posting."],
      ["10.5", "Build conflict response model", "Return insufficient_stock, product_inactive, price_changed, batch_expired, gate_missing, shift_closed, duplicate_local_sale, device_not_authorized."],
      ["10.6", "Create frontend skeleton", "Create frontend/ with Vite, React, TypeScript, Bun, Tailwind, route shells for Admin Zone, Tenant Zone, POS App."],
      ["10.7", "Create Dexie schema", "Create local tables for product cache, price cache, active shift snapshot, cart draft, offline sale queue, receipt queue, sync conflicts."],
    ],
    qa: ["Offline sync endpoint posts valid queued sale once.", "Same idempotency key + same payload returns original result.", "Same idempotency key + different payload is rejected.", "Conflict is persisted and visible to API consumer."],
    security: ["Offline cache API only returns current tenant/outlet permitted data.", "Tenant suspension blocks sync except configured recovery path.", "Device key/hash is required for offline sync."],
  },
];

const globalGates = [
  "No phase can skip tenant isolation tests once tenant-owned tables exist.",
  "No stock-affecting feature may bypass backend/app/services/inventory/stock_posting_service.py.",
  "No posted stock_movement can be edited or deleted through normal API.",
  "Every sensitive operation must either write audit_logs or platform_audit_logs.",
  "Frontend work must not start serious forms until backend API response and error conventions are stable.",
];

const links = [["Architecture", "/architecture/apotek-management/"], ["PRD", "/prd/apotek-management/"], ["ERD", "/erd/apotek-management/"], ["BRD", "/brd/apotek-management/"]];
---

<BaseLayout title={title} description={description}>
  <section class="space-y-6">
    <div class="inline-flex rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-bold text-blue-700 dark:border-blue-900/70 dark:bg-blue-950/40 dark:text-blue-300">Implementation Task List</div>
    <h1 class="text-4xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">apoth.tech Backend-First Task List</h1>
    <p class="max-w-4xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">Granular coding plan for apoth.tech. This plan keeps the PRD/ERD direction but cuts MVP complexity: backend first, one default outlet shown as Apotek, one default warehouse, ledger-first inventory, POS after ledger, offline sync after online POS.</p>
    <div class="flex flex-wrap gap-3 text-sm font-semibold">
      {links.map(([label, href]) => <a class="rounded-full bg-white px-4 py-2 text-blue-700 shadow-sm dark:bg-zinc-900 dark:text-blue-300" href={href}>{label}</a>)}
    </div>
  </section>

  <section class="rounded-3xl border border-amber-200 bg-amber-50 p-6 dark:border-amber-900/70 dark:bg-amber-950/30">
    <h2 class="text-2xl font-bold text-amber-950 dark:text-amber-100">Execution rule</h2>
    <p class="mt-3 leading-8 text-amber-950 dark:text-amber-100">Do not build the pretty admin UI first. The product risk is tenant isolation and ledger correctness. Backend APIs, migrations, and tests come first. Frontend can follow once contracts are stable.</p>
  </section>

  <section class="space-y-6">
    <h2 class="text-2xl font-bold text-zinc-950 dark:text-white">Global gates</h2>
    <ul class="rounded-3xl border border-zinc-200 bg-white p-6 list-disc space-y-2 pl-10 text-sm leading-7 text-zinc-700 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
      {globalGates.map((gate) => <li>{gate}</li>)}
    </ul>
  </section>

  <section class="space-y-8">
    {phases.map((phase) => (
      <article class="rounded-3xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <p class="text-sm font-bold uppercase tracking-wide text-blue-600 dark:text-blue-300">Phase {phase.id}</p>
        <h2 class="mt-1 text-2xl font-bold text-zinc-950 dark:text-white">{phase.title}</h2>
        <p class="mt-2 leading-7 text-zinc-700 dark:text-zinc-300">{phase.objective}</p>

        <div class="mt-6 space-y-3">
          {phase.tasks.map(([id, name, detail]) => (
            <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-800 dark:bg-zinc-950/60">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-zinc-950 px-2.5 py-1 text-xs font-bold text-white dark:bg-zinc-100 dark:text-zinc-950">{id}</span>
                <h3 class="font-semibold text-zinc-950 dark:text-white">{name}</h3>
              </div>
              <p class="mt-2 text-sm leading-6 text-zinc-700 dark:text-zinc-300">{detail}</p>
            </div>
          ))}
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-900/70 dark:bg-emerald-950/30">
            <h3 class="font-bold text-emerald-950 dark:text-emerald-100">QA gate</h3>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-emerald-950 dark:text-emerald-100">
              {phase.qa.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="rounded-2xl border border-red-200 bg-red-50 p-5 dark:border-red-900/70 dark:bg-red-950/30">
            <h3 class="font-bold text-red-950 dark:text-red-100">Security test</h3>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-red-950 dark:text-red-100">
              {phase.security.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
