---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Lite Task List — Apotek Management System";
const description = "Lite execution tracker for the Apotek Management System MVP: task status, reviewers, worker comments, and acceptance gates.";

type Status = "not_yet" | "in_progress" | "under_review" | "done" | "blocked";

type Comment = {
  agent: string;
  tone: "build" | "review" | "security" | "orchestrator" | "design";
  body: string;
};

type Task = {
  id: string;
  title: string;
  owner: string;
  status: Status;
  summary: string;
  artifacts: string[];
  acceptance: string[];
  comments: Comment[];
};

const statusMeta: Record<Status, { label: string; badge: string; dot: string }> = {
  not_yet: {
    label: "Not Yet",
    badge: "border-zinc-200 bg-zinc-100 text-zinc-700 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300",
    dot: "bg-zinc-400",
  },
  in_progress: {
    label: "In Progress",
    badge: "border-amber-200 bg-amber-100 text-amber-800 dark:border-amber-800 dark:bg-amber-950/50 dark:text-amber-200",
    dot: "bg-amber-500",
  },
  under_review: {
    label: "Under Review",
    badge: "border-blue-200 bg-blue-100 text-blue-800 dark:border-blue-800 dark:bg-blue-950/50 dark:text-blue-200",
    dot: "bg-blue-500",
  },
  done: {
    label: "Done",
    badge: "border-emerald-200 bg-emerald-100 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-200",
    dot: "bg-emerald-500",
  },
  blocked: {
    label: "Blocked",
    badge: "border-red-200 bg-red-100 text-red-800 dark:border-red-800 dark:bg-red-950/50 dark:text-red-200",
    dot: "bg-red-500",
  },
};

const commentTone: Record<Comment["tone"], string> = {
  build: "border-sky-200 bg-sky-50 text-sky-950 dark:border-sky-900/70 dark:bg-sky-950/30 dark:text-sky-100",
  review: "border-violet-200 bg-violet-50 text-violet-950 dark:border-violet-900/70 dark:bg-violet-950/30 dark:text-violet-100",
  security: "border-red-200 bg-red-50 text-red-950 dark:border-red-900/70 dark:bg-red-950/30 dark:text-red-100",
  orchestrator: "border-zinc-200 bg-zinc-50 text-zinc-800 dark:border-zinc-800 dark:bg-zinc-950/60 dark:text-zinc-200",
  design: "border-emerald-200 bg-emerald-50 text-emerald-950 dark:border-emerald-900/70 dark:bg-emerald-950/30 dark:text-emerald-100",
};

const tasks: Task[] = [
  {
    id: "T0",
    title: "PRD MVP reset and scope lock",
    owner: "BIMA + Bonbon",
    status: "done",
    summary: "Replace the overbuilt enterprise PRD with a stock-first MVP contract: Excel onboarding, product master, batch/expiry, append-only movements, dashboard, simple POS, role-gated admin/cashier surfaces.",
    artifacts: [
      "Live PRD: /prd/apotek-management-mvp/",
      "Commit: 0758536 initial MVP PRD",
      "Commit: e0aec1e sharpen acceptance/API notes",
      "Commit: 8ced5fa define admin roles and access",
    ],
    acceptance: [
      "Brand remains Apotek Management System.",
      "MVP excludes procurement, SIPNAP, multi-outlet, billing, offline sync, and platform-admin SaaS features.",
      "Backend layering convention is explicit: models, schemas, services, api/routes.",
    ],
    comments: [
      {
        agent: "BIMA",
        tone: "review",
        body: "PRD needed explicit admin/cashier split. Owner is admin in MVP; cashier gets POS/read-only operational surface. Admin-only endpoints must return 403 for cashier.",
      },
      {
        agent: "Bonbon",
        tone: "orchestrator",
        body: "Scope is now buildable. POS stays P0 because stock data dies if daily sales are not recorded in the app.",
      },
    ],
  },
  {
    id: "T0.5",
    title: "Design review artifact",
    owner: "MUTIA brief + Bonbon build",
    status: "done",
    summary: "Publish design review page for the operational/POS side: mobile-first mockups, nav model, components, visual language, and implementation handoff.",
    artifacts: [
      "Live design: /design/apotek-management/",
      "Commit: bfb00f4 docs: add apotek design review page",
    ],
    acceptance: [
      "Page builds with Astro/Tailwind.",
      "Shows Dashboard, POS, Barang, Stok Masuk, Import Excel, Koreksi flows.",
      "Admin console design is acknowledged as separate follow-up, not hidden inside POS flow.",
    ],
    comments: [
      {
        agent: "MUTIA",
        tone: "design",
        body: "Direction: Space Mono/site vocabulary, zinc + emerald palette, dark-compatible, mobile-first, phone-frame mockups, product UI can use system sans for app feel.",
      },
      {
        agent: "Bonbon",
        tone: "orchestrator",
        body: "MUTIA hit repeated write_file truncation, so I stopped the worker and shipped a compact page manually from the brief.",
      },
    ],
  },
  {
    id: "T1",
    title: "Backend Wave 0 — auth, users, RBAC foundation",
    owner: "RAKA",
    status: "under_review",
    summary: "Build FastAPI backend foundation for auth/user management. RAKA's first commit was rejected by BASKARA/SATRIA; RAKA has now committed a hardening fix and it needs final review against current HEAD.",
    artifacts: [
      "Repo: /root/projects/apoth",
      "Commit: 32ceec8 feat: add backend auth foundation",
      "Fix commit: 0ac605e fix: harden auth RBAC foundation",
      "Current blocker: Kanban SQLite board corrupted; reviewer status must be recovered or rerun directly.",
    ],
    acceptance: [
      "Schemas contain Pydantic contracts only; no DB/session/JWT/hash/business logic.",
      "DB shape lives in models; business logic lives in services; routing stays in api.",
      "Create cashier → login → admin endpoint returns 403.",
      "No roleless user can get owner fallback.",
      "PATCH user role persists TenantUserRole transactionally.",
      "TenantUser.name persists and is returned from DB.",
      "Login failures are opaque; password policy is consistent; disable/password change invalidates sessions or tokens.",
      "DB-backed regression tests pass with Postgres running.",
    ],
    comments: [
      {
        agent: "RAKA",
        tone: "build",
        body: "Initial implementation added /auth/me, /auth/change-password, /users GET/POST/PATCH, admin guard, cashier 403 tests, and user schemas/services. Full ruff + pytest passed locally before review.",
      },
      {
        agent: "SATRIA",
        tone: "security",
        body: "REQUEST_CHANGES on first pass: critical privilege escalation. Role lookup compared lowercase role code to display name, no role row was inserted, then login fell back to owner. Also flagged silent role patch, user enumeration, session revocation, and password policy mismatch.",
      },
      {
        agent: "BASKARA",
        tone: "review",
        body: "REQUEST_CHANGES on first pass: role update was returned but not persisted; TenantUser had no name column; tests mocked services so DB persistence bugs were invisible. Layering itself mostly passed.",
      },
      {
        agent: "RAKA",
        tone: "build",
        body: "Fix commit 0ac605e: added TenantRole.code, removed owner fallback, persisted TenantUser.name, made role updates replace TenantUserRole, added session revocation, aligned password min to 12, and added DB-backed regression tests. Postgres was not running, so DB regression tests still need verification.",
      },
      {
        agent: "Bonbon",
        tone: "orchestrator",
        body: "Do not mark T1 done until BASKARA and SATRIA review 0ac605e or I rerun direct reviews outside Kanban. Kanban board is currently corrupt, so this tracker becomes the source of truth until repaired.",
      },
    ],
  },
  {
    id: "A1",
    title: "Admin Backend API — dashboard, settings, audit, and reports",
    owner: "RAKA + SATRIA/BASKARA review",
    status: "not_yet",
    summary: "Make the admin surface explicit instead of hiding it inside core backend tasks. This track exposes owner/admin operations after auth/RBAC is accepted and before serious admin UI work starts.",
    artifacts: ["Planned after T1 acceptance; shares models/services with T2/T3/T5."],
    acceptance: [
      "Admin dashboard API returns low stock, near expiry, expired, no-expiry, sales summary, and inventory value where allowed.",
      "Admin user management API supports create/deactivate/reset password/change role with self-demotion protection.",
      "Admin settings/profile API supports apotek profile, expiry warning days, payment methods, and basic operational config.",
      "Audit log API exposes sensitive admin actions with actor, reason, entity, before/after where applicable.",
      "Cashier cannot access cost, inventory value, user management, settings, export, or audit endpoints.",
    ],
    comments: [
      {
        agent: "Bonbon",
        tone: "orchestrator",
        body: "Admin backend API was previously spread across T1/T2/T3/T5. This task makes it visible so we don't accidentally build only POS and forget owner/admin operations.",
      },
      {
        agent: "SATRIA",
        tone: "security",
        body: "Review focus: permission boundaries, cashier data leakage, self-role changes, export access, and audit coverage for sensitive admin actions.",
      },
      {
        agent: "BASKARA",
        tone: "review",
        body: "Review focus: routes stay thin, business logic stays in services, schemas remain Pydantic contracts, and dashboard/report queries do not duplicate ledger rules.",
      },
    ],
  },
  {
    id: "A2",
    title: "Admin Frontend — shell, login, dashboard, and management screens",
    owner: "MUTIA design + frontend worker later",
    status: "not_yet",
    summary: "Build the admin app after backend contracts stabilize: shell/navigation, auth session handling, dashboard, users, products, stock receive/adjust/import, reports, exports, and settings.",
    artifacts: ["Planned after T1 + relevant Admin Backend API contracts."],
    acceptance: [
      "Admin shell has clear navigation separate from cashier POS mode.",
      "Login/session UI uses /auth/me and handles expired/forbidden states cleanly.",
      "User management UI calls real admin APIs and displays role/status changes from persisted data.",
      "Product, stock, import, reports, and settings screens use backend contracts; no fake local-only admin flows.",
      "Cashier role cannot see admin navigation when logged in.",
    ],
    comments: [
      {
        agent: "MUTIA",
        tone: "design",
        body: "Admin UI should be operational and boring: dense tables, clear filters, safe destructive actions, and no visual gimmicks that slow pharmacy staff down.",
      },
      {
        agent: "Bonbon",
        tone: "orchestrator",
        body: "Frontend can start as shells/mock states, but serious forms wait for API contracts. Otherwise we'll spend time rewriting UI against moving backend semantics.",
      },
    ],
  },
  {
    id: "T2",
    title: "Backend Wave 1 — product catalog",
    owner: "RAKA",
    status: "not_yet",
    summary: "Create product catalog backend after auth/RBAC is accepted. This is intentionally blocked by T1 because permissions and tenant context are prerequisites.",
    artifacts: ["Planned next after T1 acceptance."],
    acceptance: [
      "Product model and migration exist.",
      "SKU unique per tenant; barcode optional unique per tenant.",
      "Search by name/SKU/barcode works.",
      "Admin can create/update; cashier can list/read only.",
      "No products.stock column and no stock mutation in product endpoints.",
    ],
    comments: [
      {
        agent: "Bonbon",
        tone: "orchestrator",
        body: "Next task, but not before auth/RBAC review passes. If we build product CRUD on broken permissions, every later endpoint inherits the mistake.",
      },
    ],
  },
  {
    id: "T3",
    title: "Backend Wave 2 — stock batch and movement ledger",
    owner: "RAKA + BASKARA review",
    status: "not_yet",
    summary: "Implement the inventory source of truth: stock_batches projection plus append-only stock_movements ledger.",
    artifacts: ["Planned after Product Catalog."],
    acceptance: [
      "Receiving stock creates batch and IN movement.",
      "Adjustment requires reason and writes movement.",
      "On-hand reconciles from movements/projection.",
      "Negative stock is blocked.",
      "Concurrent final-unit consumption allows exactly one success.",
    ],
    comments: [
      {
        agent: "Bonbon",
        tone: "orchestrator",
        body: "This is the real product core. No POS/import/dashboard should bypass stock service once this exists.",
      },
    ],
  },
  {
    id: "T4",
    title: "Backend Wave 3 — simple POS sale posting",
    owner: "RAKA + SATRIA review",
    status: "not_yet",
    summary: "Server-authoritative sale posting: create sale, allocate FEFO batches, decrement stock projection, append movements, create payment rows, commit atomically.",
    artifacts: ["Planned after ledger core."],
    acceptance: [
      "Sale posting is atomic.",
      "FEFO allocation works and splits across batches.",
      "Idempotency-Key prevents duplicate sale.",
      "Cashier cannot override negative stock or admin-only void rules.",
    ],
    comments: [
      {
        agent: "Bonbon",
        tone: "orchestrator",
        body: "POS is P0, but only after ledger exists. Otherwise it becomes a fake cashier screen that cannot be trusted.",
      },
    ],
  },
  {
    id: "T5",
    title: "Backend Wave 4 — Excel import and dashboard/export APIs",
    owner: "RAKA",
    status: "not_yet",
    summary: "Excel onboarding, validation preview, import commit, owner dashboard, and export APIs.",
    artifacts: ["Planned after product + ledger basics."],
    acceptance: [
      "Dry-run returns row-level errors without writing data.",
      "Commit writes products/batches/movements transactionally.",
      "Dashboard shows low stock, near expired, expired, no-expiry, inventory value admin-only.",
      "Exports are admin-only and do not leak cost to cashier.",
    ],
    comments: [
      {
        agent: "Bonbon",
        tone: "orchestrator",
        body: "Excel import is onboarding wedge, but it should write through the same services as manual product/stock creation.",
      },
    ],
  },
];

const counts = Object.keys(statusMeta).map((status) => ({
  status: status as Status,
  count: tasks.filter((task) => task.status === status).length,
}));

const links = [
  ["MVP PRD", "/prd/apotek-management-mvp/"],
  ["Design", "/design/apotek-management/"],
  ["Full old task list", "/task-list/apotek-management/"],
  ["Old PRD / north star", "/prd/apotek-management/"],
];
---

<BaseLayout title={title} description={description}>
  <section class="space-y-6">
    <div class="inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-bold text-emerald-700 dark:border-emerald-900/70 dark:bg-emerald-950/40 dark:text-emerald-300">Lite Execution Tracker</div>
    <div class="max-w-5xl space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-950 dark:text-white sm:text-5xl">Apotek Management System Lite Task List</h1>
      <p class="text-lg leading-8 text-zinc-600 dark:text-zinc-300">A focused tracker for the MVP build. It mirrors Kanban status, but includes the important part Kanban hides: reviewer comments, agent handoffs, and acceptance gates.</p>
    </div>
    <div class="flex flex-wrap gap-3 text-sm font-semibold">
      {links.map(([label, href]) => <a class="rounded-full bg-white px-4 py-2 text-emerald-700 shadow-sm dark:bg-zinc-900 dark:text-emerald-300" href={href}>{label}</a>)}
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {counts.map(({ status, count }) => {
        const meta = statusMeta[status];
        return (
          <div class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex items-center gap-2">
              <span class={`h-2.5 w-2.5 rounded-full ${meta.dot}`}></span>
              <span class={`rounded-full border px-2.5 py-1 text-xs font-bold ${meta.badge}`}>{meta.label}</span>
            </div>
            <p class="mt-3 text-3xl font-black text-zinc-950 dark:text-white">{count}</p>
            <p class="text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400">tasks</p>
          </div>
        );
      })}
    </div>
  </section>

  <section class="rounded-3xl border border-red-200 bg-red-50 p-6 dark:border-red-900/70 dark:bg-red-950/30">
    <h2 class="text-2xl font-bold text-red-950 dark:text-red-100">Current rule</h2>
    <p class="mt-3 leading-8 text-red-950 dark:text-red-100">Task 1 is not done until RAKA's auth/RBAC hardening commit passes BASKARA clean-architecture review and SATRIA security review. Admin Backend API and product catalog start only after that gate passes.</p>
  </section>

  <section class="space-y-6">
    {tasks.map((task) => {
      const meta = statusMeta[task.status];
      return (
        <article class="overflow-hidden rounded-3xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div class="border-b border-zinc-100 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-950/60">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full bg-zinc-950 px-3 py-1 text-xs font-bold text-white dark:bg-white dark:text-zinc-950">{task.id}</span>
              <span class={`rounded-full border px-3 py-1 text-xs font-bold ${meta.badge}`}>{meta.label}</span>
              <span class="rounded-full border border-zinc-200 px-3 py-1 text-xs font-bold text-zinc-600 dark:border-zinc-700 dark:text-zinc-300">Owner: {task.owner}</span>
            </div>
            <h2 class="mt-4 text-2xl font-bold text-zinc-950 dark:text-white">{task.title}</h2>
            <p class="mt-3 max-w-5xl leading-8 text-zinc-700 dark:text-zinc-300">{task.summary}</p>
          </div>

          <div class="grid gap-6 p-6 lg:grid-cols-[1fr_1.1fr]">
            <div class="space-y-5">
              <div>
                <h3 class="font-bold text-zinc-950 dark:text-white">Artifacts</h3>
                <ul class="mt-3 space-y-2 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
                  {task.artifacts.map((item) => <li class="rounded-xl bg-zinc-50 px-3 py-2 dark:bg-zinc-950/60">{item}</li>)}
                </ul>
              </div>
              <div>
                <h3 class="font-bold text-zinc-950 dark:text-white">Acceptance gate</h3>
                <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-zinc-700 dark:text-zinc-300">
                  {task.acceptance.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>

            <div>
              <h3 class="font-bold text-zinc-950 dark:text-white">Agent comments</h3>
              <div class="mt-3 space-y-3">
                {task.comments.map((comment) => (
                  <div class={`rounded-2xl border p-4 ${commentTone[comment.tone]}`}>
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-sm font-black">{comment.agent}</span>
                      <span class="rounded-full border border-current/20 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide opacity-80">{comment.tone}</span>
                    </div>
                    <p class="mt-2 text-sm leading-6">{comment.body}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </section>
</BaseLayout>
