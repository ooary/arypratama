---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Task List — HairCard";
const description = "Granular implementation checklist for HairCard, with status tracking for building the MVP funnel, background generation pipeline, FAQ, and paid PDF report.";

const statusClass = {
  "Not Started": "bg-slate-100 text-slate-700 border-slate-200",
  "In Progress": "bg-amber-100 text-amber-800 border-amber-200",
  "Done": "bg-emerald-100 text-emerald-800 border-emerald-200",
  "Blocked": "bg-red-100 text-red-800 border-red-200",
};

const phases = [
  {
    id: "1",
    title: "Phase 1 — Setup Environment and Product Contract",
    objective: "Prepare the repo, environment, data contract, and product decisions before feature work starts.",
    tasks: [
      ["1.1", "Initiate private GitHub repo", "Created private GitHub repository at github.com/ooary/haircard with main as default branch, product description, owner-only access, branch protection expectation documented in README, and initial README links to BRD, ERD, task-list, report reference, and prompt documentation.", "P0", "Done"],
      ["1.2", "Setup Next.js app", "Created Next.js App Router project in github.com/ooary/haircard with TypeScript, Tailwind CSS, ESLint, Prettier, env example, base layout, reference page, and passing lint/typecheck/build gates.", "P0", "Done"],
      ["1.3", "Setup Supabase project", "Connected hosted Supabase project ivcbfhvdkrimvlppydhv, configured local env vars, verified service-role admin access, created private selfie/report storage buckets, and documented config/migration workflow. Database migration push still needs DB connection string before Phase 2 tables.", "P0", "Done"],
      ["1.4", "Setup storage decision", "Chose Supabase Storage for MVP speed, documented R2 as later adapter option, defined private selfie/report buckets, signed URL TTL, 30-day retention policy, and server-side signed URL/delete helpers.", "P0", "Done"],
      ["1.5", "Setup payment sandbox", "Prepare Xendit/Midtrans sandbox, webhook secret, checkout redirect URLs, and test payment method.", "P0", "Not Started"],
      ["1.6", "Setup email provider", "Configure Resend sender, report-ready email template, support email, and local test path.", "P0", "Not Started"],
      ["1.7", "Define structured report schema", "Added Zod source-of-truth schemas in the HairCard app for gender_lane, visual_analysis, quiz_context, shared items/stats, and core report pages 02/05/06/09/15 with runtime validation tests. Remaining non-core page schemas can be expanded after first generation loop.", "P0", "Done"],
      ["1.8", "Define page-by-page prompt contract", "Added typed prompt-contract map derived from /prompt/haircard: all 15 pages are registered with source ids, required variables, branch mode, shared safety/system prompt, and core page prompts/schemas for 02/05/06/09/15.", "P0", "Done"],
      ["1.9", "Define AI provider abstraction", "Added minimal OpenAI-first/Gemini-ready structured-output provider layer with shared generateStructuredObject input, provider adapters, and Zod as the final validation gate before report JSON is accepted.", "P0", "Done"],
      ["1.10", "Define safety and FAQ copy", "Added centralized hardcoded MVP copy contract in the HairCard app for medical disclaimer, privacy line, 30-day retention, AI uncertainty, free vs premium explanation, and payment/report recovery FAQ, with docs and tests. No DB storage for product copy.", "P0", "Done"],
    ],
  },
  {
    id: "2",
    title: "Phase 2 — Database and Core Backend",
    objective: "Build the persistence layer for anonymous funnel sessions, paid orders, async generation, and recovery links.",
    tasks: [
      ["2.1", "Create sessions table", "Applied hosted Supabase migration via session pooler, verified service-role REST insert/delete, RLS-locked sessions table, typed token/status helpers, tests, and database docs for anonymous funnel sessions.", "P0", "Done"],
      ["2.2", "Create quiz answers table", "Applied hosted Supabase migration via session pooler, verified quiz answer insert and cascade delete, session-scoped upsert design, typed answer validation, service-role helpers, tests, and docs.", "P0", "Done"],
      ["2.3", "Create customers table", "Applied hosted Supabase migration for customers with name/email/locale/consent fields, RLS locked down, typed service-role upsert/get helpers, tests, and live REST verification.", "P0", "Done"],
      ["2.4", "Create uploads table", "Applied hosted Supabase migration for private storage metadata: storage_bucket, storage_key, mime_type, file_size, dimensions, status, uploaded_at/deleted_at, helpers, tests, and live REST verification.", "P0", "Done"],
      ["2.5", "Create photo quality checks table", "Applied hosted Supabase migration for selfie quality gate results: face_detected, frontal/lighting/blur scores, decision, rejection_reason, helpers, tests, and live REST verification.", "P1", "Done"],
      ["2.6", "Create teaser results table", "Applied hosted Supabase migration for session-scoped teaser output: probable_face_shape, recommended_direction, avoid_note, preview_payload_json, typed helpers, tests, and live REST verification.", "P0", "Done"],
      ["2.7", "Create orders table", "Applied hosted Supabase migration for paid orders with order_no, session/customer references, amount, currency, status, paid_at, recovery token, typed helpers, tests, and live REST verification.", "P0", "Done"],
      ["2.8", "Create payments table", "Applied hosted Supabase migration for provider payment records, statuses, amount/currency, raw webhook payload, paid_at, typed helpers, tests, and live REST verification.", "P0", "Done"],
      ["2.9", "Create generation jobs table", "Applied hosted Supabase migration for async generation queue state: queued/running/succeeded/failed, model, prompt_version, attempts, error_message, typed helpers, tests, and live REST verification.", "P0", "Done"],
      ["2.10", "Create report payloads and reports tables", "Applied hosted Supabase migration for validated AI payloads, safety status, reports with PDF key/public token/generated/expires/status, typed helpers, tests, and live REST verification.", "P0", "Done"],
      ["2.11", "Create feedback and support tables", "Applied hosted Supabase migration for report feedback and support requests with ratings, categories, statuses, typed helpers, tests, and live REST verification.", "P1", "Done"],
      ["2.12", "Create analytics events table", "Applied hosted Supabase migration for first-party funnel analytics events, allowed event names, payload JSON, typed helper, tests, and live REST verification.", "P1", "Done"],
    ],
  },
  {
    id: "3",
    title: "Phase 3 — Funnel UX",
    objective: "Build the user-facing flow from landing page to free teaser.",
    tasks: [
      ["3.1", "Build landing page", "Built premium/editorial landing page using Claude Design process, Facecard-inspired conversion structure, Hair Fit Check naming, exact PDF-derived report preview assets, sample PDF link, privacy reassurance, benefits, how-it-works, FAQ, tests, browser QA, and production build verification.", "P0", "Done"],
      ["3.2", "Build quiz route shell", "Built /quiz mobile-first single-question Hair Fit Check shell with Facecard-inspired progress bar, answer cards, back/next controls, session token creation, CTA routing, tests, browser QA, and production build verification.", "P0", "Done"],
      ["3.3", "Build gender/style lane first step", "Merged into 3.2: first question is prompt-contract backed by gender_lane with Barber-style cuts, Salon-style cuts, Neutral/flexible, and Not sure options persisted through quiz_answers.", "P0", "Done"],
      ["3.4", "Build gender-aware hair diagnosis steps", "Built prompt-backed diagnosis step inside /quiz with taper/fade/top-shape, layers/bangs/face-framing, and neutral balance concerns while avoiding selfie-derived questions like exact current hair length.", "P0", "Done"],
      ["3.5", "Build preference steps", "Built prompt-backed preference steps for maintenance, style direction, desired outcome, lifestyle, occasion, risk level, and hard-no styles with persisted quiz_answers values.", "P0", "Done"],
      ["3.6", "Build upload screen", "Built required front-selfie upload step with client type/size validation, preview, reupload path, photo guidance chips, upload API, upload metadata persistence, and approved quality-gate stub.", "P0", "Done"],
      ["3.7", "Build upload privacy notice", "Added upload-step privacy notice: selfie is used only for report generation and deleted within the retention window.", "P0", "Done"],
      ["3.8", "Build no-payment report preview pipeline", "Built and verified the no-payment report preview path: quiz answers + accepted selfie resolve server-side, AI structured generation runs in auto mode with timeout/deterministic fallback, validated preview payloads persist, cached previews return fast, HTML result preview renders, Regenerate/Try again UX works, real OpenAI structured-vision QA passed with a synthetic selfie fixture, and production browser QA confirmed the rendered report preview.", "P0", "Done"],
      ["3.9", "Track funnel/report analytics", "Partially wired report-generation analytics for started, succeeded, and preview viewed events in the preview pipeline; failed-event coverage and broader funnel/paywall analytics remain pending.", "P1", "In Progress"],
    ],
  },
  {
    id: "4",
    title: "Phase 4 — Paywall, Payment, and Recovery",
    objective: "Convert qualified users and make every paid order recoverable.",
    tasks: [
      ["4.1", "Build paywall page", "Name/email form, report benefits, price, trust line, FAQ link, and payment CTA.", "P0", "Not Started"],
      ["4.2", "Create checkout session", "Create order, create provider checkout session, and redirect user to payment.", "P0", "Not Started"],
      ["4.3", "Implement payment webhook", "Verify signature, idempotently update payment/order status, and enqueue generation job after paid status.", "P0", "Not Started"],
      ["4.4", "Build payment return page", "Show paid/generating/failed status and recovery link behavior after redirect.", "P0", "Not Started"],
      ["4.5", "Build order recovery route", "Allow user to reopen result page via public token or email link without full account login.", "P0", "Not Started"],
      ["4.6", "Handle duplicate payment risk", "If payment succeeded but report is pending, show do-not-pay-again instruction and support Order ID.", "P0", "Not Started"],
    ],
  },
  {
    id: "5",
    title: "Phase 5 — Background Worker and AI Pipeline",
    objective: "Move slow AI/PDF work off the user request path so the UX does not hang.",
    tasks: [
      ["5.1", "Choose worker platform", "Default recommendation: Trigger.dev for Next.js-native durable tasks; compare Inngest if preferred.", "P0", "Not Started"],
      ["5.2", "Setup worker project", "Install SDK, configure env, create health-check task, and verify logs/retries.", "P0", "Not Started"],
      ["5.3", "Create report generation task", "Load paid order, gender_style_lane, quiz answers, selfie signed URL, report schema, page-by-page prompt contract, and image slot registry.", "P0", "Not Started"],
      ["5.4", "Create page output persistence", "Store every generated page as its own database row with order_id, page_number, prompt_version, model, dependency_page_numbers, raw_output, validated_json, status, error_message, and generated_at.", "P0", "Not Started"],
      ["5.5", "Implement prompt-master image slot registry", "Encode the /prompt/haircard Image Slot Map as source of truth: cover/Pg01 upload, Pg03 overlay, and generated slots for Pg02, Pg04, Pg05×3, Pg06, Pg07×3, Pg08×3, Pg10×4, Pg11, Pg13×2–3, Pg14 optional color, and Pg15 comparison.", "P0", "Not Started"],
      ["5.6", "Create image output persistence", "Store each visual slot with order_id/report_id, slot_id, page_number, source type, prompt_version, model, storage key, status, attempts, error_message, and generated_at so progress can show visuals completed vs pending.", "P0", "Not Started"],
      ["5.7", "Implement chained page generation", "Generate pages in dependency groups: foundation context → Pages 02–04 → Pages 05–08 → Pages 09–13 → Pages 14–15. Later prompts receive selected validated JSON from earlier pages so the report stays consistent.", "P0", "Not Started"],
      ["5.8", "Implement staged image generation", "Generate report visuals from the image slot registry after text context is ready, preserve user identity constraints where possible, skip optional Pg14 color image when color_vibe is nope, and support fast/test/full modes for cost control.", "P0", "Not Started"],
      ["5.9", "Integrate Gemini 2.5 Flash", "Use as default affordable multimodal model for selfie + quiz to structured JSON.", "P0", "Not Started"],
      ["5.10", "Add OpenAI fallback and image adapter", "Allow regeneration with OpenAI vision/GPT model if Gemini output quality is weak, and use GPT Image for visual slots that require generated portraits/reference images.", "P1", "Not Started"],
      ["5.11", "Validate AI JSON", "Check required fields, safety wording, no medical diagnosis, no attractiveness score, consistency against dependency pages, and minimum specificity.", "P0", "Not Started"],
      ["5.12", "Validate generated visual slots", "Check every required prompt-master visual slot exists, has storage metadata, matches expected source type/aspect ratio, and does not silently fall back to missing images before report render.", "P0", "Not Started"],
      ["5.13", "Implement retry policy", "Retry transient AI/storage/PDF errors per page or visual slot, cap attempts, and surface failed status for support/manual review without regenerating successful pages unnecessarily.", "P0", "Not Started"],
      ["5.14", "Build generation progress UX", "Result page should poll or subscribe to report status: paid, queued, vision_analysis, writing_pages, generating_visuals with slot counts, rendering_pdf, ready, failed, including current page/batch progress.", "P0", "Not Started"],
      ["5.15", "Add manual review fallback", "Allow first 10–20 reports to be fixed/regenerated before delivery if output is generic or visual identity consistency is weak.", "P1", "Not Started"],
    ],
  },
  {
    id: "6",
    title: "Phase 6 — PDF Report and Delivery",
    objective: "Render the paid artifact and make it easy to download, recover, and show to a barber/salon.",
    tasks: [
      ["6.1", "Design 15-page HTML report template", "Built and tested a 15-page print-safe HTML report renderer from the validated HairCard payload with A4 page rhythm, core section mapping, and screenshot-ready barber/salon card content.", "P0", "Done"],
      ["6.2", "Build visual report asset binding", "Replaced the text-first PDF with reference-style visual binding: uploaded source photo, generated front haircut preview, side-profile preview, lifestyle/outfit preview, and barber-card/direction-board image slots now render into the live PDF route.", "P0", "Done"],
      ["6.3", "Build PDF renderer", "Built and production-QA'd the reference-style 15-page visual PDF renderer/export route; live HairCard test returned %PDF header, A4 15 pages, ~2.5MB signed PDF, real OpenAI payload, and generated visual slots.", "P0", "Done"],
      ["6.4", "Store generated PDF", "Implemented report PDF upload to Supabase reports storage, reports row persistence with pdf_storage_key/public token/expiry, signed download URL creation, browser/API QA, and cleanup of QA objects.", "P0", "Done"],
      ["6.5", "Build result page", "Show status, download button, barber/salon brief highlight, Order ID, delete files action, and support link.", "P0", "Not Started"],
      ["6.6", "Send report-ready email", "Email download link, Order ID, deletion link, support instructions, and save-before-expiry reminder after the report is already ready; email must not block generation.", "P0", "Not Started"],
      ["6.7", "Track downloads", "Log report_downloads event with token/customer/order reference for support and analytics.", "P1", "Not Started"],
      ["6.8", "Collect feedback", "Ask report usefulness rating and whether user would show it to barber/salon.", "P1", "Not Started"],
    ],
  },
  {
    id: "7",
    title: "Phase 7 — FAQ, Privacy, and Support Ops",
    objective: "Reduce anxiety and support load before launch.",
    tasks: [
      ["7.1", "Build FAQ page", "Cover selfie safety, retention, delete flow, free vs premium, missing email, payment/report issue, and medical disclaimer.", "P0", "Not Started"],
      ["7.2", "Add FAQ links across funnel", "Link FAQ from landing footer, upload privacy note, paywall, result page, and report email.", "P0", "Not Started"],
      ["7.3", "Build delete files action", "Allow user to delete selfie and generated PDF before 30-day window ends.", "P0", "Not Started"],
      ["7.4", "Create retention cleanup job", "Scheduled job deletes expired selfies/reports and updates deleted_at/status.", "P0", "Not Started"],
      ["7.5", "Create support playbook", "Document how to recover order by Order ID/email and how to handle paid-but-not-ready cases.", "P1", "Not Started"],
    ],
  },
  {
    id: "8",
    title: "Phase 8 — QA, Launch, and Iteration",
    objective: "Verify the funnel end-to-end and validate paid demand before adding complex features.",
    tasks: [
      ["8.1", "Run end-to-end happy path", "Landing → quiz → upload → teaser → pay → webhook → generation → PDF → email → download.", "P0", "Not Started"],
      ["8.2", "Run failure-path QA", "Test failed payment, duplicate webhook, AI failure, PDF failure, bad upload, wrong email, and expired link.", "P0", "Not Started"],
      ["8.3", "Run mobile QA", "Verify funnel, upload, paywall, and PDF preview on small screens.", "P0", "Not Started"],
      ["8.4", "Run first 10–20 paid orders", "Use semi-automated/manual review if needed to protect report quality.", "P0", "Not Started"],
      ["8.5", "Review funnel metrics", "Analyze quiz start, upload, teaser, checkout click, paid conversion, report ready, and download rates.", "P1", "Not Started"],
      ["8.6", "Improve report specificity", "Use feedback to reduce generic advice and sharpen barber/salon instructions.", "P1", "Not Started"],
      ["8.7", "Decide next feature", "Choose between hairstyle mockup images, richer reference board, referral, or salon/barber partnership.", "P2", "Not Started"],
    ],
  },
];

const acceptanceCriteria = [
  "A user can complete the MVP funnel on mobile without creating an account.",
  "A user can upload a selfie, see a teaser, pay, leave the page, and recover the report later.",
  "Payment webhook triggers a background job; AI/PDF generation does not block the checkout return request.",
  "Every paid order has a visible status: checkout_started, paid, queued, generating, rendering, ready, failed, or refunded.",
  "The FAQ explains privacy, 30-day retention, delete flow, free vs premium, email recovery, payment issues, and medical disclaimer.",
  "The final PDF includes all prompt-master required visual slots, a barber/salon-ready brief, and avoids medical diagnosis or attractiveness scoring.",
];

const links = [
  ["BRD", "/brd/haircard"],
  ["ERD", "/erd/haircard"],
  ["Prompt", "/prompt/haircard"],
  ["Report Reference", "/report/haircard"],
];
---

<BaseLayout title={title} description={description}>
  <main class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">Implementation Checklist</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl">HairCard</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-700 dark:text-slate-300">{description}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      {links.map(([label, href]) => (
        <a href={href} class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm hover:border-slate-400 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">
          {label}
        </a>
      ))}
    </div>

    <section class="mt-10 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-2xl font-bold text-slate-950 dark:text-white">Execution Principle</h2>
      <p class="mt-4 leading-7 text-slate-700 dark:text-slate-300">
        Build the narrow paid funnel first. The critical technical decision is async generation: after payment, the user should see a recoverable progress state while a background worker runs AI analysis and PDF rendering.
      </p>
    </section>

    <section class="mt-12 space-y-6">
      {phases.map((phase) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div>
            <p class="text-sm font-semibold text-slate-500">Phase {phase.id}</p>
            <h2 class="mt-1 text-2xl font-bold text-slate-950 dark:text-white">{phase.title}</h2>
            <p class="mt-2 leading-7 text-slate-700 dark:text-slate-300">{phase.objective}</p>
          </div>
          <div class="mt-5 space-y-3">
            {phase.tasks.map(([id, task, detail, priority, status]) => (
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950/60">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-slate-900 px-2.5 py-1 text-xs font-bold text-white dark:bg-slate-100 dark:text-slate-900">{id}</span>
                  <h3 class="font-semibold text-slate-950 dark:text-white">{task}</h3>
                  <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">{priority}</span>
                  <span class={`rounded-full border px-2.5 py-1 text-xs font-bold ${statusClass[status]}`}>{status}</span>
                </div>
                <p class="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300">{detail}</p>
              </div>
            ))}
          </div>
        </article>
      ))}
    </section>

    <section class="mt-12 rounded-3xl border border-slate-950 bg-slate-950 p-6 text-white dark:border-slate-700">
      <h2 class="text-2xl font-bold">MVP Acceptance Criteria</h2>
      <ul class="mt-4 space-y-3 text-slate-200">
        {acceptanceCriteria.map((item) => <li>• {item}</li>)}
      </ul>
    </section>
  </main>
</BaseLayout>
