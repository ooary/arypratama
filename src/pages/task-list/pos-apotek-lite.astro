---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Task List — POS Apotek Lite";
const description = "Backend-first module task list and API contract for POS Apotek Lite MVP.";

const apiContracts = [
  ["Auth/User", "POST", "/api/v1/users/register", "Daftar owner dengan email, password, nomor HP, dan data apotek awal.", "UserRegisterRequest", "UserSessionResponse", "Auto-create users, stores, store_memberships role owner."],
  ["Auth/User", "POST", "/api/v1/auth/login", "Login owner pakai email + password.", "LoginRequest", "UserSessionResponse", "Return access token + active store context."],
  ["Auth/User", "GET", "/api/v1/users/me", "Ambil profil user login dan active store.", "-", "UserMeResponse", "Dipakai FE saat app boot."],
  ["Store", "PATCH", "/api/v1/stores/{store_id}", "Update data apotek untuk struk.", "StoreUpdateRequest", "StoreRead", "Nama, alamat, phone, email, logo/header/footer struk."],
  ["Master Data / Products", "GET", "/api/v1/products", "List/search master produk.", "ProductListQuery", "ProductListResponse", "Support q, barcode, category, is_active, pagination."],
  ["Master Data / Products", "POST", "/api/v1/products", "Buat master produk baru.", "ProductCreate", "ProductRead", "SKU unik per store; barcode optional. Tidak berarti stok masuk."],
  ["Master Data / Products", "GET", "/api/v1/products/{product_id}", "Detail master produk + batch aktif.", "-", "ProductDetailRead", "Include current_stock derived. Belum implemented di backend saat ini."],
  ["Master Data / Products", "PATCH", "/api/v1/products/{product_id}", "Update master produk.", "ProductUpdate", "ProductRead", "Tidak langsung update stok."],
  ["Master Data / Products", "DELETE", "/api/v1/products/{product_id}", "Soft delete produk.", "-", "204 No Content", "Produk lama tetap valid untuk transaksi historis."],
  ["Master Data / Products", "GET", "/api/v1/products/barcode/{barcode}", "Cari master produk dari scan barcode kamera.", "-", "ProductRead", "Return 404 kalau barcode belum terdaftar."],
  ["Master Data / Suppliers", "GET", "/api/v1/suppliers", "List/search master supplier.", "SupplierListQuery", "SupplierListResponse", "Needed for FE barang masuk supplier picker. Belum implemented di backend saat ini."],
  ["Master Data / Suppliers", "POST", "/api/v1/suppliers", "Buat master supplier toko.", "SupplierCreate", "SupplierRead", "Supplier scoped per store; dipakai oleh barang masuk dan batch."],
  ["Master Data / Suppliers", "GET", "/api/v1/suppliers/{supplier_id}", "Detail master supplier.", "-", "SupplierRead", "Belum implemented di backend saat ini."],
  ["Master Data / Suppliers", "PATCH", "/api/v1/suppliers/{supplier_id}", "Update master supplier.", "SupplierUpdate", "SupplierRead", "Belum implemented di backend saat ini."],
  ["Master Data / Suppliers", "DELETE", "/api/v1/suppliers/{supplier_id}", "Nonaktifkan/soft delete supplier.", "-", "204 No Content", "Belum implemented di backend saat ini."],
  ["Product Batches", "POST", "/api/v1/products/{product_id}/batches", "Buat batch produk/manual bootstrap batch.", "ProductBatchCreate", "ProductBatchRead", "Catatan: jalur ini perlu dirapikan agar ledger-driven atau bootstrap-only."],
  ["Product Batches", "GET", "/api/v1/products/{product_id}/batches", "List batch produk.", "-", "ProductBatchListResponse", "Ordered by nearest expiry. Belum implemented di backend saat ini."],
  ["Sales", "POST", "/api/v1/sales", "Post transaksi penjualan.", "SaleCreate", "SaleRead", "Wajib client_tx_id; otomatis create stock_movements type sale."],
  ["Sales", "GET", "/api/v1/sales", "List transaksi.", "SaleListQuery", "SaleListResponse", "Filter tanggal, payment method, sync status."],
  ["Sales", "GET", "/api/v1/sales/{sale_id}", "Detail transaksi.", "-", "SaleDetailRead", "Include sale_items."],
  ["Receipts", "GET", "/api/v1/sales/{sale_id}/receipt", "Ambil payload struk.", "-", "ReceiptRead", "FE render share PDF/thermal print dari payload ini."],
  ["Stock Receipts", "POST", "/api/v1/stock-receipts", "Input barang masuk.", "StockReceiptCreate", "StockReceiptRead", "Create/update batch, create stock_movements type stock_receipt."],
  ["Stock Receipts", "GET", "/api/v1/stock-receipts", "List barang masuk.", "StockReceiptListQuery", "StockReceiptListResponse", "Filter tanggal/supplier."],
  ["Stock Receipts", "GET", "/api/v1/stock-receipts/{receipt_id}", "Detail barang masuk.", "-", "StockReceiptDetailRead", "Include items, batch, product."],
  ["Stock", "POST", "/api/v1/stock/adjustments", "Koreksi stok/manual adjustment.", "StockAdjustmentCreate", "StockAdjustmentRead", "Untuk rusak, expired, hilang, opname."],
  ["Stock", "GET", "/api/v1/stock/movements", "List ledger movement.", "StockMovementQuery", "StockMovementListResponse", "Filter product, batch, movement_type, date."],
  ["Stock", "GET", "/api/v1/stock/card", "Kartu stok produk.", "StockCardQuery", "StockCardResponse", "Menampilkan masuk/keluar/saldo berjalan."],
  ["Reports", "GET", "/api/v1/reports/dashboard", "Dashboard owner.", "DashboardQuery", "DashboardRead", "Omzet hari ini, transaksi, top products, low stock, near expiry."],
  ["Reports", "GET", "/api/v1/reports/low-stock", "List stok menipis.", "LowStockQuery", "LowStockListResponse", "Based on products.current_stock <= minimum_stock."],
  ["Reports", "GET", "/api/v1/reports/near-expiry", "List batch mendekati expired.", "NearExpiryQuery", "NearExpiryListResponse", "Default threshold 90 hari."],
  ["Reports", "GET", "/api/v1/reports/top-products", "Produk terlaris.", "TopProductsQuery", "TopProductsResponse", "Based on sale_items."],
  ["Import", "GET", "/api/v1/imports/products/template", "Download template Excel produk.", "-", "FileResponse", "Kolom sesuai PRD."],
  ["Import", "POST", "/api/v1/imports/products/preview", "Preview import produk.", "multipart/form-data", "ImportPreviewResult", "Belum commit ke DB."],
  ["Import", "POST", "/api/v1/imports/products/commit", "Commit hasil import valid.", "ImportCommitRequest", "ImportJobRead", "Invalid rows ditolak."],
  ["Export", "GET", "/api/v1/exports/products", "Export produk.", "ExportProductsQuery", "FileResponse", "Excel."],
  ["Export", "GET", "/api/v1/exports/sales", "Export transaksi.", "ExportSalesQuery", "FileResponse", "Filter date range."],
  ["Export", "GET", "/api/v1/exports/stock", "Export stok.", "ExportStockQuery", "FileResponse", "Include current stock + batch if any."],
  ["Sync", "POST", "/api/v1/sync/push", "Push offline events dari client.", "SyncPushRequest", "SyncPushResult", "Per event wajib idempotency_key."],
  ["Sync", "GET", "/api/v1/sync/pull", "Pull perubahan cloud ke client.", "SyncPullQuery", "SyncPullResponse", "Cursor-based."],
  ["Sync", "GET", "/api/v1/sync/status", "Cek status sync client/store.", "SyncStatusQuery", "SyncStatusRead", "Untuk indikator pending/synced/failed di FE."],
  ["Admin", "GET", "/api/v1/admin/overview", "Overview internal Ary.", "AdminOverviewQuery", "AdminOverviewRead", "Total users, stores, sales, GMV, active today, errors."],
  ["Admin", "GET", "/api/v1/admin/users", "List user daftar.", "AdminUserQuery", "AdminUserListResponse", "Search/filter by date/activity."],
  ["Admin", "GET", "/api/v1/admin/stores", "List apotek/store.", "AdminStoreQuery", "AdminStoreListResponse", "Include owner, city/address, last activity."],
  ["Admin", "GET", "/api/v1/admin/activity", "Activity feed.", "AdminActivityQuery", "AdminActivityListResponse", "Signup, sale posted, stock receipt, import, sync events."],
  ["Admin", "GET", "/api/v1/admin/sync-errors", "Pantau sync/import error.", "AdminSyncErrorQuery", "AdminSyncErrorListResponse", "Untuk debugging early users."],
];

const statusClass = {
  "Not Yet": "bg-slate-100 text-slate-700 border-slate-200",
  "In Progress": "bg-amber-100 text-amber-800 border-amber-200",
  "Done": "bg-emerald-100 text-emerald-800 border-emerald-200",
};

const modules = [
  { title: "Module 0 — Project Foundation", tasks: [
    ["0.1", "Setup repo", "Create `/root/projects/apotech` repo, README links to PRD/ERD/task-list, .env.example, local run commands.", "P0", "Done"],
    ["0.2", "Setup backend env", "uv init, Python 3.12, FastAPI, uvicorn, pydantic-settings, SQLAlchemy, psycopg, Alembic, Scalar.", "P0", "Done"],
    ["0.3", "Setup backend quality gates", "pytest, ruff, pyright, Alembic offline SQL check, OpenAPI route contract test. Done by BonBon: local commit `9ed8526`.", "P0", "Done"],
  ]},
  { title: "Module 1 — Users, Store, and Apotek Profile", tasks: [
    ["1.1", "Create `user_schema.py`", "UserCreate, UserRead, StoreCreate, StoreRead, StoreMembershipRead. Done by BonBon: local commit `5123cd3`.", "P0", "Done"],
    ["1.2", "Create `user_model.py`", "User, Store, StoreMembership. Store has name, legal_name, address, phone, email, logo_url, receipt_header, receipt_footer, tax_no. Done by BonBon: local commit `5123cd3`.", "P0", "Done"],
    ["1.3", "Create `user_service.py`", "Register first user/store, attach owner membership, get active store context. Done by BonBon: local commit `5123cd3`.", "P0", "Done"],
    ["1.4", "Create `user_api.py`", "Register/login/me/store profile endpoints. Include user_api.py and auth_api.py routers in main.py. Done by BonBon: local commit `5123cd3`.", "P0", "Done"],

  ]},
  { title: "Module 2 — Master Data: Products and Suppliers", tasks: [
    ["2.1", "Create `product_schema.py`", "ProductCreate/Update/Read, SupplierCreate/Read, ProductBatchCreate/Read, ProductSearch, LowStockRead. Done by BonBon: pushed commit `9ec968c`.", "P0", "Done"],
    ["2.2", "Create `product_model.py`", "Product, ProductBatch, Supplier; store-scoped SKU/barcode uniqueness; soft delete. Done by BonBon: pushed commit `9ec968c`.", "P0", "Done"],
    ["2.3", "Create `product_service.py`", "CRUD product, create supplier, duplicate checks, barcode lookup, batch create/update, current stock reads. Done by BonBon: pushed commit `9ec968c`.", "P0", "Done"],
    ["2.4", "Create `product_api.py`", "Product CRUD, create supplier, barcode lookup, batch create endpoint, low-stock endpoint. Include router in main.py. Done by BonBon: pushed commit `9ec968c`.", "P0", "Done"],
    ["2.5", "Complete supplier master data API", "Add list/detail/update/delete supplier endpoints, store-scoped filtering, schema tests, OpenAPI contract coverage. Needed before FE barang masuk supplier picker.", "P0"],
    ["2.6", "Complete product detail and batch list API", "Add GET product detail and GET product batches endpoints or update contract if intentionally out of scope.", "P0"],
    ["2.7", "Clarify bootstrap batch path", "Decide whether POST product batch is bootstrap-only or must post opening_stock movement. Avoid stock mutation outside ledger.", "P0"],

  ]},
  { title: "Module 3 — Stock Ledger Core", tasks: [
    ["3.1", "Create `stock_schema.py`", "StockMovementRead, StockAdjustmentCreate, StockCardRead, NearExpiryRead. Done by BonBon: local commit `ee65ebe`.", "P0", "Done"],
    ["3.2", "Create `stock_model.py`", "StockMovement append-only, StockAdjustment, StockAdjustmentItem with constraints and indexes. Done by BonBon: local commit `ee65ebe`.", "P0", "Done"],
    ["3.3", "Create `stock_service.py`", "Single posting function: insert movement, update products.current_stock and product_batches.available_qty, return balance_after. Done by BonBon: local commit `ee65ebe`.", "P0", "Done"],
    ["3.4", "Create immutability tests", "No normal update/delete path for posted stock_movements; corrections use adjustment/reversal. Done by BonBon: local commit `ee65ebe`.", "P0", "Done"],
    ["3.5", "Create `stock_api.py`", "Adjustment posting, movement list, stock card report, near-expiry list. Include router in main.py. Done by BonBon: local commit `ee65ebe`.", "P0", "Done"],
  ]},
  { title: "Module 4 — Sales and Digital Receipt", tasks: [
    ["4.1", "Create `sale_schema.py`", "SaleCreate, SaleItemCreate, SaleRead, PaymentMethod, ReceiptRead with client_tx_id. Done by BonBon: local commits `58f8a44`, `6daf6e2`.", "P0", "Done"],
    ["4.2", "Create `sale_model.py`", "Sale, SaleItem, sale_no, money constraints, idempotent client_tx_id. Done by BonBon: local commits `58f8a44`, `6daf6e2`.", "P0", "Done"],
    ["4.3", "Create `sale_service.py`", "Post sale, pick FEFO batch when available, create sale_items, call stock_service movement_type=sale. Done by BonBon: local commits `58f8a44`, `6daf6e2`.", "P0", "Done"],
    ["4.4", "Create `receipt_service.py`", "Build receipt payload from sale + store profile. HTML/PDF/share-ready. Done by BonBon: local commit `58f8a44`.", "P0", "Done"],
    ["4.5", "Create `sale_api.py`", "POST/list/get sale and GET receipt. Include router in main.py. Done by BonBon: local commit `58f8a44`.", "P0", "Done"],

  ]},
  { title: "Module 5 — Stock Receipts / Barang Masuk", tasks: [
    ["5.1", "Create `stock_receipt_schema.py`", "StockReceiptCreate, StockReceiptItemCreate, StockReceiptRead. Done by BonBon: local commit `0639922`.", "P0", "Done"],
    ["5.2", "Create `stock_receipt_model.py`", "StockReceipt and StockReceiptItem linked to supplier/product/batch. Done by BonBon: local commit `0639922`.", "P0", "Done"],
    ["5.3", "Create `stock_receipt_service.py`", "Post barang masuk, upsert/find batch, create items, call stock_service movement_type=stock_receipt. Done by BonBon: local commit `0639922`.", "P0", "Done"],
    ["5.4", "Create `stock_receipt_api.py`", "POST/list/get stock receipts. Include router in main.py. Done by BonBon: local commit `0639922`.", "P0", "Done"],

  ]},
  { title: "Module 6 — Reports", tasks: [
    ["6.1", "Create `report_schema.py`", "DashboardRead, SalesSummaryRead, TopProductRead, LowStockRead, NearExpiryRead.", "P0"],
    ["6.2", "Create `report_service.py`", "Sales summary, top products, low stock, near expiry, gross profit estimate, stock card from ledger.", "P0"],
    ["6.3", "Create `report_api.py`", "Dashboard, sales summary, top products, low stock, near-expiry endpoints. Include router in main.py.", "P0"],

  ]},
  { title: "Module 7 — Excel Import / Export", tasks: [
    ["7.1", "Create `import_schema.py`", "ImportPreviewRow, ImportPreviewResult, ImportCommitRequest, ImportJobRead.", "P0"],
    ["7.2", "Create `import_model.py`", "ImportJob stores file name, type, row counts, validation errors JSON.", "P0"],
    ["7.3", "Create `import_service.py`", "Parse product Excel, validate SKU/barcode/date/price, preview errors, commit valid rows.", "P0"],
    ["7.4", "Create `import_api.py`", "Upload preview, commit import, download template/error report. Include router in main.py.", "P0"],

  ]},
  { title: "Module 8 — Offline Sync", tasks: [
    ["8.1", "Create `sync_schema.py`", "SyncEventDTO, SyncPushRequest, SyncPullRequest, SyncResult, conflict response.", "P0"],
    ["8.2", "Create `sync_model.py`", "SyncEvent with client_id, entity_type, entity_id, operation, payload_json, status, idempotency_key.", "P0"],
    ["8.3", "Create `sync_service.py`", "Apply events idempotently, reject duplicates, return per-event accepted/rejected state.", "P0"],
    ["8.4", "Create `sync_api.py`", "POST push and GET pull/status. Include router in main.py.", "P0"],
    ["8.5", "Define frontend sync contract", "Document required client event shape, idempotency_key behavior, retry states, and pull cursor semantics for FE implementation.", "P0"],
  ]},
  { title: "Module 9 — Admin Panel for Ary", tasks: [
    ["9.1", "Create `admin_schema.py`", "AdminOverviewRead, AdminUserRead, AdminStoreRead, AdminActivityRead, AdminSyncErrorRead.", "P0"],
    ["9.2", "Create `admin_service.py`", "Aggregate signups, stores, sales count, GMV, active users, sync failures, import failures, latest activity.", "P0"],
    ["9.3", "Create `admin_api.py`", "GET overview/users/stores/activity/sync-errors. Protect behind admin token/env for MVP.", "P0"],
    ["9.4", "Add admin activity instrumentation", "Record user signup, store created, sale posted, stock receipt posted, import preview/commit, sync failure, sync success.", "P0"],
  ]},
  { title: "Module 10 — Backend Ship Gates", tasks: [
    ["10.1", "Backend gate", "pytest + ruff + pyright + Alembic offline SQL + /openapi.json route tags.", "P0"],
    ["10.2", "API contract gate", "Every endpoint in the API Contract section has schema tests and appears in /openapi.json with stable request/response DTOs.", "P0"],
    ["10.3", "Backend demo script", "Seed user/store/20 products, import Excel, post sale, post stock receipt, run dashboard report, verify admin activity.", "P0"],
  ]},
  { title: "Next Track — UI/UX After Backend Contract", tasks: [
    ["UI.1", "Apotek profile UI", "Owner edits apotek name/address/phone/footer; receipt preview uses store data.", "P1"],
    ["UI.2", "Product UI", "List/search/create/edit product, SKU/barcode, prices, min stock, batch/expired optional.", "P1"],
    ["UI.3", "Sale UI", "Fast search/barcode, cart, payment method, offline save, FEFO selected batch note, receipt screen.", "P1"],
    ["UI.4", "Stock receipt UI", "Barang masuk form with supplier optional, batch_no, expired_date, SOP note.", "P1"],
    ["UI.5", "Reports UI", "Owner dashboard: today sales, transaction count, top products, low stock, near expiry.", "P1"],
    ["UI.6", "Import/export UI", "Template download, upload preview, error list, commit, exports.", "P1"],
    ["UI.7", "Offline sync UI/state", "Pinia queue with pending/synced/failed state, Android SQLite and Web IndexedDB adapter.", "P1"],
    ["UI.8", "Admin panel UI", "Ary internal dashboard: users, apotek registered, sales activity, sync/import errors, newest stores/users.", "P1"],
  ]},
];
---

<BaseLayout title={title} description={description}>
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-slate-950">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-blue-600">Granular Execution Plan</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 dark:text-white">POS Apotek Lite Task List</h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">Task list disusun backend-first per module. Setiap backend module harus clear dulu: schema, model, service, API, tests, OpenAPI contract. UI/UX dipisah sebagai next track setelah contract stabil.</p>
      <div class="mt-6 flex flex-wrap gap-3"><a class="rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white" href="/prd/pos-apotek-lite/">PRD</a><a class="rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white" href="/erd/pos-apotek-lite/">ERD</a></div>
    </section>

    <section class="mt-10 rounded-3xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="text-2xl font-bold">Master Data Boundary</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div class="rounded-2xl bg-white p-4 text-sm leading-6 text-slate-700 dark:bg-slate-950 dark:text-slate-300"><strong class="text-slate-950 dark:text-white">Master Data</strong><br />Products dan Suppliers adalah data referensi store-scoped. Membuat produk/supplier tidak otomatis menambah stok.</div>
        <div class="rounded-2xl bg-white p-4 text-sm leading-6 text-slate-700 dark:bg-slate-950 dark:text-slate-300"><strong class="text-slate-950 dark:text-white">Stock Operations</strong><br />Barang masuk, batch/expiry, kartu stok, dan adjustment masuk domain inventory. Stok berubah lewat stock ledger, bukan edit master data.</div>
      </div>
    </section>

    <section class="mt-10 rounded-3xl border border-slate-200 p-6 dark:border-slate-800">
      <h2 class="text-2xl font-bold">API Contract for Frontend</h2>
      <div class="mt-5 overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
        <table class="min-w-full divide-y divide-slate-200 text-left text-sm dark:divide-slate-800">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-900 dark:text-slate-400">
            <tr>
              <th class="px-4 py-3 font-semibold">Domain</th>
              <th class="px-4 py-3 font-semibold">Method</th>
              <th class="px-4 py-3 font-semibold">Endpoint</th>
              <th class="px-4 py-3 font-semibold">Purpose</th>
              <th class="px-4 py-3 font-semibold">Request DTO</th>
              <th class="px-4 py-3 font-semibold">Response DTO</th>
              <th class="px-4 py-3 font-semibold">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-800 dark:bg-slate-950">
            {apiContracts.map(([domain, method, endpoint, purpose, requestDto, responseDto, notes]) => (
              <tr class="align-top">
                <td class="whitespace-nowrap px-4 py-4 font-semibold text-slate-950 dark:text-white">{domain}</td>
                <td class="whitespace-nowrap px-4 py-4"><span class="rounded-full bg-blue-100 px-2 py-1 text-xs font-semibold text-blue-700">{method}</span></td>
                <td class="px-4 py-4 text-slate-700 dark:text-slate-300"><code class="whitespace-pre-wrap break-words">{endpoint}</code></td>
                <td class="px-4 py-4 text-slate-600 dark:text-slate-300">{purpose}</td>
                <td class="px-4 py-4 text-slate-700 dark:text-slate-300"><code>{requestDto}</code></td>
                <td class="px-4 py-4 text-slate-700 dark:text-slate-300"><code>{responseDto}</code></td>
                <td class="px-4 py-4 text-slate-600 dark:text-slate-300">{notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10 space-y-8">{modules.map((mod) => <article class="rounded-3xl border border-slate-200 p-6 dark:border-slate-800"><h2 class="text-2xl font-bold">{mod.title}</h2><div class="mt-5 space-y-3">{mod.tasks.map(([id, name, body, priority, status = "Not Yet"]) => <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-900"><div class="flex flex-wrap items-center gap-2"><span class="rounded-full bg-slate-950 px-3 py-1 text-xs font-semibold text-white dark:bg-white dark:text-slate-950">{id}</span><span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">{priority}</span><span class={`rounded-full border px-3 py-1 text-xs font-semibold ${statusClass[status]}`}>{status}</span><h3 class="font-semibold text-slate-950 dark:text-white">{name}</h3></div><p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{body}</p></div>)}</div></article>)}</section>
  </main>
</BaseLayout>
