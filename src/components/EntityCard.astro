---
interface Entity {
  name: string;
  tag: string;
  fields: string[];
}

const { entity } = Astro.props as { entity: Entity };
---

<div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
  <div class="flex flex-wrap items-center gap-2">
    <h4 class="font-bold text-zinc-950 dark:text-white">{entity.name}</h4>
    <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">{entity.tag}</span>
  </div>
  <ul class="mt-4 space-y-1.5 text-xs leading-5 text-zinc-700 dark:text-zinc-300">
    {entity.fields.map((field) => (
      <li><code>{field}</code></li>
    ))}
  </ul>
</div>
