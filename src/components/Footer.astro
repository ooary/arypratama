---
const year = new Date().getFullYear();
---

<footer
  class="border-t border-zinc-200 dark:border-zinc-800 mt-auto bg-white dark:bg-dark-900"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p
        class="text-zinc-500 dark:text-zinc-400 text-xs uppercase tracking-wide"
      >
        &copy; {year} Ary Pratama.
        <span class="hidden sm:inline">Built with Astro & Tailwind.</span>
      </p>
      <div class="flex items-center gap-5">
        <a
          href="https://github.com/ooary"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors"
          aria-label="GitHub"
        >
          <i class="ph-fill ph-github-logo text-2xl"></i>
        </a>
        <a
          href="#"
          class="text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          aria-label="LinkedIn"
        >
          <i class="ph-fill ph-linkedin-logo text-2xl"></i>
        </a>
        <a
          href="#"
          class="text-zinc-400 hover:text-blue-400 dark:hover:text-blue-300 transition-colors"
          aria-label="Twitter"
        >
          <i class="ph-fill ph-twitter-logo text-2xl"></i>
        </a>
        <a
          href="/rss.xml"
          class="text-zinc-400 hover:text-orange-500 dark:hover:text-orange-400 transition-colors"
          aria-label="RSS Feed"
        >
          <i class="ph-fill ph-rss text-2xl"></i>
        </a>
      </div>
    </div>
  </div>
</footer>
