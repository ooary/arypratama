---
const username = "ooary";
type ContributionDay = {
  date: string;
  level: number;
  count: number;
  label: string;
  col: number;
  row: number;
};

const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const dayLabels = ["Mon", "Wed", "Fri"];

function dateToUtc(date: string) {
  const [year, month, day] = date.split("-").map(Number);
  return new Date(Date.UTC(year, month - 1, day));
}

function weekDiff(start: Date, current: Date) {
  const msPerDay = 24 * 60 * 60 * 1000;
  const startSunday = new Date(start);
  startSunday.setUTCDate(startSunday.getUTCDate() - startSunday.getUTCDay());
  const currentSunday = new Date(current);
  currentSunday.setUTCDate(currentSunday.getUTCDate() - currentSunday.getUTCDay());
  return Math.floor((currentSunday.getTime() - startSunday.getTime()) / (msPerDay * 7));
}

let days: ContributionDay[] = [];
let totalContributions = 0;
let fetchFailed = false;

try {
  const response = await fetch(`https://github.com/users/${username}/contributions`, {
    headers: { "User-Agent": "arypratama.com" },
  });

  if (!response.ok) throw new Error(`GitHub contributions returned ${response.status}`);

  const html = await response.text();
  const totalMatch = html.match(/<h2[^>]*id="js-contribution-activity-description"[^>]*>\s*([\d,]+)/);
  totalContributions = totalMatch ? Number(totalMatch[1].replace(/,/g, "")) : 0;

  const matches = Array.from(
    html.matchAll(/<td([^>]*class="ContributionCalendar-day"[^>]*)><\/td>\s*<tool-tip[^>]*>(.*?)<\/tool-tip>/gs),
  );

  const getAttr = (attrs: string, name: string) => attrs.match(new RegExp(`${name}="([^"]+)"`))?.[1] ?? "";
  const firstDate = matches[0]?.[1] ? dateToUtc(getAttr(matches[0][1], "data-date")) : new Date();

  days = matches.map((match) => {
    const attrs = match[1];
    const date = getAttr(attrs, "data-date");
    const currentDate = dateToUtc(date);
    const label = match[2].replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
    const countMatch = label.match(/^(\d+)/);

    return {
      date,
      level: Number(getAttr(attrs, "data-level") || 0),
      count: countMatch ? Number(countMatch[1]) : 0,
      label,
      col: weekDiff(firstDate, currentDate) + 1,
      row: currentDate.getUTCDay() + 1,
    };
  });
} catch (error) {
  fetchFailed = true;
}

const monthLabels = days.reduce<{ label: string; col: number }[]>((labels, day) => {
  const currentDate = dateToUtc(day.date);
  if (currentDate.getUTCDate() <= 7) {
    const label = monthNames[currentDate.getUTCMonth()];
    const previous = labels[labels.length - 1];
    if (!previous || previous.label !== label) labels.push({ label, col: day.col });
  }
  return labels;
}, []);
---

<section class="github-contrib" aria-labelledby="github-activity-title">
  <h2 id="github-activity-title" class="text-xl font-bold flex items-center gap-2">
    <i class="ph ph-book-open text-blue-600"></i>
    Activity
  </h2>

  <div class="mt-4 overflow-x-auto pb-2">
    {fetchFailed || days.length === 0 ? (
      <a
        href={`https://github.com/${username}`}
        target="_blank"
        rel="noreferrer"
        class="block rounded-xl border border-zinc-200 p-4 text-sm text-zinc-500 hover:border-blue-500 hover:text-blue-600 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-blue-400 dark:hover:text-blue-400"
      >
        GitHub activity is temporarily unavailable. View profile →
      </a>
    ) : (
      <div class="min-w-[720px] rounded-xl border border-zinc-200 bg-white/40 p-4 dark:border-zinc-800 dark:bg-zinc-900/20">
        <div class="ml-9 grid grid-cols-[repeat(53,11px)] gap-[3px] text-[10px] text-zinc-500 dark:text-zinc-400">
          {monthLabels.map((month) => (
            <span style={`grid-column: ${month.col} / span 4`}>{month.label}</span>
          ))}
        </div>

        <div class="mt-2 flex gap-2">
          <div class="grid grid-rows-7 gap-[3px] text-[10px] leading-[11px] text-zinc-500 dark:text-zinc-400">
            {Array.from({ length: 7 }, (_, index) => (
              <span class="h-[11px] w-7">{dayLabels.includes(["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][index]) ? ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][index] : ""}</span>
            ))}
          </div>

          <div class="grid grid-cols-[repeat(53,11px)] grid-rows-7 gap-[3px]" aria-label={`${totalContributions} GitHub contributions in the last year`}>
            {days.map((day) => (
              <a
                href={`https://github.com/${username}?tab=overview&from=${day.date}&to=${day.date}`}
                target="_blank"
                rel="noreferrer"
                title={day.label}
                aria-label={day.label}
                class:list={[
                  "h-[11px] w-[11px] rounded-[2px] outline outline-1 outline-black/5 dark:outline-white/5",
                  day.level === 0 && "bg-zinc-200/80 dark:bg-zinc-800",
                  day.level === 1 && "bg-[#9be9a8]",
                  day.level === 2 && "bg-[#40c463]",
                  day.level === 3 && "bg-[#30a14e]",
                  day.level >= 4 && "bg-[#216e39]",
                ]}
                style={`grid-column: ${day.col}; grid-row: ${day.row};`}
              />
            ))}
          </div>
        </div>

        <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-400">
          {totalContributions} contributions in the last year
        </p>
      </div>
    )}
  </div>
</section>
