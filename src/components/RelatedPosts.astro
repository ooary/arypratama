---
interface BlogPost {
  slug: string;
  data: {
    title: string;
    date: Date;
    tags?: string[];
  };
}

interface Props {
  currentPost: BlogPost;
  posts: BlogPost[];
  limit?: number;
}

const { currentPost, posts, limit = 3 } = Astro.props;

const currentTags = new Set(
  (currentPost.data.tags ?? []).map((tag) => tag.toLowerCase())
);

const relatedPosts = posts
  .filter((post) => post.slug !== currentPost.slug)
  .map((post) => {
    const sharedTags = (post.data.tags ?? []).filter((tag) =>
      currentTags.has(tag.toLowerCase())
    ).length;

    return { post, sharedTags };
  })
  .sort((a, b) => {
    if (b.sharedTags !== a.sharedTags) return b.sharedTags - a.sharedTags;
    return b.post.data.date.getTime() - a.post.data.date.getTime();
  })
  .slice(0, limit)
  .map(({ post }) => post);
---

{relatedPosts.length > 0 && (
  <section class="mt-16 border-t border-zinc-200 dark:border-zinc-700 pt-10">
    <p class="mb-5 text-xs font-bold uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400">
      Keep reading
    </p>

    <ol class="space-y-1 font-mono text-sm sm:text-base">
      {relatedPosts.map((post, index) => {
        const formattedDate = post.data.date.toISOString().split("T")[0];

        return (
          <li class="group">
            <a
              href={`/blog/${post.slug}`}
              class="block rounded-xl px-2 py-2 hover:bg-zinc-100 dark:hover:bg-zinc-900/60 transition-colors"
            >
              <div class="grid grid-cols-[2.2rem_minmax(0,1fr)_auto] items-baseline gap-2">
                <span class="text-zinc-400 dark:text-zinc-500 tabular-nums">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="min-w-0 flex items-baseline gap-2">
                  <span class="truncate text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400">
                    {post.data.title}
                  </span>
                  <span class="hidden sm:block flex-1 border-b border-dotted border-zinc-300 dark:border-zinc-600 translate-y-[-0.25rem]"></span>
                </span>
                <span class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 tabular-nums whitespace-nowrap">
                  {formattedDate}
                </span>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  </section>
)}
